        "fontWeight": 800,
        "lineHeight": 0.92,
        "letterSpacing": -6,
        "color": "$colors.canvas"
      },
      "h1": {
        "fontFamily": "$fonts.display",
        "fontSize": 88,
        "fontWeight": 800,
        "lineHeight": 1,
        "letterSpacing": -3,
        "color": "$colors.canvas"
      },
      "body": {
        "fontFamily": "$fonts.display",
        "fontSize": 30,
        "fontWeight": 500,
        "lineHeight": 1.55,
        "color": "$colors.canvas"
      },
      "caption": {
        "fontFamily": "$fonts.display",
        "fontSize": 18,
        "fontWeight": 800,
        "lineHeight": 1.4,
        "letterSpacing": 3.2,
        "color": "$colors.canvas",
        "textTransform": "uppercase"
      },
      "h2": {
        "fontFamily": "$fonts.display",
        "fontSize": 44,
        "fontWeight": 800,
        "lineHeight": 1.1,
        "letterSpacing": -1,
