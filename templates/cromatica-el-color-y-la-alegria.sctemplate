      "code": {
        "fontFamily": "ui-monospace, SFMono-Regular, Menlo, monospace",
        "fontSize": 22,
        "fontWeight": 500,
        "lineHeight": 1.5,
        "color": "#8E86B8"
      }
    }
  },
  "layouts": [
    {
      "id": "cover",
      "name": "Portada",
      "slide": {
