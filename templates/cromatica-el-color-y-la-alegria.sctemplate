                  "color": "$colors.muted"
                }
              },
              {
                "id": "s14-kicker",
                "frame": {
                  "x": 120,
                  "y": 506,
                  "w": 900,
                  "h": 32
                },
                "type": "text",
                "text": "Y ahora te toca",
                "styleRef": "$textStyles.caption"
              },
              {
                "id": "s14-t1",
                "frame": {
                  "x": 114,
                  "y": 560,
                  "w": 1000,
                  "h": 170
                },
                "type": "text",
                "text": "PINTA",
                "styleRef": "$textStyles.display"
              },
              {
                "id": "s14-t2",
