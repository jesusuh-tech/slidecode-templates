                }
              }
            ]
          },
          {
            "id": "main",
            "nodes": [
              {
                "id": "s14-3d",
                "name": "Esferas de color 3D",
                "frame": {
                  "x": 863,
                  "y": 58,
                  "w": 1057,
                  "h": 1004
                },
                "type": "code-block",
                "code": "const T=(slidecode.theme&&slidecode.theme.colors)||{};\nconst PAL=[T.accent||'#FFD429',T['tone-pink']||'#F53B84',T['tone-cyan']||'#2FD3D8',T['tone-lime']||'#7BE43B',T['tone-orange']||'#FF7A29',T['tone-blue']||'#2D6BF0',T.paper||'#FFF6EC'];\nconst SKIP=slidecode.mode==='edit';\nconst renderer=new THREE.WebGLRenderer({antialias:true,alpha:true});\nrenderer.setPixelRatio(Math.min(devicePixelRatio||1,2));\nrenderer.setSize(innerWidth,innerHeight);\ndocument.body.appendChild(renderer.domElement);\nconst scene=new THREE.Scene();\nconst camera=new THREE.PerspectiveCamera(40,innerWidth/innerHeight,0.1,100);\ncamera.position.set(0,0.2,10.5);\nconst group=new THREE.Group();scene.add(group);\nconst rnd=function(n){const x=Math.sin(n*127.1)*43758.5453;return x-Math.floor(x);};\nconst geo=new THREE.SphereGeometry(1,48,32);\nconst BALLS=[];\nconst N=12;\nfor(let i=0;i<N;i++){\n  const col=PAL[i%PAL.length];\n  const r=(i===0)?1.15:0.34+rnd(i*3.1)*0.38;\n  const mat=new THREE.MeshStandardMaterial({color:new THREE.Color(col),metalness:0.26,roughness:0.13,emissive:new THREE.Color(col),emissiveIntensity:0.10});\n  const m=new THREE.Mesh(geo,mat);\n  group.add(m);\n  BALLS.push({\n    m:m,r:r,\n    R:(i===0)?0:1.95+rnd(i*7.7)*1.05,\n    ph:rnd(i*11.3)*6.283,\n    tilt:(rnd(i*5.5)-0.5)*2.4,\n    sp:0.00014+rnd(i*13.9)*0.00015*(rnd(i*23.1)>0.5?1:-1),\n    bob:0.10+rnd(i*17.1)*0.16,\n    bs:1700+rnd(i*19.3)*1900,\n    dl:i*95\n  });\n}\nconst key=new THREE.PointLight(new THREE.Color(PAL[0]),320);key.position.set(4,3.4,5);scene.add(key);\nconst rim=new THREE.PointLight(new THREE.Color(PAL[2]),200);rim.position.set(-4.6,-2,3);scene.add(rim);\nconst fill=new THREE.PointLight(new THREE.Color(PAL[1]),150);fill.position.set(0,-4.4,-3);scene.add(fill);\nconst top=new THREE.DirectionalLight(0xffffff,1.3);top.position.set(0.6,1,0.8);scene.add(top);\nscene.add(new THREE.AmbientLight(0x5a49b8,2.6));\naddEventListener('resize',function(){camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight);});\nlet px=0,py=0,tx=0,ty=0;\nif(slidecode.onPointer)slidecode.onPointer(function(p){if(p&&p.inside){tx=(p.x-0.5)*0.55;ty=(p.y-0.5)*0.38;}else{tx=0;ty=0;}});\nconst expo=function(t){return t>=1?1:1-Math.pow(2,-10*t);};\nconst cl=function(v,a,b){return v<a?a:(v>b?b:v);};\nlet start=null;\nfunction frame(now){\n  if(start===null)start=now;\n  const t=now-start;\n  const k=SKIP?1:expo(cl(t/1500,0,1));\n  px+=(tx-px)*0.045;py+=(ty-py)*0.045;\n  group.scale.setScalar(0.66+0.34*k);\n  group.position.y=(1-k)*-1.1+Math.sin(t/2800)*0.09;\n  group.rotation.y=t/6400+px;\n  group.rotation.x=Math.sin(t/8200)*0.16+py;\n  BALLS.forEach(function(b,i){\n    const kI=SKIP?1:expo(cl((t-b.dl)/900,0,1));\n    b.m.scale.setScalar(b.r*kI);\n    const a=b.ph+t*b.sp;\n    b.m.position.set(Math.cos(a)*b.R,b.tilt+Math.sin(t/b.bs+b.ph)*b.bob,Math.sin(a)*b.R);\n    b.m.material.emissiveIntensity=0.10+0.06*(Math.sin(t/1300+i)*0.5+0.5);\n  });\n  key.intensity=320+Math.sin(t/1200)*70;\n  fill.intensity=150+Math.sin(t/1700+1)*55;\n  renderer.render(scene,camera);\n  requestAnimationFrame(frame);\n}\nslidecode.onReveal(function(){requestAnimationFrame(frame);});\n",
                "libs": [
                  "three"
                ]
              },
              {
                "id": "s14-rule",
                "frame": {
                  "x": 120,
                  "y": 470,
                  "w": 190,
                  "h": 10
                },
                "type": "shape",
                "shape": "rect",
                "fill": {
