                "type": "code-block",
                "code": "const T=(slidecode.theme&&slidecode.theme.colors)||{};\nconst INK=T.ink||'#14102A';\nconst c=document.createElement('canvas');document.body.appendChild(c);\nconst ctx=c.getContext('2d');\nconst dpr=Math.min(devicePixelRatio||1,2);\nlet W,H;\nfunction size(){W=innerWidth;H=innerHeight;c.width=W*dpr;c.height=H*dpr;c.style.width=W+'px';c.style.height=H+'px';ctx.setTransform(dpr,0,0,dpr,0,0);}\nsize();addEventListener('resize',size);\nconst expo=function(t){return t>=1?1:1-Math.pow(2,-10*t);};\nconst cl=function(v,a,b){return v<a?a:(v>b?b:v);};\nconst SKIP=slidecode.mode==='edit';\nconst N=44;\nlet start=null;\nfunction draw(now){\n  if(start===null)start=now;\n  const t=now-start;\n  ctx.clearRect(0,0,W,H);\n  const cx=W*0.74,cy=H*0.26,Rmax=Math.sqrt(W*W+H*H);\n  const rot=(t/64000)*Math.PI*2;\n  const step=Math.PI*2/N;\n  for(let i=0;i<N;i+=2){\n    const kI=SKIP?1:expo(cl((t-i*28)/1500,0,1));\n    if(kI<=0)continue;\n    const a0=rot+i*step,a1=a0+step;\n    const rr=Rmax*kI*(0.95+0.05*Math.sin(t/3000+i*0.4));\n    ctx.globalAlpha=0.055;ctx.fillStyle=INK;\n    ctx.beginPath();ctx.moveTo(cx,cy);ctx.arc(cx,cy,rr,a0,a1);ctx.closePath();ctx.fill();\n  }\n  ctx.globalAlpha=1;\n  const pulse=Math.sin(t/2600)*0.5+0.5;\n  const kh=SKIP?1:expo(cl(t/1600,0,1));\n  const g=ctx.createRadialGradient(cx,cy,0,cx,cy,Math.min(W,H)*0.62);\n  g.addColorStop(0,'rgba(255,255,255,'+(kh*(0.20+0.10*pulse)).toFixed(3)+')');\n  g.addColorStop(1,'rgba(255,255,255,0)');\n  ctx.fillStyle=g;ctx.fillRect(0,0,W,H);\n  requestAnimationFrame(draw);\n}\nslidecode.onReveal(function(){requestAnimationFrame(draw);});\n"
