              {
                "id": "s9-body",
                "frame": {
                  "x": 120,
                  "y": 570,
                  "w": 680,
                  "h": 300
                },
                "opacity": 0.82,
                "type": "text",
                "text": "Parte de la luz que entra por la retina no va a la visión: va al reloj interno, el que dosifica cortisol y melatonina.\n\nUna habitación luminosa no parece más alegre. Te pone más alegre.",
                "styleRef": "$textStyles.body",
                "style": {
                  "fontSize": 26
                }
              },
              {
                "id": "s9-orbit",
                "frame": {
                  "x": 900,
                  "y": 180,
                  "w": 900,
                  "h": 760
                },
                "type": "code-block",
                "code": "const T=(slidecode.theme&&slidecode.theme.colors)||{};\nconst ACCENT=T.accent||'#FFD429';\nconst INK=T.paper||'#FFF6EC';\nconst MUTED='rgba(255,246,236,0.34)';\nconst LABELS=['LUZ','RETINA','RELOJ','ÁNIMO'];\nconst c=document.createElement('canvas');document.body.appendChild(c);\nconst ctx=c.getContext('2d');\nconst dpr=Math.min(devicePixelRatio||1,2);\nlet W,H;\nfunction size(){W=innerWidth;H=innerHeight;c.width=W*dpr;c.height=H*dpr;c.style.width=W+'px';c.style.height=H+'px';ctx.setTransform(dpr,0,0,dpr,0,0);}\nsize();addEventListener('resize',size);\nconst expo=function(t){return t>=1?1:1-Math.pow(2,-10*t);};\nconst cl=function(v,a,b){return v<a?a:(v>b?b:v);};\nconst PERIOD=4200,INTRO=1000;\nconst SKIP=slidecode.mode==='edit';\nlet px=0,py=0,tx=0,ty=0;\nif(slidecode.onPointer)slidecode.onPointer(function(p){if(p&&p.inside){tx=p.x-0.5;ty=p.y-0.5;}else{tx=0;ty=0;}});\nlet start=null;\nfunction draw(now){\n  if(start===null)start=now;\n  const t=now-start;\n  const intro=SKIP?1:cl(t/INTRO,0,1);\n  const k=expo(intro);\n  px+=(tx-px)*0.05;py+=(ty-py)*0.05;\n  const cx=W/2+px*30,cy=H/2+py*22,R=Math.min(W,H)*0.34;\n  ctx.clearRect(0,0,W,H);\n  ctx.strokeStyle='rgba(255,246,236,0.16)';ctx.lineWidth=1.6;\n  ctx.beginPath();ctx.arc(cx,cy,R,-Math.PI/2,-Math.PI/2+Math.PI*2*k);ctx.stroke();\n  const run=Math.max(0,t-(SKIP?0:INTRO));\n  const ang=-Math.PI/2+(run%PERIOD)/PERIOD*Math.PI*2;\n  const cycles=Math.floor(run/PERIOD);\n  LABELS.forEach(function(lab,i){\n    const a=-Math.PI/2+i*(Math.PI*2/LABELS.length);\n    const sx=cx+Math.cos(a)*R,sy=cy+Math.sin(a)*R;\n    const pop=SKIP?1:expo(cl((t-460-i*120)/460,0,1));\n    const d=Math.abs(((ang-a)%(Math.PI*2)+Math.PI*3)%(Math.PI*2)-Math.PI);\n    const heat=intro>=1?Math.max(0,1-d/0.9):0;\n    ctx.globalAlpha=pop*(0.3+0.7*heat);ctx.fillStyle=ACCENT;\n    ctx.beginPath();ctx.arc(sx,sy,5+4*heat,0,Math.PI*2);ctx.fill();\n    if(heat>0.3){ctx.globalAlpha=pop*heat*0.3;\n      ctx.beginPath();ctx.arc(sx,sy,14+9*heat,0,Math.PI*2);ctx.fill();}\n    ctx.globalAlpha=pop;ctx.fillStyle=heat>0.5?INK:MUTED;\n    ctx.font='800 14px system-ui, sans-serif';ctx.textAlign='center';\n    const off=30+10*heat;\n    ctx.fillText(lab,sx+Math.cos(a)*off*1.5,sy+Math.sin(a)*off+5);\n    ctx.globalAlpha=1;\n  });\n  if(intro>=1){\n    for(let q=0;q<11;q++){\n      const qa=ang-q*0.04;\n      ctx.fillStyle=ACCENT;ctx.globalAlpha=(1-q/11)*0.9;\n      ctx.beginPath();ctx.arc(cx+Math.cos(qa)*R,cy+Math.sin(qa)*R,4.4-q*0.3,0,Math.PI*2);ctx.fill();\n    }\n    ctx.globalAlpha=1;\n  }\n  ctx.textAlign='center';ctx.globalAlpha=k;\n  ctx.fillStyle=INK;ctx.font='800 64px system-ui, sans-serif';\n  ctx.fillText(String(cycles),cx,cy+14);\n  ctx.fillStyle=MUTED;ctx.font='800 12px system-ui, sans-serif';\n  ctx.fillText('CICLOS DE LUZ',cx,cy+42);\n  ctx.globalAlpha=1;\n  requestAnimationFrame(draw);\n}\nslidecode.onReveal(function(){requestAnimationFrame(draw);});\n"
