          "duration": 0.5
        },
        "layers": [
          {
            "id": "bg",
            "nodes": [
              {
                "id": "blob-y",
                "name": "Círculo amarillo",
                "frame": {
                  "x": 1240,
                  "y": -220,
                  "w": 820,
