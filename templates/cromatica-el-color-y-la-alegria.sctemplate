              {
                "id": "s4-spec",
                "frame": {
                  "x": 120,
                  "y": 600,
                  "w": 1680,
                  "h": 340
                },
                "type": "code-block",
                "code": "const c=document.createElement('canvas');document.body.appendChild(c);\nconst ctx=c.getContext('2d');\nconst dpr=Math.min(devicePixelRatio||1,2);\nlet W,H;\nfunction size(){W=innerWidth;H=innerHeight;c.width=W*dpr;c.height=H*dpr;c.style.width=W+'px';c.style.height=H+'px';ctx.setTransform(dpr,0,0,dpr,0,0);}\nsize();addEventListener('resize',size);\nconst expo=function(t){return t>=1?1:1-Math.pow(2,-10*t);};\nconst cl=function(v,a,b){return v<a?a:(v>b?b:v);};\nfunction wl(w,a){\n  let r=0,g=0,b=0;\n  if(w<440){r=-(w-440)/60;b=1;}\n  else if(w<490){g=(w-440)/50;b=1;}\n  else if(w<510){g=1;b=-(w-510)/20;}\n  else if(w<580){r=(w-510)/70;g=1;}\n  else if(w<645){r=1;g=-(w-645)/65;}\n  else {r=1;}\n  let f=1;\n  if(w<420)f=0.35+0.65*(w-380)/40;else if(w>645)f=0.35+0.65*(700-w)/55;\n  f=cl(f,0.2,1);\n  const q=function(x){return Math.round(255*Math.pow(cl(x,0,1)*f,0.8));};\n  return 'rgba('+q(r)+','+q(g)+','+q(b)+','+(a===undefined?1:a)+')';\n}\nfunction nom(w){return w<450?'VIOLETA':w<490?'AZUL':w<510?'CIAN':w<565?'VERDE':w<590?'AMARILLO':w<625?'NARANJA':'ROJO';}\nconst SKIP=slidecode.mode==='edit';\nlet start=null;\nfunction draw(now){\n  if(start===null)start=now;\n  const t=now-start;\n  const k=SKIP?1:expo(cl(t/1300,0,1));\n  const run=Math.max(0,t-(SKIP?0:1300));\n  ctx.clearRect(0,0,W,H);\n  const x0=10,x1=W-10,BY=H*0.34,BH=H*0.40;\n  for(let x=x0;x<x0+(x1-x0)*k;x+=2){\n    const w=380+(x-x0)/(x1-x0)*320;\n    ctx.fillStyle=wl(w);ctx.fillRect(x,BY,2.4,BH);\n  }\n  ctx.globalAlpha=k;\n  for(let n=400;n<=700;n+=50){\n    const x=x0+(n-380)/320*(x1-x0);\n    ctx.strokeStyle='rgba(255,246,236,0.22)';ctx.lineWidth=1;\n    ctx.beginPath();ctx.moveTo(x,BY+BH+8);ctx.lineTo(x,BY+BH+18);ctx.stroke();\n    ctx.fillStyle='rgba(255,246,236,0.45)';ctx.font='600 12px ui-monospace, Menlo, monospace';ctx.textAlign='center';\n    ctx.fillText(n+' nm',x,BY+BH+38);\n  }\n  ctx.globalAlpha=1;\n  if(k>=1){\n    const p=Math.abs(((run/7000)%2)-1);\n    const cxp=x0+(x1-x0)*p,cw=380+p*320;\n    for(let dx=-46;dx<=46;dx+=2){\n      const ex=26*Math.exp(-Math.pow(dx/20,2));\n      if(ex<0.5)continue;\n      const w2=380+(cxp+dx-x0)/(x1-x0)*320;\n      ctx.fillStyle=wl(w2);ctx.fillRect(cxp+dx,BY-ex,2.4,ex);\n    }\n    ctx.strokeStyle='rgba(255,246,236,0.75)';ctx.lineWidth=1.6;\n    ctx.beginPath();ctx.moveTo(cxp,BY-42);ctx.lineTo(cxp,BY+BH+2);ctx.stroke();\n    const lx=cl(cxp,130,W-130);\n    ctx.textAlign='center';\n    ctx.fillStyle=wl(cw);ctx.font='800 46px system-ui, sans-serif';\n    ctx.fillText(Math.round(cw)+' nm',lx,46);\n    ctx.fillStyle='rgba(255,246,236,0.55)';ctx.font='800 13px system-ui, sans-serif';\n    ctx.fillText(nom(cw),lx,70);\n  }\n  requestAnimationFrame(draw);\n}\nslidecode.onReveal(function(){requestAnimationFrame(draw);});\n"
              }
            ]
