              },
              {
                "nodeId": "cover-kicker",
                "effect": "fadeIn",
                "duration": 0.45,
                "delay": 0.42,
                "easing": "easeOut"
              },
              {
                "nodeId": "cover-t1",
                "effect": "slideIn",
