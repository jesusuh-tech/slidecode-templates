                "type": "code-block",
                "code": "const T=(slidecode.theme&&slidecode.theme.colors)||{};\nconst COLS=[T.accent||'#FFD429',T['tone-lime']||'#7BE43B',T['tone-violet']||'#4B2BE8',T.paper||'#FFF6EC',T['tone-cyan']||'#2FD3D8'];\nconst c=document.createElement('canvas');document.body.appendChild(c);\nconst ctx=c.getContext('2d');\nconst dpr=Math.min(devicePixelRatio||1,2);\nlet W,H;\nfunction size(){W=innerWidth;H=innerHeight;c.width=W*dpr;c.height=H*dpr;c.style.width=W+'px';c.style.height=H+'px';ctx.setTransform(dpr,0,0,dpr,0,0);}\nsize();addEventListener('resize',size);\nconst expo=function(t){return t>=1?1:1-Math.pow(2,-10*t);};\nconst cl=function(v,a,b){return v<a?a:(v>b?b:v);};\nconst rnd=function(n){const x=Math.sin(n*127.1)*43758.5453;return x-Math.floor(x);};\nconst SKIP=slidecode.mode==='edit';\nconst N=74;\nconst P=Array.from({length:N},function(_,i){return {\n  x:rnd(i*3.7),off:rnd(i*7.1),sp:0.000035+rnd(i*11.3)*0.00006,\n  w:9+rnd(i*5.9)*13,h:5+rnd(i*13.7)*9,\n  col:COLS[i%COLS.length],rs:(rnd(i*2.3)-0.5)*0.0018,ph:rnd(i*17.9)*6.28\n};});\nlet start=null;\nfunction draw(now){\n  if(start===null)start=now;\n  const t=now-start;\n  ctx.clearRect(0,0,W,H);\n  const gust=1+0.9*Math.max(0,Math.sin(t/5200));\n  P.forEach(function(p,i){\n    const kI=SKIP?1:expo(cl((t-i*16)/760,0,1));\n    if(kI<=0)return;\n    const yy=(((t*p.sp+p.off)%1.16)-0.08)*H;\n    const xx=(p.x+Math.sin(t/1900+p.ph)*0.028*gust)*W;\n    ctx.save();ctx.translate(xx,yy);ctx.rotate(p.ph+t*p.rs);\n    ctx.globalAlpha=0.85*kI;ctx.fillStyle=p.col;\n    ctx.fillRect(-p.w/2,-p.h/2,p.w*kI,p.h);\n    ctx.restore();\n  });\n  ctx.globalAlpha=1;\n  requestAnimationFrame(draw);\n}\nslidecode.onReveal(function(){requestAnimationFrame(draw);});\n"
