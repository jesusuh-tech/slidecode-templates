  "modules": [
    {
      "id": "cover-3d",
      "name": "Enjambre 3D",
      "node": {
        "id": "cover-3d",
        "name": "Enjambre 3D",
        "frame": {
          "x": 1040,
          "y": 60,
          "w": 880,
          "h": 880
        },
        "type": "code-block",
        "code": "const T=(slidecode.theme&&slidecode.theme.colors)||{};\nconst PAL=[T.accent||'#FFD429',T['tone-pink']||'#F53B84',T['tone-lime']||'#7BE43B',T['tone-cyan']||'#2FD3D8',T['tone-orange']||'#FF7A29',T['tone-blue']||'#2D6BF0',T['tone-violet']||'#4B2BE8',T['tone-red']||'#EE3B3B'];\nconst SKIP=slidecode.mode==='edit';\nconst renderer=new THREE.WebGLRenderer({antialias:true,alpha:true});\nrenderer.setPixelRatio(Math.min(devicePixelRatio||1,2));\nrenderer.setSize(innerWidth,innerHeight);\ndocument.body.appendChild(renderer.domElement);\nconst scene=new THREE.Scene();\nconst camera=new THREE.PerspectiveCamera(40,innerWidth/innerHeight,0.1,100);\ncamera.position.set(0,0.2,7.4);\nconst group=new THREE.Group();scene.add(group);\nfunction geoFor(i,s){\n  const k=i%5;\n  if(k===0)return new THREE.TetrahedronGeometry(s*1.15,0);\n  if(k===1)return new THREE.IcosahedronGeometry(s*0.86,0);\n  if(k===2)return new THREE.OctahedronGeometry(s*0.98,0);\n  if(k===3)return new THREE.BoxGeometry(s*1.25,s*1.25,s*1.25);\n  return new THREE.TorusGeometry(s*0.78,s*0.30,3,12);\n}\nconst N=16;\nconst bits=[];\nfor(let i=0;i<N;i++){\n  const hex=PAL[i%PAL.length];\n  const s=0.26+((i*7)%5)*0.075;\n  const col=new THREE.Color(hex);\n  const m=new THREE.Mesh(geoFor(i,s),new THREE.MeshStandardMaterial({color:col,metalness:0.38,roughness:0.22,flatShading:true,emissive:col,emissiveIntensity:0.26}));\n  group.add(m);\n  const band=i%3;\n  bits.push({\n    m:m,\n    r:1.30+band*0.92+((i*3)%4)*0.16,\n    sp:(0.00022+(i%5)*0.00007)*((i%2)?1:-1),\n    ph:i*(Math.PI*2/N)*3.1,\n    yA:0.55+band*0.42,\n    yF:1700+i*190,\n    tilt:(band-1)*0.42,\n    dly:i*0.045\n  });\n}\nconst key=new THREE.PointLight(new THREE.Color(PAL[0]),330);key.position.set(3.4,2.8,4);scene.add(key);\nconst rim=new THREE.PointLight(new THREE.Color(PAL[1]),210);rim.position.set(-4.2,-1.6,2.4);scene.add(rim);\nconst fill=new THREE.PointLight(new THREE.Color(PAL[3]),140);fill.position.set(0,4.6,-3);scene.add(fill);\nconst back=new THREE.PointLight(new THREE.Color(PAL[2]),120);back.position.set(-1.5,-3.6,-3.2);scene.add(back);\nscene.add(new THREE.AmbientLight(0x5a48b4,3.4));\naddEventListener('resize',function(){camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight);});\nlet px=0,py=0,tx=0,ty=0;\nif(slidecode.onPointer)slidecode.onPointer(function(p){if(p&&p.inside){tx=(p.x-0.5)*0.5;ty=(p.y-0.5)*0.35;}else{tx=0;ty=0;}});\nconst expo=function(t){return t<=0?0:(t>=1?1:1-Math.pow(2,-10*t));};\nlet start=null;\nfunction frame(now){\n  if(start===null)start=now;\n  const t=now-start;\n  px+=(tx-px)*0.05;py+=(ty-py)*0.05;\n  group.rotation.y=t/6000+px;\n  group.rotation.x=Math.sin(t/7200)*0.16+py;\n  group.position.y=Math.sin(t/2600)*0.12;\n  for(let i=0;i<bits.length;i++){\n    const b=bits[i];\n    const k=SKIP?1:expo(Math.min(Math.max((t/1000-b.dly)/1.15,0),1));\n    const a=b.ph+t*b.sp;\n    const rr=b.r*(0.30+0.70*k);\n    b.m.position.set(Math.cos(a)*rr,Math.sin(a*1.3)*b.yA+b.tilt+(1-k)*-1.6,Math.sin(a)*rr*0.72);\n    b.m.rotation.x=t/(2400+i*210);\n    b.m.rotation.y=t/(3300+i*160);\n    b.m.rotation.z=Math.sin(t/(4100+i*140))*0.9;\n    b.m.scale.setScalar(k*(1+0.09*Math.sin(t/900+i)));\n    b.m.material.emissiveIntensity=0.20+0.16*Math.sin(t/1200+i*1.7);\n  }\n  key.intensity=330+Math.sin(t/1100)*80;\n  rim.intensity=210+Math.sin(t/1500+2)*70;\n  renderer.render(scene,camera);\n  requestAnimationFrame(frame);\n}\nslidecode.onReveal(function(){requestAnimationFrame(frame);});\n",
        "libs": [
          "three"
        ]
      }
    },
    {
      "id": "s3-prisma",
      "node": {
        "id": "s3-prisma",
        "frame": {
          "x": 940,
          "y": 180,
          "w": 880,
          "h": 720
        },
        "type": "code-block",
        "code": "const T=(slidecode.theme&&slidecode.theme.colors)||{};\nconst PAPER=T.paper||'#FFF6EC';\nconst SPEC=['#7A3BF0','#4B2BE8','#2FD3D8','#7BE43B','#FFD429','#FF7A29','#EE3B3B'];\nconst NM=['400','450','490','530','575','620','670'];\nconst c=document.createElement('canvas');document.body.appendChild(c);\nconst ctx=c.getContext('2d');\nconst dpr=Math.min(devicePixelRatio||1,2);\nlet W,H;\nfunction size(){W=innerWidth;H=innerHeight;c.width=W*dpr;c.height=H*dpr;c.style.width=W+'px';c.style.height=H+'px';ctx.setTransform(dpr,0,0,dpr,0,0);}\nsize();addEventListener('resize',size);\nconst expo=function(t){return t>=1?1:1-Math.pow(2,-10*t);};\nconst cl=function(v,a,b){return v<a?a:(v>b?b:v);};\nconst SKIP=slidecode.mode==='edit';\nlet start=null;\nfunction draw(now){\n  if(start===null)start=now;\n  const t=now-start;\n  ctx.clearRect(0,0,W,H);\n  const cx=W*0.30,cy=H*0.50,R=Math.min(W,H)*0.21;\n  const bK=SKIP?1:expo(cl(t/640,0,1));\n  const by=cy-R*0.34,bx=cx-R*0.46;\n  ctx.strokeStyle=PAPER;ctx.lineWidth=3;ctx.globalAlpha=0.9;\n  ctx.beginPath();ctx.moveTo(0,by);ctx.lineTo(bx*bK,by);ctx.stroke();ctx.globalAlpha=1;\n  if(bK>=1){\n    const pp=(t/1500)%1;\n    ctx.fillStyle=PAPER;\n    for(let q=0;q<9;q++){\n      const qp=cl(pp-q*0.022,0,1);\n      ctx.globalAlpha=(1-q/9)*0.8;\n      ctx.beginPath();ctx.arc(qp*bx,by,3.4-q*0.3,0,Math.PI*2);ctx.fill();\n    }\n    ctx.globalAlpha=1;\n  }\n  const wob=Math.sin(t/3600)*0.045;\n  ctx.save();ctx.translate(cx,cy);ctx.rotate(wob);\n  ctx.beginPath();ctx.moveTo(0,-R);ctx.lineTo(R*0.94,R*0.74);ctx.lineTo(-R*0.94,R*0.74);ctx.closePath();\n  const pg=ctx.createLinearGradient(-R,-R,R,R);\n  pg.addColorStop(0,'rgba(255,246,236,0.16)');pg.addColorStop(1,'rgba(255,246,236,0.02)');\n  ctx.fillStyle=pg;ctx.fill();\n  ctx.strokeStyle='rgba(255,246,236,0.6)';ctx.lineWidth=2;ctx.stroke();\n  ctx.restore();\n  const ox=cx+R*0.48,oy=cy+R*0.18;\n  const sp=0.30*(1+0.09*Math.sin(t/2800));\n  for(let i=0;i<7;i++){\n    const ang=0.10-sp+(i/6)*2*sp;\n    const len=(W-14-ox)/Math.cos(ang);\n    const kI=SKIP?1:expo(cl((t-700-i*85)/640,0,1));\n    if(kI<=0)continue;\n    const ex=ox+Math.cos(ang)*len*kI,ey=oy+Math.sin(ang)*len*kI;\n    ctx.strokeStyle=SPEC[i];ctx.lineCap='round';\n    ctx.globalAlpha=0.18;ctx.lineWidth=10;\n    ctx.beginPath();ctx.moveTo(ox,oy);ctx.lineTo(ex,ey);ctx.stroke();\n    ctx.globalAlpha=0.95;ctx.lineWidth=2.6;\n    ctx.beginPath();ctx.moveTo(ox,oy);ctx.lineTo(ex,ey);ctx.stroke();\n    ctx.globalAlpha=1;\n    if(kI>=1){\n      const s=(t/2100+i*0.12)%1;\n      const sx=ox+Math.cos(ang)*len*s,sy=oy+Math.sin(ang)*len*s;\n      ctx.fillStyle=SPEC[i];\n      ctx.beginPath();ctx.arc(sx,sy,4.2,0,Math.PI*2);ctx.fill();\n      ctx.globalAlpha=0.3;\n      ctx.beginPath();ctx.arc(sx,sy,11,0,Math.PI*2);ctx.fill();ctx.globalAlpha=1;\n      ctx.fillStyle=SPEC[i];ctx.font='700 12px ui-monospace, Menlo, monospace';ctx.textAlign='right';\n      ctx.fillText(NM[i]+' nm',W-16,oy+Math.sin(ang)*len-12);\n    }\n  }\n  requestAnimationFrame(draw);\n}\nslidecode.onReveal(function(){requestAnimationFrame(draw);});\n"
      }
    },
    {
      "id": "s4-spec",
      "node": {
        "id": "s4-spec",
        "frame": {
          "x": 120,
          "y": 600,
          "w": 1680,
          "h": 340
        },
        "type": "code-block",
        "code": "const c=document.createElement('canvas');document.body.appendChild(c);\nconst ctx=c.getContext('2d');\nconst dpr=Math.min(devicePixelRatio||1,2);\nlet W,H;\nfunction size(){W=innerWidth;H=innerHeight;c.width=W*dpr;c.height=H*dpr;c.style.width=W+'px';c.style.height=H+'px';ctx.setTransform(dpr,0,0,dpr,0,0);}\nsize();addEventListener('resize',size);\nconst expo=function(t){return t>=1?1:1-Math.pow(2,-10*t);};\nconst cl=function(v,a,b){return v<a?a:(v>b?b:v);};\nfunction wl(w,a){\n  let r=0,g=0,b=0;\n  if(w<440){r=-(w-440)/60;b=1;}\n  else if(w<490){g=(w-440)/50;b=1;}\n  else if(w<510){g=1;b=-(w-510)/20;}\n  else if(w<580){r=(w-510)/70;g=1;}\n  else if(w<645){r=1;g=-(w-645)/65;}\n  else {r=1;}\n  let f=1;\n  if(w<420)f=0.35+0.65*(w-380)/40;else if(w>645)f=0.35+0.65*(700-w)/55;\n  f=cl(f,0.2,1);\n  const q=function(x){return Math.round(255*Math.pow(cl(x,0,1)*f,0.8));};\n  return 'rgba('+q(r)+','+q(g)+','+q(b)+','+(a===undefined?1:a)+')';\n}\nfunction nom(w){return w<450?'VIOLETA':w<490?'AZUL':w<510?'CIAN':w<565?'VERDE':w<590?'AMARILLO':w<625?'NARANJA':'ROJO';}\nconst SKIP=slidecode.mode==='edit';\nlet start=null;\nfunction draw(now){\n  if(start===null)start=now;\n  const t=now-start;\n  const k=SKIP?1:expo(cl(t/1300,0,1));\n  const run=Math.max(0,t-(SKIP?0:1300));\n  ctx.clearRect(0,0,W,H);\n  const x0=10,x1=W-10,BY=H*0.34,BH=H*0.40;\n  for(let x=x0;x<x0+(x1-x0)*k;x+=2){\n    const w=380+(x-x0)/(x1-x0)*320;\n    ctx.fillStyle=wl(w);ctx.fillRect(x,BY,2.4,BH);\n  }\n  ctx.globalAlpha=k;\n  for(let n=400;n<=700;n+=50){\n    const x=x0+(n-380)/320*(x1-x0);\n    ctx.strokeStyle='rgba(255,246,236,0.22)';ctx.lineWidth=1;\n    ctx.beginPath();ctx.moveTo(x,BY+BH+8);ctx.lineTo(x,BY+BH+18);ctx.stroke();\n    ctx.fillStyle='rgba(255,246,236,0.45)';ctx.font='600 12px ui-monospace, Menlo, monospace';ctx.textAlign='center';\n    ctx.fillText(n+' nm',x,BY+BH+38);\n  }\n  ctx.globalAlpha=1;\n  if(k>=1){\n    const p=Math.abs(((run/7000)%2)-1);\n    const cxp=x0+(x1-x0)*p,cw=380+p*320;\n    for(let dx=-46;dx<=46;dx+=2){\n      const ex=26*Math.exp(-Math.pow(dx/20,2));\n      if(ex<0.5)continue;\n      const w2=380+(cxp+dx-x0)/(x1-x0)*320;\n      ctx.fillStyle=wl(w2);ctx.fillRect(cxp+dx,BY-ex,2.4,ex);\n    }\n    ctx.strokeStyle='rgba(255,246,236,0.75)';ctx.lineWidth=1.6;\n    ctx.beginPath();ctx.moveTo(cxp,BY-42);ctx.lineTo(cxp,BY+BH+2);ctx.stroke();\n    const lx=cl(cxp,130,W-130);\n    ctx.textAlign='center';\n    ctx.fillStyle=wl(cw);ctx.font='800 46px system-ui, sans-serif';\n    ctx.fillText(Math.round(cw)+' nm',lx,46);\n    ctx.fillStyle='rgba(255,246,236,0.55)';ctx.font='800 13px system-ui, sans-serif';\n    ctx.fillText(nom(cw),lx,70);\n  }\n  requestAnimationFrame(draw);\n}\nslidecode.onReveal(function(){requestAnimationFrame(draw);});\n"
      }
    },
    {
      "id": "s7-wheel",
      "node": {
        "id": "s7-wheel",
        "frame": {
          "x": 1010,
          "y": 180,
          "w": 790,
          "h": 790
        },
        "type": "code-block",
        "code": "const T=(slidecode.theme&&slidecode.theme.colors)||{};\nconst PAPER=T.paper||'#FFF6EC';\nconst CANVAS=T.canvas||'#14102A';\nconst SETS=[[],[48,228],[48,84,12],[48,168,288]];\nconst NAMES=['LA RUEDA','COMPLEMENTARIO','ANÁLOGO','TRÍADA'];\nconst c=document.createElement('canvas');document.body.appendChild(c);\nconst ctx=c.getContext('2d');\nconst dpr=Math.min(devicePixelRatio||1,2);\nlet W,H;\nfunction size(){W=innerWidth;H=innerHeight;c.width=W*dpr;c.height=H*dpr;c.style.width=W+'px';c.style.height=H+'px';ctx.setTransform(dpr,0,0,dpr,0,0);}\nsize();addEventListener('resize',size);\nconst expo=function(t){return t>=1?1:1-Math.pow(2,-10*t);};\nconst cl=function(v,a,b){return v<a?a:(v>b?b:v);};\nconst SKIP=slidecode.mode==='edit';\nfunction target(){return SKIP?3:cl(slidecode.step,0,3);}\nlet cur=target(),prev=cur,tSwitch=-99999,tNow=0;\nfunction bump(){prev=cur;cur=target();tSwitch=tNow;}\nslidecode.onStep(bump);\nslidecode.onModeChange(bump);\nlet px=0,py=0,tx=0,ty=0;\nif(slidecode.onPointer)slidecode.onPointer(function(p){if(p&&p.inside){tx=p.x-0.5;ty=p.y-0.5;}else{tx=0;ty=0;}});\nfunction ang(h,rot){return (h-90)*Math.PI/180+rot;}\nfunction drawSet(idx,alpha,cx,cy,R,rot,t){\n  const set=SETS[idx];if(!set||!set.length)return;\n  const pts=set.map(function(h){const a=ang(h,rot);return [cx+Math.cos(a)*R*0.83,cy+Math.sin(a)*R*0.83,h];});\n  ctx.globalAlpha=alpha*0.7;ctx.strokeStyle=PAPER;ctx.lineWidth=1.6;\n  ctx.beginPath();\n  pts.forEach(function(p,i){i?ctx.lineTo(p[0],p[1]):ctx.moveTo(p[0],p[1]);});\n  if(pts.length>2)ctx.closePath();\n  ctx.stroke();\n  pts.forEach(function(p,i){\n    const pulse=Math.sin(t/520+i)*0.5+0.5;\n    ctx.globalAlpha=alpha;ctx.fillStyle='hsl('+p[2]+',86%,58%)';\n    ctx.beginPath();ctx.arc(p[0],p[1],9+2.5*pulse,0,Math.PI*2);ctx.fill();\n    ctx.globalAlpha=alpha*0.22;\n    ctx.beginPath();ctx.arc(p[0],p[1],19+9*pulse,0,Math.PI*2);ctx.fill();\n    ctx.globalAlpha=alpha;ctx.fillStyle=PAPER;\n    ctx.font='700 11px ui-monospace, Menlo, monospace';ctx.textAlign='center';\n    ctx.fillText(p[2]+'°',p[0],p[1]-22);\n  });\n  ctx.globalAlpha=1;\n}\nlet start=null;\nfunction draw(now){\n  if(start===null)start=now;\n  const t=now-start;tNow=t;\n  const k=SKIP?1:expo(cl(t/1100,0,1));\n  px+=(tx-px)*0.06;py+=(ty-py)*0.06;\n  ctx.clearRect(0,0,W,H);\n  const cx=W/2+px*36,cy=H/2+py*26,R=Math.min(W,H)*0.40*(0.86+0.14*k);\n  const rot=t/12000;\n  const seg=Math.PI*2/72;\n  for(let i=0;i<72;i++){\n    const a0=-Math.PI/2+i*seg+rot,a1=a0+seg*1.03;\n    const appear=SKIP?1:expo(cl((t-i*9)/520,0,1));\n    if(appear<=0)continue;\n    const sweep=Math.sin(t/1400-i*0.09)*0.5+0.5;\n    ctx.globalAlpha=appear*(0.7+0.3*sweep);\n    ctx.fillStyle='hsl('+(i*5)+',84%,'+(51+7*sweep)+'%)';\n    ctx.beginPath();\n    ctx.arc(cx,cy,R,a0,a1);ctx.arc(cx,cy,R*0.66,a1,a0,true);ctx.closePath();ctx.fill();\n  }\n  ctx.globalAlpha=1;\n  const sw=cl((t-tSwitch)/460,0,1);\n  if(prev!==cur&&sw<1)drawSet(prev,1-sw,cx,cy,R,rot,t);\n  drawSet(cur,(prev!==cur)?sw:1,cx,cy,R,rot,t);\n  ctx.globalAlpha=k*0.94;ctx.fillStyle=CANVAS;\n  ctx.beginPath();ctx.arc(cx,cy,R*0.44,0,Math.PI*2);ctx.fill();\n  ctx.globalAlpha=k;ctx.textAlign='center';\n  ctx.fillStyle=PAPER;ctx.font='800 24px system-ui, sans-serif';\n  ctx.fillText(NAMES[cur],cx,cy+2);\n  ctx.fillStyle='rgba(255,246,236,0.45)';ctx.font='700 11px ui-monospace, Menlo, monospace';\n  ctx.fillText(cur?(SETS[cur].join('°  ·  ')+'°'):'360 GRADOS DE LUZ',cx,cy+26);\n  ctx.globalAlpha=1;\n  requestAnimationFrame(draw);\n}\nslidecode.onReveal(function(){requestAnimationFrame(draw);});\n",
        "stepCount": 3
      }
    },
    {
      "id": "s8-sun",
      "node": {
        "id": "s8-sun",
        "frame": {
          "x": 0,
