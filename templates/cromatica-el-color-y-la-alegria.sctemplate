            "nodes": [
              {
                "id": "s3-prisma",
                "frame": {
                  "x": 940,
                  "y": 180,
                  "w": 880,
                  "h": 720
                },
                "type": "code-block",
                "code": "const T=(slidecode.theme&&slidecode.theme.colors)||{};\nconst PAPER=T.paper||'#FFF6EC';\nconst SPEC=['#7A3BF0','#4B2BE8','#2FD3D8','#7BE43B','#FFD429','#FF7A29','#EE3B3B'];\nconst NM=['400','450','490','530','575','620','670'];\nconst c=document.createElement('canvas');document.body.appendChild(c);\nconst ctx=c.getContext('2d');\nconst dpr=Math.min(devicePixelRatio||1,2);\nlet W,H;\nfunction size(){W=innerWidth;H=innerHeight;c.width=W*dpr;c.height=H*dpr;c.style.width=W+'px';c.style.height=H+'px';ctx.setTransform(dpr,0,0,dpr,0,0);}\nsize();addEventListener('resize',size);\nconst expo=function(t){return t>=1?1:1-Math.pow(2,-10*t);};\nconst cl=function(v,a,b){return v<a?a:(v>b?b:v);};\nconst SKIP=slidecode.mode==='edit';\nlet start=null;\nfunction draw(now){\n  if(start===null)start=now;\n  const t=now-start;\n  ctx.clearRect(0,0,W,H);\n  const cx=W*0.30,cy=H*0.50,R=Math.min(W,H)*0.21;\n  const bK=SKIP?1:expo(cl(t/640,0,1));\n  const by=cy-R*0.34,bx=cx-R*0.46;\n  ctx.strokeStyle=PAPER;ctx.lineWidth=3;ctx.globalAlpha=0.9;\n  ctx.beginPath();ctx.moveTo(0,by);ctx.lineTo(bx*bK,by);ctx.stroke();ctx.globalAlpha=1;\n  if(bK>=1){\n    const pp=(t/1500)%1;\n    ctx.fillStyle=PAPER;\n    for(let q=0;q<9;q++){\n      const qp=cl(pp-q*0.022,0,1);\n      ctx.globalAlpha=(1-q/9)*0.8;\n      ctx.beginPath();ctx.arc(qp*bx,by,3.4-q*0.3,0,Math.PI*2);ctx.fill();\n    }\n    ctx.globalAlpha=1;\n  }\n  const wob=Math.sin(t/3600)*0.045;\n  ctx.save();ctx.translate(cx,cy);ctx.rotate(wob);\n  ctx.beginPath();ctx.moveTo(0,-R);ctx.lineTo(R*0.94,R*0.74);ctx.lineTo(-R*0.94,R*0.74);ctx.closePath();\n  const pg=ctx.createLinearGradient(-R,-R,R,R);\n  pg.addColorStop(0,'rgba(255,246,236,0.16)');pg.addColorStop(1,'rgba(255,246,236,0.02)');\n  ctx.fillStyle=pg;ctx.fill();\n  ctx.strokeStyle='rgba(255,246,236,0.6)';ctx.lineWidth=2;ctx.stroke();\n  ctx.restore();\n  const ox=cx+R*0.48,oy=cy+R*0.18;\n  const sp=0.30*(1+0.09*Math.sin(t/2800));\n  for(let i=0;i<7;i++){\n    const ang=0.10-sp+(i/6)*2*sp;\n    const len=(W-14-ox)/Math.cos(ang);\n    const kI=SKIP?1:expo(cl((t-700-i*85)/640,0,1));\n    if(kI<=0)continue;\n    const ex=ox+Math.cos(ang)*len*kI,ey=oy+Math.sin(ang)*len*kI;\n    ctx.strokeStyle=SPEC[i];ctx.lineCap='round';\n    ctx.globalAlpha=0.18;ctx.lineWidth=10;\n    ctx.beginPath();ctx.moveTo(ox,oy);ctx.lineTo(ex,ey);ctx.stroke();\n    ctx.globalAlpha=0.95;ctx.lineWidth=2.6;\n    ctx.beginPath();ctx.moveTo(ox,oy);ctx.lineTo(ex,ey);ctx.stroke();\n    ctx.globalAlpha=1;\n    if(kI>=1){\n      const s=(t/2100+i*0.12)%1;\n      const sx=ox+Math.cos(ang)*len*s,sy=oy+Math.sin(ang)*len*s;\n      ctx.fillStyle=SPEC[i];\n      ctx.beginPath();ctx.arc(sx,sy,4.2,0,Math.PI*2);ctx.fill();\n      ctx.globalAlpha=0.3;\n      ctx.beginPath();ctx.arc(sx,sy,11,0,Math.PI*2);ctx.fill();ctx.globalAlpha=1;\n      ctx.fillStyle=SPEC[i];ctx.font='700 12px ui-monospace, Menlo, monospace';ctx.textAlign='right';\n      ctx.fillText(NM[i]+' nm',W-16,oy+Math.sin(ang)*len-12);\n    }\n  }\n  requestAnimationFrame(draw);\n}\nslidecode.onReveal(function(){requestAnimationFrame(draw);});\n"
