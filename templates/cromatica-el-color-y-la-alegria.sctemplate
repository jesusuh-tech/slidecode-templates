          },
          {
            "id": "main",
            "nodes": [
              {
                "id": "cover-3d",
                "name": "Enjambre 3D",
                "frame": {
                  "x": 1040,
                  "y": 60,
                  "w": 880,
                  "h": 880
                },
                "type": "code-block",
                "code": "const T=(slidecode.theme&&slidecode.theme.colors)||{};\nconst PAL=[T.accent||'#FFD429',T['tone-pink']||'#F53B84',T['tone-lime']||'#7BE43B',T['tone-cyan']||'#2FD3D8',T['tone-orange']||'#FF7A29',T['tone-blue']||'#2D6BF0',T['tone-violet']||'#4B2BE8',T['tone-red']||'#EE3B3B'];\nconst SKIP=slidecode.mode==='edit';\nconst renderer=new THREE.WebGLRenderer({antialias:true,alpha:true});\nrenderer.setPixelRatio(Math.min(devicePixelRatio||1,2));\nrenderer.setSize(innerWidth,innerHeight);\ndocument.body.appendChild(renderer.domElement);\nconst scene=new THREE.Scene();\nconst camera=new THREE.PerspectiveCamera(40,innerWidth/innerHeight,0.1,100);\ncamera.position.set(0,0.2,7.4);\nconst group=new THREE.Group();scene.add(group);\nfunction geoFor(i,s){\n  const k=i%5;\n  if(k===0)return new THREE.TetrahedronGeometry(s*1.15,0);\n  if(k===1)return new THREE.IcosahedronGeometry(s*0.86,0);\n  if(k===2)return new THREE.OctahedronGeometry(s*0.98,0);\n  if(k===3)return new THREE.BoxGeometry(s*1.25,s*1.25,s*1.25);\n  return new THREE.TorusGeometry(s*0.78,s*0.30,3,12);\n}\nconst N=16;\nconst bits=[];\nfor(let i=0;i<N;i++){\n  const hex=PAL[i%PAL.length];\n  const s=0.26+((i*7)%5)*0.075;\n  const col=new THREE.Color(hex);\n  const m=new THREE.Mesh(geoFor(i,s),new THREE.MeshStandardMaterial({color:col,metalness:0.38,roughness:0.22,flatShading:true,emissive:col,emissiveIntensity:0.26}));\n  group.add(m);\n  const band=i%3;\n  bits.push({\n    m:m,\n    r:1.30+band*0.92+((i*3)%4)*0.16,\n    sp:(0.00022+(i%5)*0.00007)*((i%2)?1:-1),\n    ph:i*(Math.PI*2/N)*3.1,\n    yA:0.55+band*0.42,\n    yF:1700+i*190,\n    tilt:(band-1)*0.42,\n    dly:i*0.045\n  });\n}\nconst key=new THREE.PointLight(new THREE.Color(PAL[0]),330);key.position.set(3.4,2.8,4);scene.add(key);\nconst rim=new THREE.PointLight(new THREE.Color(PAL[1]),210);rim.position.set(-4.2,-1.6,2.4);scene.add(rim);\nconst fill=new THREE.PointLight(new THREE.Color(PAL[3]),140);fill.position.set(0,4.6,-3);scene.add(fill);\nconst back=new THREE.PointLight(new THREE.Color(PAL[2]),120);back.position.set(-1.5,-3.6,-3.2);scene.add(back);\nscene.add(new THREE.AmbientLight(0x5a48b4,3.4));\naddEventListener('resize',function(){camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight);});\nlet px=0,py=0,tx=0,ty=0;\nif(slidecode.onPointer)slidecode.onPointer(function(p){if(p&&p.inside){tx=(p.x-0.5)*0.5;ty=(p.y-0.5)*0.35;}else{tx=0;ty=0;}});\nconst expo=function(t){return t<=0?0:(t>=1?1:1-Math.pow(2,-10*t));};\nlet start=null;\nfunction frame(now){\n  if(start===null)start=now;\n  const t=now-start;\n  px+=(tx-px)*0.05;py+=(ty-py)*0.05;\n  group.rotation.y=t/6000+px;\n  group.rotation.x=Math.sin(t/7200)*0.16+py;\n  group.position.y=Math.sin(t/2600)*0.12;\n  for(let i=0;i<bits.length;i++){\n    const b=bits[i];\n    const k=SKIP?1:expo(Math.min(Math.max((t/1000-b.dly)/1.15,0),1));\n    const a=b.ph+t*b.sp;\n    const rr=b.r*(0.30+0.70*k);\n    b.m.position.set(Math.cos(a)*rr,Math.sin(a*1.3)*b.yA+b.tilt+(1-k)*-1.6,Math.sin(a)*rr*0.72);\n    b.m.rotation.x=t/(2400+i*210);\n    b.m.rotation.y=t/(3300+i*160);\n    b.m.rotation.z=Math.sin(t/(4100+i*140))*0.9;\n    b.m.scale.setScalar(k*(1+0.09*Math.sin(t/900+i)));\n    b.m.material.emissiveIntensity=0.20+0.16*Math.sin(t/1200+i*1.7);\n  }\n  key.intensity=330+Math.sin(t/1100)*80;\n  rim.intensity=210+Math.sin(t/1500+2)*70;\n  renderer.render(scene,camera);\n  requestAnimationFrame(frame);\n}\nslidecode.onReveal(function(){requestAnimationFrame(frame);});\n",
                "libs": [
                  "three"
                ]
              },
              {
