                "type": "code-block",
                "code": "const T=(slidecode.theme&&slidecode.theme.colors)||{};\nconst PAPER=T.paper||'#FFF6EC';\nconst CANVAS=T.canvas||'#14102A';\nconst SETS=[[],[48,228],[48,84,12],[48,168,288]];\nconst NAMES=['LA RUEDA','COMPLEMENTARIO','ANÁLOGO','TRÍADA'];\nconst c=document.createElement('canvas');document.body.appendChild(c);\nconst ctx=c.getContext('2d');\nconst dpr=Math.min(devicePixelRatio||1,2);\nlet W,H;\nfunction size(){W=innerWidth;H=innerHeight;c.width=W*dpr;c.height=H*dpr;c.style.width=W+'px';c.style.height=H+'px';ctx.setTransform(dpr,0,0,dpr,0,0);}\nsize();addEventListener('resize',size);\nconst expo=function(t){return t>=1?1:1-Math.pow(2,-10*t);};\nconst cl=function(v,a,b){return v<a?a:(v>b?b:v);};\nconst SKIP=slidecode.mode==='edit';\nfunction target(){return SKIP?3:cl(slidecode.step,0,3);}\nlet cur=target(),prev=cur,tSwitch=-99999,tNow=0;\nfunction bump(){prev=cur;cur=target();tSwitch=tNow;}\nslidecode.onStep(bump);\nslidecode.onModeChange(bump);\nlet px=0,py=0,tx=0,ty=0;\nif(slidecode.onPointer)slidecode.onPointer(function(p){if(p&&p.inside){tx=p.x-0.5;ty=p.y-0.5;}else{tx=0;ty=0;}});\nfunction ang(h,rot){return (h-90)*Math.PI/180+rot;}\nfunction drawSet(idx,alpha,cx,cy,R,rot,t){\n  const set=SETS[idx];if(!set||!set.length)return;\n  const pts=set.map(function(h){const a=ang(h,rot);return [cx+Math.cos(a)*R*0.83,cy+Math.sin(a)*R*0.83,h];});\n  ctx.globalAlpha=alpha*0.7;ctx.strokeStyle=PAPER;ctx.lineWidth=1.6;\n  ctx.beginPath();\n  pts.forEach(function(p,i){i?ctx.lineTo(p[0],p[1]):ctx.moveTo(p[0],p[1]);});\n  if(pts.length>2)ctx.closePath();\n  ctx.stroke();\n  pts.forEach(function(p,i){\n    const pulse=Math.sin(t/520+i)*0.5+0.5;\n    ctx.globalAlpha=alpha;ctx.fillStyle='hsl('+p[2]+',86%,58%)';\n    ctx.beginPath();ctx.arc(p[0],p[1],9+2.5*pulse,0,Math.PI*2);ctx.fill();\n    ctx.globalAlpha=alpha*0.22;\n    ctx.beginPath();ctx.arc(p[0],p[1],19+9*pulse,0,Math.PI*2);ctx.fill();\n    ctx.globalAlpha=alpha;ctx.fillStyle=PAPER;\n    ctx.font='700 11px ui-monospace, Menlo, monospace';ctx.textAlign='center';\n    ctx.fillText(p[2]+'°',p[0],p[1]-22);\n  });\n  ctx.globalAlpha=1;\n}\nlet start=null;\nfunction draw(now){\n  if(start===null)start=now;\n  const t=now-start;tNow=t;\n  const k=SKIP?1:expo(cl(t/1100,0,1));\n  px+=(tx-px)*0.06;py+=(ty-py)*0.06;\n  ctx.clearRect(0,0,W,H);\n  const cx=W/2+px*36,cy=H/2+py*26,R=Math.min(W,H)*0.40*(0.86+0.14*k);\n  const rot=t/12000;\n  const seg=Math.PI*2/72;\n  for(let i=0;i<72;i++){\n    const a0=-Math.PI/2+i*seg+rot,a1=a0+seg*1.03;\n    const appear=SKIP?1:expo(cl((t-i*9)/520,0,1));\n    if(appear<=0)continue;\n    const sweep=Math.sin(t/1400-i*0.09)*0.5+0.5;\n    ctx.globalAlpha=appear*(0.7+0.3*sweep);\n    ctx.fillStyle='hsl('+(i*5)+',84%,'+(51+7*sweep)+'%)';\n    ctx.beginPath();\n    ctx.arc(cx,cy,R,a0,a1);ctx.arc(cx,cy,R*0.66,a1,a0,true);ctx.closePath();ctx.fill();\n  }\n  ctx.globalAlpha=1;\n  const sw=cl((t-tSwitch)/460,0,1);\n  if(prev!==cur&&sw<1)drawSet(prev,1-sw,cx,cy,R,rot,t);\n  drawSet(cur,(prev!==cur)?sw:1,cx,cy,R,rot,t);\n  ctx.globalAlpha=k*0.94;ctx.fillStyle=CANVAS;\n  ctx.beginPath();ctx.arc(cx,cy,R*0.44,0,Math.PI*2);ctx.fill();\n  ctx.globalAlpha=k;ctx.textAlign='center';\n  ctx.fillStyle=PAPER;ctx.font='800 24px system-ui, sans-serif';\n  ctx.fillText(NAMES[cur],cx,cy+2);\n  ctx.fillStyle='rgba(255,246,236,0.45)';ctx.font='700 11px ui-monospace, Menlo, monospace';\n  ctx.fillText(cur?(SETS[cur].join('°  ·  ')+'°'):'360 GRADOS DE LUZ',cx,cy+26);\n  ctx.globalAlpha=1;\n  requestAnimationFrame(draw);\n}\nslidecode.onReveal(function(){requestAnimationFrame(draw);});\n",
                "stepCount": 3
              }
