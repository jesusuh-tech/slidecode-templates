{
  "sctemplate": "0.1",
  "meta": {
    "id": "cromatica-el-color-y-la-alegria",
    "name": "CROMÁTICA — el color y la alegría",
    "author": "Jesus Hurtado"
  },
  "size": {
    "width": 1920,
    "height": 1080
  },
  "theme": {
    "colors": {
      "canvas": "#FFF6EC",
      "ink": "#14102A",
      "muted": "#FFD429",
      "accent": "#FF7A29",
      "tone-1": "#F53B84",
      "tone-2": "#4B2BE8",
      "tone-3": "#2D6BF0",
      "tone-4": "#7BE43B",
      "tone-5": "#2FD3D8",
      "tone-6": "#EE3B3B"
    },
    "fonts": {
      "display": "Poppins",
      "body": "Poppins"
    },
    "fontFaces": [
      {
        "family": "Poppins",
        "src": "data:font/woff2;base64,",
        "weight": 400,
        "style": "normal"
      },
      {
        "family": "Poppins",
        "src": "data:font/woff2;base64,",
        "weight": 500,
        "style": "normal"
      },
      {
        "family": "Poppins",
        "src": "data:font/woff2;base64,",
        "weight": 800,
        "style": "normal"
      }
