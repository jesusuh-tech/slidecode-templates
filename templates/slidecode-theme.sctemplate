        "type": "code-block",
        "code": "const __TC=(slidecode.theme&&slidecode.theme.colors)||{};\nconst ACCENT = (__TC.accent||(__TC.ink||'#FFFFFF'));\nconst ink = a => 'rgba(255,255,255,' + a + ')';\nconst c = document.createElement('canvas'); document.body.appendChild(c);\nconst ctx = c.getContext('2d');\nconst dpr = Math.min(devicePixelRatio || 1, 2);\nlet W, H;\nfunction size(){ W = innerWidth; H = innerHeight; c.width = W*dpr; c.height = H*dpr; c.style.width = W+'px'; c.style.height = H+'px'; ctx.setTransform(dpr,0,0,dpr,0,0); }\nsize(); addEventListener('resize', size);\nconst expo = t => t >= 1 ? 1 : 1 - Math.pow(2, -10*t);\nconst clamp01 = v => Math.min(Math.max(v, 0), 1);\nconst rnd = n => { const x = Math.sin(n*127.1)*43758.5453; return x - Math.floor(x); };\nconst MONO = 'ui-monospace, Menlo, monospace';\nconst HUBS = [\n  { n: 'MARKETING',  c: (__TC.ink||'#FFFFFF'), kids: ['SEO', 'PAID MEDIA', 'FUNNEL'],          brand: 'BYD' },\n  { n: 'CX',         c: (__TC.lilac||'#C4C4C4'), kids: ['JOURNEY', 'NPS', 'LOYALTY'],            brand: 'SPOTIFY' },\n  { n: 'ESTRATEGIA', c: (__TC.tangerine||'#8F8F8F'), kids: ['INSIGHTS', 'KPIS', 'POSICIONAM.'],      brand: 'FALABELLA' },\n  { n: 'BRANDING',   c: (__TC.ink||'#FFFFFF'), kids: ['IDENTIDAD', 'TONO DE VOZ', 'ARQUETIPO'],brand: 'NIKE' },\n  { n: 'DISEÑO',     c: (__TC.muted||'#A6A6A6'), kids: ['DESIGN SYSTEM', 'MOTION', 'UI KIT'],    brand: 'APPLE' }\n];\nconst INTRO = 1000, SIG_EVERY = 1700;\nconst SKIP = slidecode.mode === 'edit';\nconst pop = (t, at) => SKIP ? 1 : expo(clamp01((t - at)/480));\nconst AMB = Array.from({length: 70}, (_, i) => ({\n  a: rnd(i*3+1)*Math.PI*2, r: 0.30 + rnd(i*7+2)*0.70,\n  sp: 0.5 + rnd(i*11+3), ph: rnd(i*13+5)*6.28\n}));\nlet start = null;\nfunction draw(now){\n  if (start === null) start = now;\n  const t = now - start;\n  const run = Math.max(0, t - (SKIP ? 0 : INTRO));\n  ctx.clearRect(0,0,W,H);\n  const cx = W/2, cy = H/2 + 6;\n  const RX1 = W*0.19, RY1 = H*0.25, RX2 = W*0.315, RY2 = H*0.40, RX3 = W*0.40, RY3 = H*0.46;\n  const fl = (i, sp) => Math.sin(run/1400 + i*2.1)*sp;\n  const kC = pop(t, 150);\n  // anillos de órbita punteados (satélites)\n  ctx.setLineDash([2,6]);\n  ctx.strokeStyle = ink(0.09); ctx.lineWidth = 1;\n  ctx.globalAlpha = kC;\n  [[RX2+16, RY2+14], [RX3+22, RY3+18]].forEach(rr2 => {\n    ctx.beginPath(); ctx.ellipse(cx, cy, rr2[0], rr2[1], 0, 0, Math.PI*2); ctx.stroke();\n  });\n  ctx.setLineDash([]);\n  // ecosistema ambiente: nodos diminutos a la deriva + hilos tenues\n  const ambPos = AMB.map(m => ({\n    x: cx + Math.cos(m.a + run/22000*m.sp)*RX3*m.r*1.05,\n    y: cy + Math.sin(m.a + run/22000*m.sp)*RY3*m.r*1.05 + Math.sin(run/1600 + m.ph)*2\n  }));\n  for (let i = 0; i < AMB.length; i++){\n    const p1 = ambPos[i], p2 = ambPos[(i*7+11) % AMB.length];\n    const dx = p1.x-p2.x, dy = p1.y-p2.y;\n    if (dx*dx + dy*dy < 8100){\n      ctx.strokeStyle = ink(0.05); ctx.lineWidth = 0.8;\n      ctx.beginPath(); ctx.moveTo(p1.x, p1.y); ctx.lineTo(p2.x, p2.y); ctx.stroke();\n    }\n  }\n  AMB.forEach((m, i) => {\n    ctx.fillStyle = ink(0.10 + rnd(i*17+9)*0.14);\n    ctx.beginPath(); ctx.arc(ambPos[i].x, ambPos[i].y, 0.9 + rnd(i*19+4)*1.3, 0, Math.PI*2); ctx.fill();\n  });\n  ctx.globalAlpha = 1;\n  // posiciones\n  const pos = HUBS.map((h, i) => {\n    const a = -Math.PI/2 + i*Math.PI*2/5;\n    const hx = cx + Math.cos(a)*RX1 + fl(i, 2.5), hy = cy + Math.sin(a)*RY1 + fl(i+9, 2.5);\n    const kids = h.kids.map((kn, j) => {\n      const ka = a + (j-1)*0.40;\n      return { x: cx + Math.cos(ka)*RX2 + fl(i*3+j, 3), y: cy + Math.sin(ka)*RY2 + fl(i*5+j, 3),\n               k: pop(t, 720 + (i*3+j)*45), n: kn };\n    });\n    const ba = a - 0.30;\n    return { a, hx, hy, hk: pop(t, 300 + i*90), kids,\n             bx: cx + Math.cos(ba)*RX3 + fl(i+20, 2), by: cy + Math.sin(ba)*RY3 + fl(i+30, 2),\n             bk: pop(t, 1050 + i*70) };\n  });\n  // aristas\n  pos.forEach((p, i) => {\n    const h = HUBS[i];\n    const shim = e => 0.16 + 0.10*Math.sin(run/1700 + e*2.7);\n    ctx.strokeStyle = h.c; ctx.lineWidth = 1;\n    ctx.globalAlpha = Math.min(kC, p.hk)*shim(i);\n    ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(p.hx, p.hy); ctx.stroke();\n    p.kids.forEach((kp, j) => {\n      ctx.globalAlpha = Math.min(p.hk, kp.k)*shim(i*3+j+7);\n      ctx.beginPath(); ctx.moveTo(p.hx, p.hy); ctx.lineTo(kp.x, kp.y); ctx.stroke();\n    });\n    ctx.globalAlpha = Math.min(p.hk, p.bk)*(shim(i+40)+0.06);\n    ctx.setLineDash([3,4]);\n    ctx.beginPath(); ctx.moveTo(p.hx, p.hy); ctx.lineTo(p.bx, p.by); ctx.stroke();\n    ctx.setLineDash([]);\n    ctx.globalAlpha = 1;\n  });\n  // señales viajando (conocimiento propagándose)\n  if (run > 0){\n    for (const s of [0, 1]){\n      const nsg = Math.floor((run + s*850)/SIG_EVERY);\n      const ph = ((run + s*850) % SIG_EVERY)/SIG_EVERY;\n      const hi = Math.floor(rnd(nsg*13 + s*7 + 1)*5);\n      const ki = Math.floor(rnd(nsg*17 + s*3 + 2)*3);\n      const p = pos[hi], kp = p.kids[ki];\n      let x, y;\n      if (ph < 0.5){ const q = expo(ph/0.5); x = cx + (p.hx-cx)*q; y = cy + (p.hy-cy)*q; }\n      else { const q = expo((ph-0.5)/0.5); x = p.hx + (kp.x-p.hx)*q; y = p.hy + (kp.y-p.hy)*q; }\n      ctx.fillStyle = HUBS[hi].c;\n      for (let j = 0; j < 5; j++){\n        ctx.globalAlpha = (1-j/5)*0.9;\n        const bx2 = ph < 0.5 ? cx : p.hx, by2 = ph < 0.5 ? cy : p.hy;\n        const qq = Math.max(0, 1 - j*0.07);\n        ctx.beginPath(); ctx.arc(bx2 + (x-bx2)*qq, by2 + (y-by2)*qq, 2.6 - j*0.35, 0, Math.PI*2); ctx.fill();\n      }\n      ctx.globalAlpha = 1;\n    }\n  }\n  // etiqueta orientada hacia fuera\n  function label(txt, x, y, ang, font, col, alpha){\n    ctx.font = font; ctx.fillStyle = col; ctx.globalAlpha = alpha;\n    const cs = Math.cos(ang);\n    if (cs > 0.18){ ctx.textAlign = 'left'; ctx.fillText(txt, x+9, y+3); }\n    else if (cs < -0.18){ ctx.textAlign = 'right'; ctx.fillText(txt, x-9, y+3); }\n    else { ctx.textAlign = 'center'; ctx.fillText(txt, x, y + (Math.sin(ang) > 0 ? 16 : -10)); }\n    ctx.globalAlpha = 1;\n  }\n  // nodos\n  pos.forEach((p, i) => {\n    const h = HUBS[i];\n    p.kids.forEach((kp, j) => {\n      ctx.globalAlpha = kp.k*0.9; ctx.fillStyle = h.c;\n      ctx.beginPath(); ctx.arc(kp.x, kp.y, 3.2, 0, Math.PI*2); ctx.fill();\n      label(kp.n, kp.x, kp.y, Math.atan2(kp.y-cy, kp.x-cx), '600 8.5px ' + MONO, ink(0.55), kp.k);\n    });\n    ctx.globalAlpha = p.bk; ctx.strokeStyle = (__TC.ink||'#FFFFFF'); ctx.lineWidth = 1.6;\n    ctx.beginPath(); ctx.arc(p.bx, p.by, 4.6, 0, Math.PI*2); ctx.stroke();\n    label(h.brand, p.bx, p.by, Math.atan2(p.by-cy, p.bx-cx), '700 9.5px ' + MONO, (__TC.ink||'#FFFFFF'), p.bk);\n    const tw = 0.75 + 0.25*Math.sin(run/900 + i*1.7);\n    ctx.globalAlpha = p.hk; ctx.fillStyle = h.c;\n    ctx.beginPath(); ctx.arc(p.hx, p.hy, 6.5, 0, Math.PI*2); ctx.fill();\n    ctx.globalAlpha = p.hk*0.25*tw;\n    ctx.beginPath(); ctx.arc(p.hx, p.hy, 11, 0, Math.PI*2); ctx.fill();\n    label(h.n, p.hx, p.hy, Math.atan2(p.hy-cy, p.hx-cx), '700 10.5px ' + MONO, h.c, p.hk);\n    ctx.globalAlpha = 1;\n  });\n  // retícula de rastreo sobre el hub en foco\n  if (run > 0){\n    const tp = pos[Math.floor(run/2600) % 5];\n    const rk = expo(clamp01((run % 2600)/380));\n    const rr3 = 15 + 3*Math.sin(run/420);\n    ctx.strokeStyle = (__TC.ink||'#FFFFFF'); ctx.globalAlpha = 0.75*rk*tp.hk; ctx.lineWidth = 1.2;\n    ctx.beginPath(); ctx.arc(tp.hx, tp.hy, rr3, run/900, run/900 + Math.PI*1.5); ctx.stroke();\n    for (let q = 0; q < 4; q++){\n      const qa = q*Math.PI/2 + run/1400;\n      ctx.beginPath();\n      ctx.moveTo(tp.hx + Math.cos(qa)*(rr3+3), tp.hy + Math.sin(qa)*(rr3+3));\n      ctx.lineTo(tp.hx + Math.cos(qa)*(rr3+7), tp.hy + Math.sin(qa)*(rr3+7));\n      ctx.stroke();\n    }\n    ctx.globalAlpha = 1;\n  }\n  // centro BBK\n  ctx.globalAlpha = kC;\n  const cp = 1 + 0.05*Math.sin(run/600);\n  ctx.fillStyle = ACCENT;\n  ctx.beginPath(); ctx.arc(cx, cy, 12*cp, 0, Math.PI*2); ctx.fill();\n  ctx.fillStyle = (__TC.void||'#000000'); ctx.font = '800 8px ' + MONO; ctx.textAlign = 'center';\n  ctx.fillText('sc', cx, cy+3);\n  ctx.globalAlpha = 1;\n  requestAnimationFrame(draw);\n}\nslidecode.onReveal(() => requestAnimationFrame(draw));"
      }
    },
    {
      "id": "s5-kpi",
      "node": {
        "id": "s5-kpi",
        "frame": {
          "x": 560,
          "y": 120,
          "w": 640,
          "h": 480
        },
        "type": "code-block",
        "code": "const P = slidecode.props || {};\nconst T = (slidecode.theme && slidecode.theme.colors) || {};\nconst TF = (slidecode.theme && slidecode.theme.fonts) || {};\nconst ACCENT = P.accent || T.accent || '#FFFFFF';\nconst INK = P.ink || T.ink || '#FFFFFF';\nconst ink = a => 'rgba(255,255,255,' + a + ')';\nconst c = document.createElement('canvas'); document.body.appendChild(c);\nconst ctx = c.getContext('2d');\nconst dpr = Math.min(devicePixelRatio || 1, 2);\nlet W, H;\nfunction size(){ W = innerWidth; H = innerHeight; c.width = W*dpr; c.height = H*dpr; c.style.width = W+'px'; c.style.height = H+'px'; ctx.setTransform(dpr,0,0,dpr,0,0); }\nsize(); addEventListener('resize', size);\nconst expo = t => t >= 1 ? 1 : 1 - Math.pow(2, -10*t);\nconst rnd = n => { const x = Math.sin(n*127.1)*43758.5453; return x - Math.floor(x); };\nconst MONO = TF.mono || 'ui-monospace, Menlo, monospace';\nconst SERIF = TF.serif || 'Georgia, serif';\nconst ROWS = [\n  { name:'TIKTOK',    base:61700, rate:9, delta:'+23%' },\n  { name:'INSTAGRAM', base:48200, rate:7, delta:'+12%' },\n  { name:'YOUTUBE',   base:33400, rate:5, delta:'+8%'  },\n  { name:'X',         base:21900, rate:3, delta:'+5%'  },\n  { name:'LINKEDIN',  base:17300, rate:2, delta:'+9%'  }\n];\nconst ALPHAS = [1, 0.62, 0.44, 0.30, 0.22];\nconst INTRO = 1000, EVERY = 1400, BURST = 650, FLOAT = 1100, SWEEP_EVERY = 4600, SWEEP_DUR = 1000;\nconst SKIP = slidecode.mode === 'edit';\nfunction rr(x,y,w,h,r){ ctx.beginPath(); ctx.moveTo(x+r,y); ctx.arcTo(x+w,y,x+w,y+h,r); ctx.arcTo(x+w,y+h,x,y+h,r); ctx.arcTo(x,y+h,x,y,r); ctx.arcTo(x,y,x+w,y,r); ctx.closePath(); }\nfunction fmt(v){ return v >= 1000 ? (v/1000).toFixed(1)+'K' : String(Math.round(v)); }\nfunction icon(kind, cx, cy, a, pulse){\n  ctx.save();\n  ctx.translate(cx, cy); ctx.scale(1+0.3*pulse, 1+0.3*pulse);\n  ctx.globalAlpha *= a;\n  ctx.strokeStyle = INK; ctx.fillStyle = INK; ctx.lineWidth = 1.6; ctx.lineCap = 'round'; ctx.lineJoin = 'round';\n  if (kind === 'TIKTOK'){\n    ctx.beginPath(); ctx.arc(-3.4, 4.6, 3.1, 0, Math.PI*2); ctx.fill();\n    ctx.lineWidth = 1.8;\n    ctx.beginPath(); ctx.moveTo(-0.6, 4.6); ctx.lineTo(-0.6, -7); ctx.quadraticCurveTo(1.6, -3.2, 6.4, -3.2); ctx.stroke();\n  } else if (kind === 'INSTAGRAM'){\n    rr(-7.5,-7.5,15,15,4.5); ctx.stroke();\n    ctx.beginPath(); ctx.arc(0,0,3.6,0,Math.PI*2); ctx.stroke();\n    ctx.beginPath(); ctx.arc(4.3,-4.3,1.1,0,Math.PI*2); ctx.fill();\n  } else if (kind === 'YOUTUBE'){\n    rr(-8.5,-6,17,12,3.5); ctx.stroke();\n    ctx.beginPath(); ctx.moveTo(-2.2,-3); ctx.lineTo(3.4,0); ctx.lineTo(-2.2,3); ctx.closePath(); ctx.fill();\n  } else if (kind === 'X'){\n    ctx.lineWidth = 2.2; ctx.beginPath(); ctx.moveTo(-6.5,-7); ctx.lineTo(6.5,7); ctx.stroke();\n    ctx.lineWidth = 1.3; ctx.beginPath(); ctx.moveTo(6.5,-7); ctx.lineTo(-6.5,7); ctx.stroke();\n  } else {\n    rr(-7.5,-7.5,15,15,3); ctx.stroke();\n    ctx.font = '700 9px ' + MONO; ctx.textAlign = 'center'; ctx.fillText('in', 0, 3.4);\n  }\n  ctx.restore();\n}\nfunction burstRow(i){ return Math.floor(rnd(i*11+2)*ROWS.length); }\nfunction burstAmt(i){ return 80 + Math.round(rnd(i*5+1)*260); }\nfunction values(run){\n  const n = Math.floor(run/EVERY);\n  const vals = ROWS.map(r => r.base + r.rate*run/1000);\n  for (let i = 1; i <= n; i++){\n    const p = Math.min((run - i*EVERY)/BURST, 1);\n    if (p > 0) vals[burstRow(i)] += burstAmt(i)*expo(p);\n  }\n  return vals;\n}\nlet start = null;\nfunction draw(now){\n  if (start === null) start = now;\n  const t = now - start;\n  const k = SKIP ? 1 : expo(Math.min(t/INTRO, 1));\n  const run = Math.max(0, t - (SKIP ? 0 : INTRO));\n  ctx.clearRect(0,0,W,H);\n  ctx.fillStyle = T.surface || '#101010'; rr(0.5,0.5,W-1,H-1,16); ctx.fill();\n  ctx.strokeStyle = ink(0.10); ctx.lineWidth = 1; ctx.stroke();\n  const pad = 26;\n  const blink = 0.35 + 0.65*Math.abs(Math.sin(run/520));\n  ctx.fillStyle = ACCENT; ctx.globalAlpha = k*blink;\n  ctx.beginPath(); ctx.arc(pad+3, 27, 3, 0, Math.PI*2); ctx.fill();\n  ctx.globalAlpha = k;\n  ctx.fillStyle = ink(0.42); ctx.font = '600 10px ' + MONO; ctx.textAlign = 'left';\n  ctx.fillText('SOCIAL / PULSE — EN VIVO', pad+14, 31);\n  const vals = values(run);\n  const total = vals.reduce((a,b) => a+b, 0);\n  ctx.textAlign = 'right';\n  ctx.fillStyle = INK; ctx.font = 'italic 600 30px ' + SERIF;\n  ctx.fillText(fmt(total*k), W-pad, 40);\n  ctx.fillStyle = ink(0.38); ctx.font = '600 9px ' + MONO;\n  ctx.fillText('INTERACCIONES · 7 DÍAS', W-pad, 56);\n  const y0 = 96, rowH = 60;\n  const maxV = Math.max.apply(null, vals)*1.06;\n  const trackX = pad+44, trackR = W-pad;\n  for (let q = 1; q <= 3; q++){\n    const gx = trackX + q*0.25*(trackR-trackX);\n    ctx.strokeStyle = ink(0.05); ctx.lineWidth = 1;\n    ctx.beginPath(); ctx.moveTo(gx, y0-10); ctx.lineTo(gx, y0-16+rowH*ROWS.length); ctx.stroke();\n  }\n  const n = Math.floor(run/EVERY);\n  ROWS.forEach((r,i) => {\n    const y = y0 + i*rowH;\n    const pin = SKIP ? 1 : expo(Math.min(Math.max((t-260-i*110)/480, 0), 1));\n    const bin = SKIP ? 1 : expo(Math.min(Math.max((t-420-i*110)/800, 0), 1));\n    let pulse = 0, flash = 0;\n    for (let b = Math.max(1, n-2); b <= n; b++){\n      if (burstRow(b) !== i) continue;\n      const p = (run - b*EVERY)/FLOAT;\n      if (p >= 0 && p < 1){ pulse = Math.max(pulse, 1-p); flash = Math.max(flash, 1-p); }\n    }\n    ctx.save(); ctx.translate((1-pin)*-16, 0); ctx.globalAlpha = pin*k;\n    const A = ALPHAS[i];\n    icon(r.name, pad+11, y+9, 0.25+0.75*A, pulse*0.6);\n    ctx.font = '600 10px ' + MONO; ctx.textAlign = 'left';\n    ctx.fillStyle = i === 0 ? INK : ink(0.30+0.4*A);\n    ctx.fillText(r.name, trackX, y+7);\n    ctx.textAlign = 'right';\n    ctx.fillStyle = i === 0 ? INK : ink(0.35+0.5*A);\n    ctx.font = '600 13px ' + MONO;\n    const vs = fmt(vals[i]*bin);\n    ctx.fillText(vs, trackR, y+8);\n    const vw = ctx.measureText(vs).width;\n    ctx.fillStyle = i === 0 ? ACCENT : ink(0.32);\n    ctx.font = '600 9px ' + MONO;\n    ctx.fillText(r.delta, trackR - vw - 10, y+7);\n    const by = y+18, bh = 6;\n    ctx.fillStyle = ink(0.07); rr(trackX, by, trackR-trackX, bh, 3); ctx.fill();\n    const w = Math.max(bh, (trackR-trackX)*(vals[i]/maxV)*bin);\n    if (i === 0){\n      const g = ctx.createLinearGradient(trackX, 0, trackX+w, 0);\n      g.addColorStop(0, 'rgba(255,255,255,0.55)'); g.addColorStop(1, ACCENT);\n      ctx.fillStyle = g;\n    } else ctx.fillStyle = ink(0.16+0.5*A);\n    rr(trackX, by, w, bh, 3); ctx.fill();\n    if (bin >= 0.99){\n      const tipX = trackX+w, tipY = by+bh/2;\n      if (i === 0){\n        const pw = (Math.sin(run/460)+1)/2;\n        ctx.fillStyle = ACCENT;\n        ctx.globalAlpha = pin*k*(0.28*(1-pw) + flash*0.4);\n        ctx.beginPath(); ctx.arc(tipX, tipY, 7+6*pw, 0, Math.PI*2); ctx.fill();\n        ctx.globalAlpha = pin*k;\n        ctx.beginPath(); ctx.arc(tipX, tipY, 3.2, 0, Math.PI*2); ctx.fill();\n      } else if (flash > 0){\n        ctx.fillStyle = INK; ctx.globalAlpha = pin*k*flash*0.5;\n        ctx.beginPath(); ctx.arc(tipX, tipY, 3+3*flash, 0, Math.PI*2); ctx.fill();\n        ctx.globalAlpha = pin*k;\n      }\n    }\n    ctx.restore();\n  });\n  for (let b = Math.max(1, n-2); b <= n; b++){\n    const p = (run - b*EVERY)/FLOAT;\n    if (p < 0 || p >= 1) continue;\n    const i = burstRow(b);\n    const w = (trackR-trackX)*(vals[i]/maxV);\n    ctx.globalAlpha = k*(1-p)*(p < 0.12 ? p/0.12 : 1);\n    ctx.fillStyle = i === 0 ? ACCENT : ink(0.75);\n    ctx.font = '600 11px ' + MONO; ctx.textAlign = 'center';\n    ctx.fillText('+'+burstAmt(b), Math.min(trackX+w, trackR-16), y0 + i*rowH + 10 - 16*p);\n    ctx.globalAlpha = k;\n  }\n  const sw = run % SWEEP_EVERY;\n  if (run > 0 && sw < SWEEP_DUR){\n    const sx = trackX + (sw/SWEEP_DUR)*(trackR-trackX);\n    const sg = ctx.createLinearGradient(sx-20, 0, sx, 0);\n    sg.addColorStop(0, 'rgba(255,255,255,0)'); sg.addColorStop(1, 'rgba(255,255,255,0.06)');\n    ctx.fillStyle = sg; ctx.fillRect(sx-20, y0-16, 20, rowH*ROWS.length);\n    ctx.strokeStyle = ink(0.14); ctx.lineWidth = 1;\n    ctx.beginPath(); ctx.moveTo(sx, y0-16); ctx.lineTo(sx, y0-16+rowH*ROWS.length); ctx.stroke();\n  }\n  ctx.fillStyle = ink(0.30); ctx.font = '600 9px ' + MONO; ctx.textAlign = 'left';\n  ctx.fillText('CANVAS 2D · DIBUJADO EN DIRECTO', pad, H-18);\n  ctx.textAlign = 'right';\n  ctx.fillText('→ CERO CAPTURAS', W-pad, H-18);\n  ctx.globalAlpha = 1;\n  requestAnimationFrame(draw);\n}\nslidecode.onReveal(() => requestAnimationFrame(draw));",
