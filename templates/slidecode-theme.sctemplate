ct(0,0,W,H);const mn=Math.min(W,H);const A=t*0.5,B=t*0.3,cA=Math.cos(A),sA=Math.sin(A),cB=Math.cos(B),sB=Math.sin(B);const Kp=mn*0.66,cx=W/2,cy=H/2;const aw=0.935,dh=H*0.74,dw=dh*aw,ox=(W-dw)/2,oy=(H-dh)/2;const P=11,ps=t%P;let m;if(ps<4)m=0;else if(ps<5.8)m=sm((ps-4)/1.8);else if(ps<9.5)m=1;else m=1-sm((ps-9.5)/1.5);const fade=Math.min(1,t/1.2);x.fillStyle=INK;for(let i=0;i<N;i++){const ti=i%gn,pj=(i/gn)|0;const th=ti/gn*6.283,pp=pj/rows*6.283;const cth=Math.cos(th),sth=Math.sin(th),cph=Math.cos(pp),sph=Math.sin(pp);const cix=R2+R1*cth,ciy=R1*sth;const ex=cix*(cB*cph+sA*sB*sph)-ciy*cA*sB;const ey=cix*(sB*cph-sA*cB*sph)+ciy*cA*cB;const ez=K2+cA*cix*sph+ciy*sA;const ooz=1/ez;const dsx=cx+Kp*ooz*ex,dsy=cy-Kp*ooz*ey;const dep=cl((ooz-0.125)/0.375);const lx=ox+LT[i][0]*dw,ly=oy+LT[i][1]*dh;const X=dsx+(lx-dsx)*m,Y=dsy+(ly-dsy)*m;const sz=(1.2+1.7*dep)*(1-m)+2*m;const jit=m>0.92?Math.sin(now*0.0018+i*1.7)*0.5:0;x.globalAlpha=fade*((0.32+0.55*dep)*(1-m)+0.92*m);x.beginPath();x.arc(X+jit,Y,sz,0,6.283);x.fill();}x.globalAlpha=1;requestAnimationFrame(draw);}requestAnimationFrame(draw);"
