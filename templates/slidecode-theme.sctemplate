        "type": "code-block",
        "code": "const __TC=(slidecode.theme&&slidecode.theme.colors)||{};\nconst P = slidecode.props || {};\nconst ACCENT = P.accent || (__TC.ink||'#FFFFFF');\nconst INK = P.ink || (__TC.ink||'#FFFFFF');\nconst ink = a => 'rgba(255,255,255,' + a + ')';\nconst grn = a => 'rgba(130,255,20,' + a + ')';\nconst c = document.createElement('canvas'); document.body.appendChild(c);\nconst ctx = c.getContext('2d');\nconst dpr = Math.min(devicePixelRatio || 1, 2);\nlet W, H;\nfunction size(){ W = innerWidth; H = innerHeight; c.width = W*dpr; c.height = H*dpr; c.style.width = W+'px'; c.style.height = H+'px'; ctx.setTransform(dpr,0,0,dpr,0,0); }\nsize(); addEventListener('resize', size);\nconst expo = t => t >= 1 ? 1 : 1 - Math.pow(2, -10*t);\nconst MONO = 'ui-monospace, Menlo, monospace';\nconst SANS = 'Futura, \"Avenir Next\", system-ui, sans-serif';\nconst HOURS = [14, 12, 11, 9, 8, 6, 5, 4];\nconst N = HOURS.length;\nconst MAXV = 16;\nconst INTRO = 900, LINE_AT = 1500, LINE_DUR = 800, SPARK_EVERY = 3200, SWEEP_EVERY = 5200, SWEEP_DUR = 1000;\nconst SKIP = slidecode.mode === 'edit';\n// regresion lineal sobre HOURS\nlet sx=0, sy=0, sxy=0, sxx=0;\nfor (let i=0;i<N;i++){ sx+=i; sy+=HOURS[i]; sxy+=i*HOURS[i]; sxx+=i*i; }\nconst slope = (N*sxy - sx*sy)/(N*sxx - sx*sx);\nconst inter = (sy - slope*sx)/N;\nfunction rr(x,y,w,h,r){ ctx.beginPath(); ctx.moveTo(x+r,y); ctx.arcTo(x+w,y,x+w,y+h,r); ctx.arcTo(x+w,y+h,x,y+h,r); ctx.arcTo(x,y+h,x,y,r); ctx.arcTo(x,y,x+w,y,r); ctx.closePath(); }\nlet start = null;\nfunction draw(now){\n  if (start === null) start = now;\n  const t = now - start;\n  const k = SKIP ? 1 : expo(Math.min(t/INTRO, 1));\n  const run = Math.max(0, t - (SKIP ? 0 : INTRO));\n  const lineK = SKIP ? 1 : expo(Math.min(Math.max((t - LINE_AT)/LINE_DUR, 0), 1));\n  ctx.clearRect(0,0,W,H);\n  ctx.fillStyle = '#0E0E0E'; rr(0.5,0.5,W-1,H-1,16); ctx.fill();\n  ctx.strokeStyle = ink(0.10); ctx.lineWidth = 1; ctx.stroke();\n  const pad = 26;\n  // cabecera\n  const blink = 0.35 + 0.65*Math.abs(Math.sin(run/520));\n  ctx.fillStyle = ACCENT; ctx.globalAlpha = k*blink;\n  ctx.beginPath(); ctx.arc(pad+3, 27, 3, 0, Math.PI*2); ctx.fill();\n  ctx.globalAlpha = k;\n  ctx.fillStyle = ink(0.42); ctx.font = '600 10px ' + MONO; ctx.textAlign = 'left';\n  ctx.fillText('WORKFLOW / AHORRO — 8 SEMANAS', pad+14, 31);\n  const pct = Math.round(72*k);\n  ctx.textAlign = 'right';\n  ctx.fillStyle = ACCENT; ctx.font = '700 34px ' + SANS;\n  ctx.fillText('−' + pct + '%', W-pad, 42);\n  ctx.fillStyle = ink(0.38); ctx.font = '600 9px ' + MONO;\n  ctx.fillText('HORAS POR DECK', W-pad, 58);\n  // area de plot\n  const pl = pad+16, pr = W-pad-8, pt = 96, pb = H-64;\n  const plotW = pr-pl, plotH = pb-pt;\n  const yv = v => pb - (v/MAXV)*plotH;\n  const xc = i => pl + (i+0.5)*plotW/N;\n  // grilla horizontal\n  [0,5,10,15].forEach(g => {\n    ctx.strokeStyle = ink(0.06); ctx.lineWidth = 1;\n    ctx.beginPath(); ctx.moveTo(pl, yv(g)); ctx.lineTo(pr, yv(g)); ctx.stroke();\n    ctx.fillStyle = ink(0.25); ctx.font = '600 9px ' + MONO; ctx.textAlign = 'left';\n    ctx.fillText(g + 'H', pl, yv(g) - 5);\n  });\n  // linea base \"ANTES\"\n  ctx.setLineDash([5,5]); ctx.strokeStyle = ink(0.22); ctx.lineWidth = 1;\n  ctx.globalAlpha = k;\n  ctx.beginPath(); ctx.moveTo(pl, yv(HOURS[0])); ctx.lineTo(pr, yv(HOURS[0])); ctx.stroke();\n  ctx.setLineDash([]);\n  ctx.fillStyle = ink(0.35); ctx.font = '600 9px ' + MONO; ctx.textAlign = 'right';\n  ctx.fillText('ANTES · 14 H', pr, yv(HOURS[0]) - 6);\n  // barras\n  const bw = plotW/N*0.52;\n  for (let i = 0; i < N; i++){\n    const bk = SKIP ? 1 : expo(Math.min(Math.max((t - 200 - i*90)/560, 0), 1));\n    const hero = i === N-1;\n    const h = (HOURS[i]/MAXV)*plotH*bk;\n    const x = xc(i) - bw/2, y = pb - h;\n    ctx.globalAlpha = k;\n    if (hero){\n      const pw = (Math.sin(run/500)+1)/2;\n      ctx.fillStyle = grn(0.10 + 0.10*pw);\n      rr(x-5, y-5*bk, bw+10, h+5*bk, 6); ctx.fill();\n      ctx.fillStyle = ACCENT;\n    } else ctx.fillStyle = ink(0.85);\n    rr(x, y, bw, h, 4); ctx.fill();\n    ctx.globalAlpha = k*bk;\n    ctx.font = '700 12px ' + MONO; ctx.textAlign = 'center';\n    ctx.fillStyle = hero ? ACCENT : ink(0.6);\n    ctx.fillText(HOURS[i] + 'h', xc(i), y - 8);\n    ctx.fillStyle = ink(0.35); ctx.font = '600 9px ' + MONO;\n    ctx.fillText('S' + (i+1), xc(i), pb + 18);\n    ctx.globalAlpha = 1;\n  }\n  // linea de tendencia (regresion) que se traza\n  if (lineK > 0){\n    ctx.globalAlpha = k;\n    ctx.strokeStyle = ACCENT; ctx.lineWidth = 2.4; ctx.lineJoin = 'round'; ctx.lineCap = 'round';\n    ctx.beginPath();\n    const upto = lineK*(N-1);\n    for (let i = 0; i <= Math.floor(upto); i++){\n      const y = yv(inter + slope*i);\n      i ? ctx.lineTo(xc(i), y) : ctx.moveTo(xc(0), yv(inter));\n    }\n    if (upto < N-1){\n      const i = Math.floor(upto), f = upto - i;\n      ctx.lineTo(xc(i) + (xc(i+1)-xc(i))*f, yv(inter + slope*(i+f)));\n    }\n    ctx.stroke();\n    // flecha al final\n    if (lineK >= 1){\n      const ex = xc(N-1), ey = yv(inter + slope*(N-1));\n      const ang = Math.atan2(yv(inter+slope*(N-1)) - yv(inter+slope*(N-2)), xc(N-1)-xc(N-2));\n      ctx.fillStyle = ACCENT;\n      ctx.save(); ctx.translate(ex,ey); ctx.rotate(ang);\n      ctx.beginPath(); ctx.moveTo(2,0); ctx.lineTo(-8,-5); ctx.lineTo(-8,5); ctx.closePath(); ctx.fill();\n      ctx.restore();\n      // pulso del extremo\n      const pw = (Math.sin(run/460)+1)/2;\n      ctx.globalAlpha = k*0.3*(1-pw);\n      ctx.beginPath(); ctx.arc(ex, ey, 7+10*pw, 0, Math.PI*2); ctx.fill();\n      ctx.globalAlpha = k;\n      // chispa que recorre la tendencia (ahorro fluyendo)\n      const sp = (run % SPARK_EVERY)/SPARK_EVERY;\n      if (sp < 0.55){\n        const q = expo(sp/0.55)*(N-1);\n        const sxp = xc(0) + (xc(N-1)-xc(0))*q/(N-1);\n        const syp = yv(inter + slope*q);\n        for (let j = 0; j < 7; j++){\n          const qq = Math.max(0, q - j*0.12);\n          ctx.globalAlpha = k*(1-j/7)*0.9;\n          ctx.fillStyle = ACCENT;\n          ctx.beginPath(); ctx.arc(xc(0)+(xc(N-1)-xc(0))*qq/(N-1), yv(inter+slope*qq), 3-j*0.3, 0, Math.PI*2); ctx.fill();\n        }\n        ctx.globalAlpha = k;\n      }\n    }\n  }\n  // barrido periodico\n  const sw = run % SWEEP_EVERY;\n  if (run > 0 && sw < SWEEP_DUR){\n    const sxx2 = pl + (sw/SWEEP_DUR)*plotW;\n    const sg = ctx.createLinearGradient(sxx2-20, 0, sxx2, 0);\n    sg.addColorStop(0, 'rgba(255,255,255,0)'); sg.addColorStop(1, 'rgba(255,255,255,0.05)');\n    ctx.fillStyle = sg; ctx.fillRect(sxx2-20, pt, 20, plotH);\n    ctx.strokeStyle = ink(0.12); ctx.lineWidth = 1;\n    ctx.beginPath(); ctx.moveTo(sxx2, pt); ctx.lineTo(sxx2, pb); ctx.stroke();\n  }\n  ctx.globalAlpha = k;\n  ctx.fillStyle = ink(0.30); ctx.font = '600 9px ' + MONO; ctx.textAlign = 'left';\n  ctx.fillText('BARRAS + REGRESIÓN · CANVAS 2D', pad, H-18);\n  ctx.textAlign = 'right';\n  ctx.fillText('→ TENDENCIA: −1,5 H / SEMANA', W-pad, H-18);\n  ctx.globalAlpha = 1;\n  requestAnimationFrame(draw);\n}\nslidecode.onReveal(() => requestAnimationFrame(draw));",
