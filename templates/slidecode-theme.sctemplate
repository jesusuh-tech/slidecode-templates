                "code": "const __TC=(slidecode.theme&&slidecode.theme.colors)||{};\nconst c=document.createElement('canvas');document.body.appendChild(c);const x=c.getContext('2d');let W=0,H=0;const dpr=Math.min(devicePixelRatio||1,2);function S(){W=innerWidth;H=innerHeight;c.width=W*dpr;c.height=H*dpr;c.style.width=W+'px';c.style.height=H+'px';x.setTransform(dpr,0,0,dpr,0,0);}S();addEventListener('resize',S);const INK=(__TC.ink||'#FFFFFF'),MUT=(__TC.muted||'#A6A6A6'),FNT=(__TC.faint||'#232323'),SUR=(__TC.surface||'#101010'),ACC=(__TC.accent||(__TC.ink||'#FFFFFF'));const ease=t=>{t=t<0?0:t>1?1:t;return 1-Math.pow(2,-10*t);};const sm=t=>{t=t<0?0:t>1?1:t;return t*t*(3-2*t);};function rr(px,py,w,h,r){x.beginPath();x.moveTo(px+r,py);x.arcTo(px+w,py,px+w,py+h,r);x.arcTo(px+w,py+h,px,py+h,r);x.arcTo(px,py+h,px,py,r);x.arcTo(px,py,px+w,py,r);x.closePath();}function card(){x.fillStyle=SUR;rr(0.75,0.75,W-1.5,H-1.5,12);x.fill();x.strokeStyle=FNT;x.lineWidth=1;rr(0.75,0.75,W-1.5,H-1.5,12);x.stroke();}function lbl(t){x.fillStyle=MUT;x.font='600 10px monospace';x.textAlign='left';x.fillText(t,16,22);x.fillStyle=ACC;x.fillRect(16,28,14,2);}let rev=false,rt=0;function frame(ts){const now=ts;const E=rev?now-rt:0;const intro=rev?sm((now-rt)/500):0;x.clearRect(0,0,W,H);card();lbl('GRÁFICO');x.save();x.globalAlpha=intro;const V=[42,66,50,80,58,92];const n=V.length;const PL=W*0.11,PR=W*0.06,base=H*0.80,top=H*0.36;const span=(W-PL-PR)/n;const bw=span*0.5;const p=ease(E/1200);x.strokeStyle=FNT;x.lineWidth=1;for(let g=0;g<=3;g++){const gy=base-(base-top)*(g/3);x.beginPath();x.moveTo(PL,gy);x.lineTo(W-PR,gy);x.stroke();}for(let i=0;i<n;i++){const h=(V[i]/100)*(base-top)*p*(1+0.04*Math.sin(now*0.003+i));const bx=PL+span*i+(span-bw)/2;x.fillStyle=i===n-1?ACC:INK;rr(bx,base-h,bw,h,3);x.fill();x.fillStyle=i===n-1?ACC:MUT;x.font='600 11px monospace';x.textAlign='center';x.fillText(Math.round(V[i]*p),bx+bw/2,base-h-8);}x.restore();requestAnimationFrame(frame);}if(slidecode.mode==='edit'){rev=true;rt=-1e9;}slidecode.onReveal(function(){rev=true;rt=performance.now();});slidecode.onModeChange(function(m){if(m==='edit'){rev=true;rt=-1e9;}});requestAnimationFrame(frame);",
