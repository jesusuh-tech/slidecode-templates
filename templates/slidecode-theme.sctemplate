        "code": "const __TC=(slidecode.theme&&slidecode.theme.colors)||{};\nconst c=document.createElement('canvas');document.body.appendChild(c);const x=c.getContext('2d');let W=0,H=0;const dpr=Math.min(devicePixelRatio||1,2);function S(){W=innerWidth;H=innerHeight;c.width=W*dpr;c.height=H*dpr;c.style.width=W+'px';c.style.height=H+'px';x.setTransform(dpr,0,0,dpr,0,0);}S();addEventListener('resize',S);const nodes=[];const NN=26;for(let k=0;k<NN;k++){const a=k*2.39996;const r=0.03+k*0.016;nodes.push({nx:0.5+Math.cos(a)*r*0.9,ny:0.5+Math.sin(a)*r*1.15});}const edges=[];for(let a=0;a<NN;a++)for(let b=a+1;b<NN;b++){const dx=nodes[a].nx-nodes[b].nx,dy=nodes[a].ny-nodes[b].ny;if(Math.hypot(dx,dy)<0.12)edges.push([a,b]);}function draw(now){x.clearRect(0,0,W,H);x.globalAlpha=0.35;x.strokeStyle=(__TC.muted||'#A6A6A6');x.lineWidth=1;for(const e of edges){const A=nodes[e[0]],B=nodes[e[1]];x.beginPath();x.moveTo(A.nx*W,A.ny*H);x.lineTo(B.nx*W,B.ny*H);x.stroke();}for(let k=0;k<NN;k++){const n=nodes[k];const px=n.nx*W+Math.sin(now*0.0006+k)*4,py=n.ny*H+Math.cos(now*0.0007+k)*4;x.globalAlpha=0.9;x.fillStyle=k%6===0?(__TC.ink||'#FFFFFF'):(__TC.ink||'#FFFFFF');x.beginPath();x.arc(px,py,k%6===0?3.5:2.2,0,7);x.fill();}x.globalAlpha=1;requestAnimationFrame(draw);}requestAnimationFrame(draw);"
