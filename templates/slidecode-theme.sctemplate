                "type": "code-block",
                "code": "const __TC=(slidecode.theme&&slidecode.theme.colors)||{};\nconst c=document.createElement('canvas');document.body.appendChild(c);const x=c.getContext('2d');let W=0,H=0;const dpr=Math.min(devicePixelRatio||1,2);function S(){W=innerWidth;H=innerHeight;c.width=W*dpr;c.height=H*dpr;c.style.width=W+'px';c.style.height=H+'px';x.setTransform(dpr,0,0,dpr,0,0);}S();addEventListener('resize',S);const INK=(__TC.ink||'#FFFFFF'),MUT=(__TC.muted||'#A6A6A6'),FNT=(__TC.faint||'#232323'),SUR=(__TC.surface||'#101010'),ACC=(__TC.accent||(__TC.ink||'#FFFFFF'));const PAL=[(__TC.ink||'#FFFFFF'),(__TC.lilac||'#C4C4C4'),(__TC.tangerine||'#8F8F8F')];const sm=t=>{t=t<0?0:t>1?1:t;return t*t*(3-2*t);};function rr(px,py,w,h,r){x.beginPath();x.moveTo(px+r,py);x.arcTo(px+w,py,px+w,py+h,r);x.arcTo(px+w,py+h,px,py+h,r);x.arcTo(px,py+h,px,py,r);x.arcTo(px,py,px+w,py,r);x.closePath();}function card(){x.fillStyle=SUR;rr(0.75,0.75,W-1.5,H-1.5,12);x.fill();x.strokeStyle=FNT;x.lineWidth=1;rr(0.75,0.75,W-1.5,H-1.5,12);x.stroke();}function lbl(t){x.fillStyle=MUT;x.font='600 10px monospace';x.textAlign='left';x.fillText(t,16,22);x.fillStyle=ACC;x.fillRect(16,28,14,2);}let rev=false,rt=0;function frame(ts){const now=ts;const intro=rev?sm((now-rt)/500):0;x.clearRect(0,0,W,H);card();lbl('MÚSICA');x.save();x.globalAlpha=intro;const m=15,midY=H*0.66,maxA=H*0.32,x0=W*0.09,ww=W*0.82,bw=ww/m;for(let i=0;i<m;i++){const a=maxA*(0.18+0.82*Math.abs(Math.sin(i*0.7+now*0.006)*0.6+Math.sin(i*1.9-now*0.009)*0.4));const bx=x0+bw*i+bw*0.2,bwid=bw*0.6;x.fillStyle=PAL[i%3];x.globalAlpha=intro*0.9;rr(bx,midY-a,bwid,a,bwid*0.5);x.fill();}x.globalAlpha=intro*0.35;x.strokeStyle=FNT;x.beginPath();x.moveTo(x0,midY);x.lineTo(x0+ww,midY);x.stroke();x.textAlign='center';x.font='700 16px serif';for(let k=0;k<3;k++){const yy=midY-24-((now*0.045+k*260)%(H*0.42));const xx=W*(0.28+k*0.22);const al=intro*Math.max(0,1-((now*0.045+k*260)%(H*0.42))/(H*0.42));x.globalAlpha=al;x.fillStyle=PAL[k%3];x.fillText(k%2?'♫':'♪',xx,yy);}x.restore();requestAnimationFrame(frame);}if(slidecode.mode==='edit'){rev=true;rt=-1e9;}slidecode.onReveal(function(){rev=true;rt=performance.now();});slidecode.onModeChange(function(m){if(m==='edit'){rev=true;rt=-1e9;}});requestAnimationFrame(frame);",
