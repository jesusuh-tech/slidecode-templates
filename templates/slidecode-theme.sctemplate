        "code": "const __TC=(slidecode.theme&&slidecode.theme.colors)||{};\nconst c=document.createElement('canvas');document.body.appendChild(c);const x=c.getContext('2d');let W=0,H=0;const dpr=Math.min(devicePixelRatio||1,2);function S(){W=innerWidth;H=innerHeight;c.width=W*dpr;c.height=H*dpr;c.style.width=W+'px';c.style.height=H+'px';x.setTransform(dpr,0,0,dpr,0,0);}S();addEventListener('resize',S);const INK=(__TC.ink||'#FFFFFF'),ACC=(__TC.accent||(__TC.ink||'#FFFFFF'));const sm=t=>{t=t<0?0:t>1?1:t;return t*t*(3-2*t);};let rev=false,rt=0;function frame(ts){const now=ts;const E=rev?now-rt:0;const intro=rev?sm((now-rt)/600):0;x.clearRect(0,0,W,H);x.fillStyle=(__TC.void||'#000000');x.fillRect(0,0,W,H);const cx0=W/2,cy0=H*0.50;const gr=x.createRadialGradient(cx0,cy0,0,cx0,cy0,Math.min(W,H)*0.55);gr.addColorStop(0,'rgba(255,255,255,0.12)');gr.addColorStop(1,'rgba(255,255,255,0)');x.fillStyle=gr;x.fillRect(0,0,W,H);const GL='01<>{}/=;+*()[]#'.split('');const NP=92;const base=Math.min(W,H);x.textAlign='center';x.textBaseline='middle';for(let k=0;k<NP;k++){const a=k*2.39996;const rad=base*(0.25+((k*37)%5)*0.045);const ang=a+now*0.00018;const tx=cx0+Math.cos(ang)*rad*1.1;const ty=cy0+Math.sin(ang)*rad;const sx=cx0+Math.cos(a*1.7+k)*base*0.9;const sy=cy0+Math.sin(a*1.3+k)*base*0.7;const dl=(k/NP)*500;const p=sm((E-dl)/900);const px=sx+(tx-sx)*p;const py=sy+(ty-sy)*p;const tw=0.55+0.45*Math.sin(now*0.004+k);x.globalAlpha=Math.max(0,intro*p*tw);x.fillStyle=(k%6===0)?ACC:INK;x.font=(10+((k*13)%5))+'px monospace';x.fillText(GL[k%GL.length],px,py);}x.globalAlpha=1;requestAnimationFrame(frame);}if(slidecode.mode==='edit'){rev=true;rt=-1e9;}slidecode.onReveal(function(){rev=true;rt=performance.now();});slidecode.onModeChange(function(m){if(m==='edit'){rev=true;rt=-1e9;}});requestAnimationFrame(frame);",
