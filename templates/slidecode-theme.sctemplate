        "type": "code-block",
        "code": "const __TC=(slidecode.theme&&slidecode.theme.colors)||{};\nconst c=document.createElement('canvas');document.body.appendChild(c);const x=c.getContext('2d');let W=0,H=0;const dpr=Math.min(devicePixelRatio||1,2);function S(){W=innerWidth;H=innerHeight;c.width=W*dpr;c.height=H*dpr;c.style.width=W+'px';c.style.height=H+'px';x.setTransform(dpr,0,0,dpr,0,0);}S();addEventListener('resize',S);const INK='#EDEDED',MUT='#8A8A8A',FNT=(__TC.faint||'#232323'),SUR=(__TC.surface||'#101010'),ACC=(__TC.accent||(__TC.ink||'#FFFFFF'));const sm=t=>{t=t<0?0:t>1?1:t;return t*t*(3-2*t);};function rr(px,py,w,h,r){x.beginPath();x.moveTo(px+r,py);x.arcTo(px+w,py,px+w,py+h,r);x.arcTo(px+w,py+h,px,py+h,r);x.arcTo(px,py+h,px,py,r);x.arcTo(px,py,px+w,py,r);x.closePath();}function card(){x.fillStyle=SUR;rr(0.75,0.75,W-1.5,H-1.5,12);x.fill();x.strokeStyle=FNT;x.lineWidth=1;rr(0.75,0.75,W-1.5,H-1.5,12);x.stroke();}function lbl(t){x.fillStyle=MUT;x.font='600 10px monospace';x.textAlign='left';x.fillText(t,16,22);x.fillStyle=ACC;x.fillRect(16,28,14,2);}const TXT='Predice la palabra siguiente, una tras otra, hasta formar ideas completas.';let rev=false,rt=0;function frame(ts){const now=ts;const intro=rev?sm((now-rt)/500):0;x.clearRect(0,0,W,H);card();lbl('TEXTO');x.save();x.globalAlpha=intro;const per=rev?((now-rt)%5600):0;const nch=Math.max(0,Math.floor((per-300)/28));const shown=TXT.slice(0,Math.min(TXT.length,nch));x.fillStyle=INK;x.font='500 14px \"JetBrains Mono\",monospace';x.textAlign='left';const words=shown.split(' ');let line='',yy=H*0.34;const maxw=W*0.82,x0=W*0.09;for(const w of words){const t=line+(line?' ':'')+w;if(x.measureText(t).width>maxw){x.fillText(line,x0,yy);line=w;yy+=22;}else line=t;}x.fillText(line,x0,yy);if(nch<TXT.length&&Math.floor(now/400)%2){x.fillStyle=ACC;x.fillRect(x0+x.measureText(line).width+3,yy-12,7,15);}x.fillStyle=MUT;x.font='400 11px Poppins,sans-serif';x.fillText('> escribe · resume · traduce',W*0.09,H*0.88);x.restore();requestAnimationFrame(frame);}if(slidecode.mode==='edit'){rev=true;rt=-1e9;}slidecode.onReveal(function(){rev=true;rt=performance.now();});slidecode.onModeChange(function(m){if(m==='edit'){rev=true;rt=-1e9;}});requestAnimationFrame(frame);",
