{
  "sctemplate": "0.1",
  "meta": {
    "id": "slidecode-theme",
    "name": "SLIDECODE THEME",
    "author": "slidecode",
    "description": "El tema de la casa: mono-noir, ámbar y una retícula que se nota poco.",
    "version": "1.0.1"
  },
  "size": {
    "width": 1280,
    "height": 720
  },
  "theme": {
    "colors": {
      "canvas": "#000000",
      "ink": "#FFFFFF",
      "muted": "#A6A6A6",
      "tone-1": "#232323",
      "tone-2": "#101010"
    },
    "fonts": {
      "display": "'Space Grotesk', 'Poppins', 'Helvetica Neue', sans-serif",
      "body": "'Space Grotesk', 'Poppins', 'Helvetica Neue', sans-serif",
      "mono": "'JetBrains Mono', 'SF Mono', Menlo, monospace"
    },
    "fontFaces": [
      {
        "family": "Space Grotesk",
        "src": "data:font/woff2;base64,",
        "weight": "300 700"
      },
      {
        "family": "Newsreader",
        "src": "data:font/woff2;base64,",
        "weight": "400 600"
      },
      {
        "family": "Newsreader",
        "src": "data:font/woff2;base64,",
        "weight": "400 600",
        "style": "italic"
      }
    ],
    "textStyles": {
      "display": {
        "fontFamily": "$fonts.display",
        "fontSize": 74,
        "fontWeight": 800,
        "lineHeight": 1.04,
        "letterSpacing": -2,
        "color": "$colors.ink"
      },
      "h1": {
        "fontFamily": "$fonts.display",
        "fontSize": 140,
        "fontWeight": 800,
        "color": "$colors.ink"
      },
      "body": {
        "fontFamily": "$fonts.display",
        "fontSize": 21,
        "fontWeight": 400,
        "lineHeight": 1.55,
        "color": "$colors.muted"
      },
      "code": {
        "fontFamily": "$fonts.mono",
        "fontSize": 12,
        "fontWeight": 500,
        "color": "$colors.muted"
      },
      "wordmark": {
        "fontFamily": "$fonts.display",
        "fontSize": 150,
        "fontWeight": 800,
        "letterSpacing": -5,
        "color": "$colors.ink"
      },
      "wordmarkSm": {
        "fontFamily": "$fonts.display",
        "fontSize": 26,
        "fontWeight": 800,
        "letterSpacing": -0.5,
        "color": "$colors.ink"
      },
      "kicker": {
        "fontFamily": "$fonts.display",
        "fontSize": 13,
        "fontWeight": 700,
        "letterSpacing": 3,
        "color": "$colors.ink",
        "textTransform": "uppercase"
      },
      "displayLg": {
        "fontFamily": "$fonts.display",
        "fontSize": 96,
        "fontWeight": 800,
        "lineHeight": 1,
        "letterSpacing": -2.5,
        "color": "$colors.ink"
      },
      "h2": {
        "fontFamily": "$fonts.display",
        "fontSize": 46,
        "fontWeight": 700,
        "lineHeight": 1.08,
        "letterSpacing": -1,
        "color": "$colors.ink"
      },
      "bodyInk": {
        "fontFamily": "$fonts.display",
        "fontSize": 21,
        "fontWeight": 400,
        "lineHeight": 1.55,
        "color": "$colors.ink"
      },
      "label": {
        "fontFamily": "$fonts.mono",
        "fontSize": 12,
        "fontWeight": 500,
        "letterSpacing": 2,
        "color": "$colors.muted",
        "textTransform": "uppercase"
      }
    }
  },
  "layouts": [
