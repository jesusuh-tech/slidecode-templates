        "code": "\nconst renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });\nconst dpr = Math.min(devicePixelRatio || 1, 2);\nrenderer.setPixelRatio(dpr);\nrenderer.setSize(innerWidth, innerHeight);\ndocument.body.appendChild(renderer.domElement);\nconst scene = new THREE.Scene();\nconst camera = new THREE.PerspectiveCamera(50, innerWidth/innerHeight, 0.1, 100);\nconst SKIP = slidecode.mode === 'edit';\nconst expo = t => t>=1 ? 1 : 1 - Math.pow(2, -10*t);\nconst rnd = n => { const x = Math.sin(n*127.1)*43758.5453; return x - Math.floor(x); };\nfunction mkMat(size, op){ return new THREE.PointsMaterial({ color:0xffffff, size:size, sizeAttenuation:true, transparent:true, opacity:op, blending:THREE.AdditiveBlending, depthWrite:false }); }\naddEventListener('resize', ()=>{ camera.aspect=innerWidth/innerHeight; camera.updateProjectionMatrix(); renderer.setSize(innerWidth, innerHeight); });\n\ncamera.position.set(0, 0, 3.4);\nconst N=4200, pos=new Float32Array(N*3), R=1.25;\nconst gold=Math.PI*(3-Math.sqrt(5));\nfor(let a=0;a<N;a++){\n  const y=1-(a/(N-1))*2, r=Math.sqrt(1-y*y), th=a*gold;\n  pos[a*3]=Math.cos(th)*r*R; pos[a*3+1]=y*R; pos[a*3+2]=Math.sin(th)*r*R;\n}\nconst geo=new THREE.BufferGeometry();\ngeo.setAttribute('position', new THREE.BufferAttribute(pos,3));\nconst mat=mkMat(0.02, 0.0);\nconst ball=new THREE.Points(geo, mat); scene.add(ball);\nball.rotation.z=0.18;\nlet start=null;\nfunction frame(now){\n  if(start===null) start=now;\n  const t=(now-start)/1000;\n  const k=SKIP?1:expo(Math.min((now-start)/1400,1));\n  mat.opacity=0.9*k;\n  ball.scale.setScalar(0.55+0.45*k);\n  ball.rotation.y=t*0.32;\n  ball.rotation.x=Math.sin(t*0.18)*0.14;\n  renderer.render(scene, camera);\n  requestAnimationFrame(frame);\n}\nslidecode.onReveal(()=>requestAnimationFrame(frame));\n",
