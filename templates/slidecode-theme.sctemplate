                  "w": 230,
                  "h": 200
                },
                "type": "code-block",
                "code": "const __TC=(slidecode.theme&&slidecode.theme.colors)||{};\nconst ACCENT = (__TC.accent||(__TC.ink||'#FFFFFF'));\nconst ink = a => 'rgba(255,255,255,' + a + ')';\nconst c = document.createElement('canvas'); document.body.appendChild(c);\nconst ctx = c.getContext('2d');\nconst dpr = Math.min(devicePixelRatio || 1, 2);\nlet W, H;\nfunction size(){ W = innerWidth; H = innerHeight; c.width = W*dpr; c.height = H*dpr; c.style.width = W+'px'; c.style.height = H+'px'; ctx.setTransform(dpr,0,0,dpr,0,0); }\nsize(); addEventListener('resize', size);\nconst expo = t => t >= 1 ? 1 : 1 - Math.pow(2, -10*t);\nconst clamp01 = v => Math.min(Math.max(v, 0), 1);\nconst rnd = n => { const x = Math.sin(n*127.1)*43758.5453; return x - Math.floor(x); };\nconst MONO = 'ui-monospace, Menlo, monospace';\nconst HUBS = [\n  { n: 'MARKETING',  c: (__TC.ink||'#FFFFFF'), kids: ['SEO', 'PAID MEDIA', 'FUNNEL'],          brand: 'BYD' },\n  { n: 'CX',         c: (__TC.lilac||'#C4C4C4'), kids: ['JOURNEY', 'NPS', 'LOYALTY'],            brand: 'SPOTIFY' },\n  { n: 'ESTRATEGIA', c: (__TC.tangerine||'#8F8F8F'), kids: ['INSIGHTS', 'KPIS', 'POSICIONAM.'],      brand: 'FALABELLA' },\n  { n: 'BRANDING',   c: (__TC.ink||'#FFFFFF'), kids: ['IDENTIDAD', 'TONO DE VOZ', 'ARQUETIPO'],brand: 'NIKE' },\n  { n: 'DISEÑO',     c: (__TC.muted||'#A6A6A6'), kids: ['DESIGN SYSTEM', 'MOTION', 'UI KIT'],    brand: 'APPLE' }\n];\nconst INTRO = 1000, SIG_EVERY = 1700;\nconst SKIP = slidecode.mode === 'edit';\nconst pop = (t, at) => SKIP ? 1 : expo(clamp01((t - at)/480));\nconst AMB = Array.from({length: 70}, (_, i) => ({\n  a: rnd(i*3+1)*Math.PI*2, r: 0.30 + rnd(i*7+2)*0.70,\n  sp: 0.5 + rnd(i*11+3), ph: rnd(i*13+5)*6.28\n}));\nlet start = null;\nfunction draw(now){\n  if (start === null) start = now;\n  const t = now - start;\n  const run = Math.max(0, t - (SKIP ? 0 : INTRO));\n  ctx.clearRect(0,0,W,H);\n  const cx = W/2, cy = H/2 + 6;\n  const RX1 = W*0.19, RY1 = H*0.25, RX2 = W*0.315, RY2 = H*0.40, RX3 = W*0.40, RY3 = H*0.46;\n  const fl = (i, sp) => Math.sin(run/1400 + i*2.1)*sp;\n  const kC = pop(t, 150);\n  // anillos de órbita punteados (satélites)\n  ctx.setLineDash([2,6]);\n  ctx.strokeStyle = ink(0.09); ctx.lineWidth = 1;\n  ctx.globalAlpha = kC;\n  [[RX2+16, RY2+14], [RX3+22, RY3+18]].forEach(rr2 => {\n    ctx.beginPath(); ctx.ellipse(cx, cy, rr2[0], rr2[1], 0, 0, Math.PI*2); ctx.stroke();\n  });\n  ctx.setLineDash([]);\n  // ecosistema ambiente: nodos diminutos a la deriva + hilos tenues\n  const ambPos = AMB.map(m => ({\n    x: cx + Math.cos(m.a + run/22000*m.sp)*RX3*m.r*1.05,\n    y: cy + Math.sin(m.a + run/22000*m.sp)*RY3*m.r*1.05 + Math.sin(run/1600 + m.ph)*2\n  }));\n  for (let i = 0; i < AMB.length; i++){\n    const p1 = ambPos[i], p2 = ambPos[(i*7+11) % AMB.length];\n    const dx = p1.x-p2.x, dy = p1.y-p2.y;\n    if (dx*dx + dy*dy < 8100){\n      ctx.strokeStyle = ink(0.05); ctx.lineWidth = 0.8;\n      ctx.beginPath(); ctx.moveTo(p1.x, p1.y); ctx.lineTo(p2.x, p2.y); ctx.stroke();\n    }\n  }\n  AMB.forEach((m, i) => {\n    ctx.fillStyle = ink(0.10 + rnd(i*17+9)*0.14);\n    ctx.beginPath(); ctx.arc(ambPos[i].x, ambPos[i].y, 0.9 + rnd(i*19+4)*1.3, 0, Math.PI*2); ctx.fill();\n  });\n  ctx.globalAlpha = 1;\n  // posiciones\n  const pos = HUBS.map((h, i) => {\n    const a = -Math.PI/2 + i*Math.PI*2/5;\n    const hx = cx + Math.cos(a)*RX1 + fl(i, 2.5), hy = cy + Math.sin(a)*RY1 + fl(i+9, 2.5);\n    const kids = h.kids.map((kn, j) => {\n      const ka = a + (j-1)*0.40;\n      return { x: cx + Math.cos(ka)*RX2 + fl(i*3+j, 3), y: cy + Math.sin(ka)*RY2 + fl(i*5+j, 3),\n               k: pop(t, 720 + (i*3+j)*45), n: kn };\n    });\n    const ba = a - 0.30;\n    return { a, hx, hy, hk: pop(t, 300 + i*90), kids,\n             bx: cx + Math.cos(ba)*RX3 + fl(i+20, 2), by: cy + Math.sin(ba)*RY3 + fl(i+30, 2),\n             bk: pop(t, 1050 + i*70) };\n  });\n  // aristas\n  pos.forEach((p, i) => {\n    const h = HUBS[i];\n    const shim = e => 0.16 + 0.10*Math.sin(run/1700 + e*2.7);\n    ctx.strokeStyle = h.c; ctx.lineWidth = 1;\n    ctx.globalAlpha = Math.min(kC, p.hk)*shim(i);\n    ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(p.hx, p.hy); ctx.stroke();\n    p.kids.forEach((kp, j) => {\n      ctx.globalAlpha = Math.min(p.hk, kp.k)*shim(i*3+j+7);\n      ctx.beginPath(); ctx.moveTo(p.hx, p.hy); ctx.lineTo(kp.x, kp.y); ctx.stroke();\n    });\n    ctx.globalAlpha = Math.min(p.hk, p.bk)*(shim(i+40)+0.06);\n    ctx.setLineDash([3,4]);\n    ctx.beginPath(); ctx.moveTo(p.hx, p.hy); ctx.lineTo(p.bx, p.by); ctx.stroke();\n    ctx.setLineDash([]);\n    ctx.globalAlpha = 1;\n  });\n  // señales viajando (conocimiento propagándose)\n  if (run > 0){\n    for (const s of [0, 1]){\n      const nsg = Math.floor((run + s*850)/SIG_EVERY);\n      const ph = ((run + s*850) % SIG_EVERY)/SIG_EVERY;\n      const hi = Math.floor(rnd(nsg*13 + s*7 + 1)*5);\n      const ki = Math.floor(rnd(nsg*17 + s*3 + 2)*3);\n      const p = pos[hi], kp = p.kids[ki];\n      let x, y;\n      if (ph < 0.5){ const q = expo(ph/0.5); x = cx + (p.hx-cx)*q; y = cy + (p.hy-cy)*q; }\n      else { const q = expo((ph-0.5)/0.5); x = p.hx + (kp.x-p.hx)*q; y = p.hy + (kp.y-p.hy)*q; }\n      ctx.fillStyle = HUBS[hi].c;\n      for (let j = 0; j < 5; j++){\n        ctx.globalAlpha = (1-j/5)*0.9;\n        const bx2 = ph < 0.5 ? cx : p.hx, by2 = ph < 0.5 ? cy : p.hy;\n        const qq = Math.max(0, 1 - j*0.07);\n        ctx.beginPath(); ctx.arc(bx2 + (x-bx2)*qq, by2 + (y-by2)*qq, 2.6 - j*0.35, 0, Math.PI*2); ctx.fill();\n      }\n      ctx.globalAlpha = 1;\n    }\n  }\n  // etiqueta orientada hacia fuera\n  function label(txt, x, y, ang, font, col, alpha){\n    ctx.font = font; ctx.fillStyle = col; ctx.globalAlpha = alpha;\n    const cs = Math.cos(ang);\n    if (cs > 0.18){ ctx.textAlign = 'left'; ctx.fillText(txt, x+9, y+3); }\n    else if (cs < -0.18){ ctx.textAlign = 'right'; ctx.fillText(txt, x-9, y+3); }\n    else { ctx.textAlign = 'center'; ctx.fillText(txt, x, y + (Math.sin(ang) > 0 ? 16 : -10)); }\n    ctx.globalAlpha = 1;\n  }\n  // nodos\n  pos.forEach((p, i) => {\n    const h = HUBS[i];\n    p.kids.forEach((kp, j) => {\n      ctx.globalAlpha = kp.k*0.9; ctx.fillStyle = h.c;\n      ctx.beginPath(); ctx.arc(kp.x, kp.y, 3.2, 0, Math.PI*2); ctx.fill();\n      label(kp.n, kp.x, kp.y, Math.atan2(kp.y-cy, kp.x-cx), '600 8.5px ' + MONO, ink(0.55), kp.k);\n    });\n    ctx.globalAlpha = p.bk; ctx.strokeStyle = (__TC.ink||'#FFFFFF'); ctx.lineWidth = 1.6;\n    ctx.beginPath(); ctx.arc(p.bx, p.by, 4.6, 0, Math.PI*2); ctx.stroke();\n    label(h.brand, p.bx, p.by, Math.atan2(p.by-cy, p.bx-cx), '700 9.5px ' + MONO, (__TC.ink||'#FFFFFF'), p.bk);\n    const tw = 0.75 + 0.25*Math.sin(run/900 + i*1.7);\n    ctx.globalAlpha = p.hk; ctx.fillStyle = h.c;\n    ctx.beginPath(); ctx.arc(p.hx, p.hy, 6.5, 0, Math.PI*2); ctx.fill();\n    ctx.globalAlpha = p.hk*0.25*tw;\n    ctx.beginPath(); ctx.arc(p.hx, p.hy, 11, 0, Math.PI*2); ctx.fill();\n    label(h.n, p.hx, p.hy, Math.atan2(p.hy-cy, p.hx-cx), '700 10.5px ' + MONO, h.c, p.hk);\n    ctx.globalAlpha = 1;\n  });\n  // retícula de rastreo sobre el hub en foco\n  if (run > 0){\n    const tp = pos[Math.floor(run/2600) % 5];\n    const rk = expo(clamp01((run % 2600)/380));\n    const rr3 = 15 + 3*Math.sin(run/420);\n    ctx.strokeStyle = (__TC.ink||'#FFFFFF'); ctx.globalAlpha = 0.75*rk*tp.hk; ctx.lineWidth = 1.2;\n    ctx.beginPath(); ctx.arc(tp.hx, tp.hy, rr3, run/900, run/900 + Math.PI*1.5); ctx.stroke();\n    for (let q = 0; q < 4; q++){\n      const qa = q*Math.PI/2 + run/1400;\n      ctx.beginPath();\n      ctx.moveTo(tp.hx + Math.cos(qa)*(rr3+3), tp.hy + Math.sin(qa)*(rr3+3));\n      ctx.lineTo(tp.hx + Math.cos(qa)*(rr3+7), tp.hy + Math.sin(qa)*(rr3+7));\n      ctx.stroke();\n    }\n    ctx.globalAlpha = 1;\n  }\n  // centro BBK\n  ctx.globalAlpha = kC;\n  const cp = 1 + 0.05*Math.sin(run/600);\n  ctx.fillStyle = ACCENT;\n  ctx.beginPath(); ctx.arc(cx, cy, 12*cp, 0, Math.PI*2); ctx.fill();\n  ctx.fillStyle = (__TC.void||'#000000'); ctx.font = '800 8px ' + MONO; ctx.textAlign = 'center';\n  ctx.fillText('sc', cx, cy+3);\n  ctx.globalAlpha = 1;\n  requestAnimationFrame(draw);\n}\nslidecode.onReveal(() => requestAnimationFrame(draw));"
              }
            ]
          }
        ],
