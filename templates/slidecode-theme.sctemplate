        "code": "const __TC=(slidecode.theme&&slidecode.theme.colors)||{};\nconst c=document.createElement('canvas');document.body.appendChild(c);const x=c.getContext('2d');let W=0,H=0;const dpr=Math.min(devicePixelRatio||1,2);function S(){W=innerWidth;H=innerHeight;c.width=W*dpr;c.height=H*dpr;c.style.width=W+'px';c.style.height=H+'px';x.setTransform(dpr,0,0,dpr,0,0);}S();addEventListener('resize',S);const NAMES=['SOLICITUD','REVISIÓN','APROBACIÓN','PUBLICADO'];const N=4;const INK=(__TC.ink||'#FFFFFF'),MUT=(__TC.muted||'#A6A6A6'),FNT=(__TC.faint||'#232323'),SUR=(__TC.surface||'#101010'),ACC=(__TC.accent||(__TC.ink||'#FFFFFF'));const ease=t=>{t=t<0?0:t>1?1:t;return t*t*(3-2*t);};const AR=[];for(let i=0;i<N;i++)AR.push(700+i*950);const ST=AR.map(a=>a+380);const END=ST[N-1]+500;let started=false,t0=0;function cxAt(P,cx){const i=Math.floor(P);if(i>=N-1)return cx[N-1];const f=P-i;return cx[i]+(cx[i+1]-cx[i])*f;}function rr(px,py,w,h,r){x.beginPath();x.moveTo(px+r,py);x.arcTo(px+w,py,px+w,py+h,r);x.arcTo(px+w,py+h,px,py+h,r);x.arcTo(px,py+h,px,py,r);x.arcTo(px,py,px+w,py,r);x.closePath();}function check(cx,cy,s,col,a){x.save();x.globalAlpha=a;x.strokeStyle=col;x.lineWidth=2.4;x.lineCap='round';x.beginPath();x.moveTo(cx-s*0.5,cy);x.lineTo(cx-s*0.1,cy+s*0.45);x.lineTo(cx+s*0.6,cy-s*0.5);x.stroke();x.restore();}function frame(ts){x.clearRect(0,0,W,H);const padX=W*0.13,span=W-padX*2;const cx=[];for(let i=0;i<N;i++)cx.push(padX+span*(i/(N-1)));const ty=H*0.40;const R=24;let E=started?ts-t0:0;const idle=started&&E>=END;let P;if(idle){P=N-1;}else if(E<AR[0]){P=0;}else if(E>=AR[N-1]){P=N-1;}else{let seg=0;for(let i=0;i<N-1;i++){if(E<AR[i+1]){seg=i;break;}}const lp=ease((E-AR[seg])/(AR[seg+1]-AR[seg]));P=seg+lp;}const ap=[];for(let i=0;i<N;i++)ap.push(idle?1:ease((E-i*130)/400));x.lineWidth=2;for(let i=0;i<N-1;i++){const a=Math.min(ap[i],ap[i+1]);if(a<=0)continue;x.globalAlpha=a*0.9;x.strokeStyle=FNT;x.beginPath();x.moveTo(cx[i]+R,ty);x.lineTo(cx[i+1]-R,ty);x.stroke();}for(let i=0;i<N-1;i++){const fp=idle?1:Math.max(0,Math.min(1,P-i));if(fp<=0)continue;const x1=cx[i]+R,x2=cx[i+1]-R;x.globalAlpha=1;x.strokeStyle=ACC;x.lineWidth=2.5;x.beginPath();x.moveTo(x1,ty);x.lineTo(x1+(x2-x1)*fp,ty);x.stroke();}x.globalAlpha=1;for(let i=0;i<N;i++){if(ap[i]<=0)continue;const approved=idle||E>=ST[i];const reviewing=!idle&&E>=AR[i]&&E<ST[i];const r=R*(0.6+0.4*ap[i]);x.globalAlpha=ap[i];if(reviewing){const pu=0.5+0.5*Math.sin(ts*0.008);x.globalAlpha=ap[i]*(0.25+pu*0.35);x.strokeStyle=ACC;x.lineWidth=2;x.beginPath();x.arc(cx[i],ty,r+6+pu*5,0,7);x.stroke();x.globalAlpha=ap[i];}if(idle&&i===N-1){const br=0.5+0.5*Math.sin(ts*0.0035);x.globalAlpha=0.15+br*0.3;x.strokeStyle=ACC;x.lineWidth=2;x.beginPath();x.arc(cx[i],ty,r+7+br*6,0,7);x.stroke();x.globalAlpha=1;}x.globalAlpha=ap[i];x.fillStyle=SUR;x.beginPath();x.arc(cx[i],ty,r,0,7);x.fill();x.strokeStyle=approved?ACC:FNT;x.lineWidth=approved?2:1.5;x.beginPath();x.arc(cx[i],ty,r,0,7);x.stroke();if(approved){check(cx[i],ty,r*0.7,ACC,ap[i]);}else if(reviewing){x.fillStyle=ACC;x.beginPath();x.arc(cx[i],ty,3.5,0,7);x.fill();}else{x.fillStyle=MUT;x.beginPath();x.arc(cx[i],ty,3,0,7);x.fill();}x.fillStyle=approved?ACC:MUT;x.font='600 11px monospace';x.textAlign='center';x.fillText('0'+(i+1),cx[i],ty-r-14);x.fillStyle=approved?INK:MUT;x.font='600 12px monospace';x.fillText(NAMES[i],cx[i],ty+r+24);const stt=approved?'APROBADO':reviewing?'REVISANDO':'PENDIENTE';x.fillStyle=approved?ACC:reviewing?INK:FNT;x.font='500 9px monospace';x.fillText(stt,cx[i],ty+r+42);x.globalAlpha=1;}if((started&&E>=AR[0])||idle){const px=cxAt(P,cx);const py=idle?ty+Math.sin(ts*0.003)*3:ty;x.save();x.shadowColor='rgba(0,0,0,0.5)';x.shadowBlur=10;x.fillStyle=INK;rr(px-15,py-9,30,18,9);x.fill();x.restore();x.fillStyle=SUR;x.fillRect(px-7,py-3.5,14,2);x.fillRect(px-7,py+0.7,10,2);}if(idle){const gp=(ts*0.00011)%1;if(gp<0.9){const P2=Math.min(1,gp/0.85)*(N-1);const gx=cxAt(P2,cx);x.globalAlpha=0.45;x.fillStyle=INK;rr(gx-12,ty-7,24,14,7);x.fill();x.globalAlpha=1;}}requestAnimationFrame(frame);}if(slidecode.mode==='edit'){started=true;t0=-1e9;}slidecode.onReveal(function(){started=true;t0=performance.now();});slidecode.onModeChange(function(m){if(m==='edit'){started=true;t0=-1e9;}});requestAnimationFrame(frame);",
