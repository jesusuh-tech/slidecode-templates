                "code": "const __TC=(slidecode.theme&&slidecode.theme.colors)||{};\nconst ACCENT=(__TC.accent||(__TC.ink||'#FFFFFF'));const SKIP=slidecode.mode==='edit';const renderer=new THREE.WebGLRenderer({antialias:true,alpha:true});const dpr=Math.min(devicePixelRatio||1,2);renderer.setPixelRatio(dpr);renderer.setSize(innerWidth,innerHeight);document.body.appendChild(renderer.domElement);const scene=new THREE.Scene();const camera=new THREE.PerspectiveCamera(38,innerWidth/innerHeight,0.1,100);camera.position.set(0,0.3,7);const group=new THREE.Group();scene.add(group);const core=new THREE.Mesh(new THREE.SphereGeometry(1.55,96,96),new THREE.MeshStandardMaterial({color:0x181818,metalness:0.85,roughness:0.34}));group.add(core);const wire=new THREE.Mesh(new THREE.SphereGeometry(1.575,40,26),new THREE.MeshBasicMaterial({color:0xFFFFFF,wireframe:true,transparent:true,opacity:0.16}));group.add(wire);const key=new THREE.PointLight(new THREE.Color(ACCENT),360);key.position.set(4,3,4);scene.add(key);const rim=new THREE.PointLight(0xc4c4c4,170);rim.position.set(-5,-2,2);scene.add(rim);const top=new THREE.PointLight(0xffffff,60);top.position.set(0,6,-3);scene.add(top);scene.add(new THREE.HemisphereLight(0x2a2a2a,0x000000,1.6));scene.add(new THREE.AmbientLight(0x161616,2.4));addEventListener('resize',function(){camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight);});const expo=function(t){return t>=1?1:1-Math.pow(2,-10*t);};let start=null;function frame(now){if(start===null)start=now;const t=now-start;const k=SKIP?1:expo(Math.min(t/1300,1));group.scale.setScalar(0.55+0.45*k);group.position.y=(1-k)*-1.3+Math.sin(t/1700)*0.12;group.rotation.y=t/3800;group.rotation.x=Math.sin(t/5400)*0.16;key.intensity=360+Math.sin(t/950)*80;renderer.render(scene,camera);requestAnimationFrame(frame);}slidecode.onReveal(function(){requestAnimationFrame(frame);});",
