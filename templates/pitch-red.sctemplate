              {
                "id": "s3-chart",
                "name": "Gráfico animado — mercado",
                "frame": {
                  "x": 96,
                  "y": 560,
                  "w": 1180,
                  "h": 400
                },
                "type": "code-block",
                "code": "\n// Mercado: barras que crecen (fase 1) -> tendencia que se traza + cifras que\n// suben (fase 2) -> el hito se vuelve tinta oscura = proyección (fase 3).\n// Bucle idle: un barrido de luz recorre la grilla y el hito late.\nconst cv = document.createElement('canvas');\ndocument.body.appendChild(cv);\nconst g = cv.getContext('2d');\nconst dpr = Math.min(window.devicePixelRatio || 1, 2);\nlet W = 0, H = 0;\nfunction size() {\n  W = window.innerWidth; H = window.innerHeight;\n  cv.width = W * dpr; cv.height = H * dpr;\n  cv.style.width = W + 'px'; cv.style.height = H + 'px';\n  g.setTransform(dpr, 0, 0, dpr, 0, 0);\n}\nsize();\nwindow.addEventListener('resize', size);\n\nconst TC = (slidecode.theme && slidecode.theme.colors) || {};\nconst RED = TC.ink || '#B7241E';\nconst DARK = TC['tone-2'] || '#1E1512';\nconst FONT = 'ui-sans-serif, system-ui, \"Helvetica Neue\", Arial, sans-serif';\nconst DATA = [\n  { l: '2021', v: 31 }, { l: '2022', v: 38 }, { l: '2023', v: 49 },\n  { l: '2024', v: 61 }, { l: '2025', v: 82 }\n];\nconst MAX = 100;\n\nfunction rgb(hex) {\n  return [parseInt(hex.slice(1, 3), 16), parseInt(hex.slice(3, 5), 16), parseInt(hex.slice(5, 7), 16)];\n}\nfunction mix(a, b, k) {\n  const A = rgb(a), B = rgb(b);\n  return 'rgb(' + Math.round(A[0] + (B[0] - A[0]) * k) + ',' +\n    Math.round(A[1] + (B[1] - A[1]) * k) + ',' +\n    Math.round(A[2] + (B[2] - A[2]) * k) + ')';\n}\nconst RR = rgb(RED);\nconst soft = function (a) { return 'rgba(' + RR[0] + ',' + RR[1] + ',' + RR[2] + ',' + a + ')'; };\n\nconst clk = {};\nfunction mark(n, back) { if (clk[n] == null) clk[n] = performance.now() - (back || 0); }\nfunction pr(n, dur, delay) {\n  const s = clk[n];\n  if (s == null) return 0;\n  return Math.max(0, Math.min(1, (performance.now() - s - (delay || 0)) / dur));\n}\nfunction settle() { mark(1, 8000); mark(2, 8000); mark(3, 8000); }\nif (slidecode.mode === 'edit') settle();\nslidecode.onReveal(function () { mark(1); });\nslidecode.onStep(function (s) { if (s >= 1) mark(2); if (s >= 2) mark(3); });\nslidecode.onModeChange(function (m) { if (m === 'edit') settle(); });\n\nconst eo = function (v) { return v >= 1 ? 1 : 1 - Math.pow(2, -9 * v); };\nconst eio = function (v) { return v < 0.5 ? 2 * v * v : 1 - Math.pow(-2 * v + 2, 2) / 2; };\n\nfunction draw() {\n  const now = performance.now();\n  g.clearRect(0, 0, W, H);\n  const padT = 30, padB = 36;\n  const gh = H - padT - padB, base = padT + gh;\n  const bp = eo(pr(1, 700));\n  g.strokeStyle = soft(0.32); g.lineWidth = 2;\n  g.beginPath(); g.moveTo(0, base + 1); g.lineTo(W * bp, base + 1); g.stroke();\n\n  const n = DATA.length, slot = W / n, bw = Math.min(slot * 0.46, 104);\n  const p3 = eo(pr(3, 800));\n  const pts = [];\n  for (let i = 0; i < n; i++) {\n    const d = DATA[i];\n    const k = eo(Math.max(0, Math.min(1, pr(1, 900, 200 + i * 110))));\n    const hgt = (d.v / MAX) * gh * k;\n    const bx = slot * i + (slot - bw) / 2;\n    const hero = (i === n - 1);\n    g.fillStyle = hero ? mix(RED, DARK, p3) : RED;\n    g.fillRect(bx, base - hgt, bw, hgt);\n    pts.push({ x: bx + bw / 2, y: base - (d.v / MAX) * gh });\n    g.globalAlpha = k;\n    g.fillStyle = soft(0.85);\n    g.font = '700 15px ' + FONT;\n    g.textAlign = 'center';\n    g.fillText(d.l, bx + bw / 2, base + 24);\n    const pv = pr(2, 700, i * 70);\n    if (pv > 0) {\n      g.globalAlpha = eo(pv) * k;\n      g.fillStyle = hero ? mix(RED, DARK, p3) : RED;\n      g.font = '800 22px ' + FONT;\n      g.fillText(String(Math.round(d.v * eo(pv))), bx + bw / 2, base - hgt - 14);\n    }\n    g.globalAlpha = 1;\n  }\n\n  const p2 = eio(pr(2, 1200, 140));\n  if (p2 > 0) {\n    g.strokeStyle = DARK; g.lineWidth = 2.5; g.globalAlpha = 0.92;\n    g.beginPath(); g.moveTo(pts[0].x, pts[0].y);\n    const walk = (pts.length - 1) * p2;\n    for (let i = 1; i < pts.length; i++) {\n      const f = Math.max(0, Math.min(1, walk - (i - 1)));\n      if (f <= 0) break;\n      g.lineTo(pts[i - 1].x + (pts[i].x - pts[i - 1].x) * f,\n        pts[i - 1].y + (pts[i].y - pts[i - 1].y) * f);\n      if (f < 1) break;\n    }\n    g.stroke(); g.globalAlpha = 1;\n  }\n\n  if (bp > 0.99) {\n    const sx = W * eio((now / 5400) % 1);\n    const grad = g.createLinearGradient(sx - 46, 0, sx + 46, 0);\n    grad.addColorStop(0, soft(0));\n    grad.addColorStop(0.5, soft(0.14));\n    grad.addColorStop(1, soft(0));\n    g.fillStyle = grad;\n    g.fillRect(sx - 46, padT, 92, gh);\n  }\n  if (p3 > 0.5) {\n    const last = pts[pts.length - 1];\n    const puls = 0.5 + 0.5 * Math.sin(now / 720);\n    g.beginPath(); g.arc(last.x, last.y, 5 + puls * 5, 0, Math.PI * 2);\n    g.fillStyle = 'rgba(30,21,18,' + (0.10 + 0.20 * (1 - puls)) + ')';\n    g.fill();\n    g.beginPath(); g.arc(last.x, last.y, 4.5, 0, Math.PI * 2);\n    g.fillStyle = DARK; g.fill();\n  }\n  requestAnimationFrame(draw);\n}\nrequestAnimationFrame(draw);\n",
                "css": "html,body{margin:0;height:100%;overflow:hidden;background:transparent}canvas{display:block}",
