    {
      "id": "s3-chart",
      "name": "Gráfico animado — mercado",
      "node": {
        "id": "s3-chart",
        "name": "Gráfico animado — mercado",
        "frame": {
          "x": 96,
          "y": 560,
          "w": 1180,
          "h": 400
        },
        "type": "code-block",
        "code": "\n// Mercado: barras que crecen (fase 1) -> tendencia que se traza + cifras que\n// suben (fase 2) -> el hito se vuelve tinta oscura = proyección (fase 3).\n// Bucle idle: un barrido de luz recorre la grilla y el hito late.\nconst cv = document.createElement('canvas');\ndocument.body.appendChild(cv);\nconst g = cv.getContext('2d');\nconst dpr = Math.min(window.devicePixelRatio || 1, 2);\nlet W = 0, H = 0;\nfunction size() {\n  W = window.innerWidth; H = window.innerHeight;\n  cv.width = W * dpr; cv.height = H * dpr;\n  cv.style.width = W + 'px'; cv.style.height = H + 'px';\n  g.setTransform(dpr, 0, 0, dpr, 0, 0);\n}\nsize();\nwindow.addEventListener('resize', size);\n\nconst TC = (slidecode.theme && slidecode.theme.colors) || {};\nconst RED = TC.ink || '#B7241E';\nconst DARK = TC['tone-2'] || '#1E1512';\nconst FONT = 'ui-sans-serif, system-ui, \"Helvetica Neue\", Arial, sans-serif';\nconst DATA = [\n  { l: '2021', v: 31 }, { l: '2022', v: 38 }, { l: '2023', v: 49 },\n  { l: '2024', v: 61 }, { l: '2025', v: 82 }\n];\nconst MAX = 100;\n\nfunction rgb(hex) {\n  return [parseInt(hex.slice(1, 3), 16), parseInt(hex.slice(3, 5), 16), parseInt(hex.slice(5, 7), 16)];\n}\nfunction mix(a, b, k) {\n  const A = rgb(a), B = rgb(b);\n  return 'rgb(' + Math.round(A[0] + (B[0] - A[0]) * k) + ',' +\n    Math.round(A[1] + (B[1] - A[1]) * k) + ',' +\n    Math.round(A[2] + (B[2] - A[2]) * k) + ')';\n}\nconst RR = rgb(RED);\nconst soft = function (a) { return 'rgba(' + RR[0] + ',' + RR[1] + ',' + RR[2] + ',' + a + ')'; };\n\nconst clk = {};\nfunction mark(n, back) { if (clk[n] == null) clk[n] = performance.now() - (back || 0); }\nfunction pr(n, dur, delay) {\n  const s = clk[n];\n  if (s == null) return 0;\n  return Math.max(0, Math.min(1, (performance.now() - s - (delay || 0)) / dur));\n}\nfunction settle() { mark(1, 8000); mark(2, 8000); mark(3, 8000); }\nif (slidecode.mode === 'edit') settle();\nslidecode.onReveal(function () { mark(1); });\nslidecode.onStep(function (s) { if (s >= 1) mark(2); if (s >= 2) mark(3); });\nslidecode.onModeChange(function (m) { if (m === 'edit') settle(); });\n\nconst eo = function (v) { return v >= 1 ? 1 : 1 - Math.pow(2, -9 * v); };\nconst eio = function (v) { return v < 0.5 ? 2 * v * v : 1 - Math.pow(-2 * v + 2, 2) / 2; };\n\nfunction draw() {\n  const now = performance.now();\n  g.clearRect(0, 0, W, H);\n  const padT = 30, padB = 36;\n  const gh = H - padT - padB, base = padT + gh;\n  const bp = eo(pr(1, 700));\n  g.strokeStyle = soft(0.32); g.lineWidth = 2;\n  g.beginPath(); g.moveTo(0, base + 1); g.lineTo(W * bp, base + 1); g.stroke();\n\n  const n = DATA.length, slot = W / n, bw = Math.min(slot * 0.46, 104);\n  const p3 = eo(pr(3, 800));\n  const pts = [];\n  for (let i = 0; i < n; i++) {\n    const d = DATA[i];\n    const k = eo(Math.max(0, Math.min(1, pr(1, 900, 200 + i * 110))));\n    const hgt = (d.v / MAX) * gh * k;\n    const bx = slot * i + (slot - bw) / 2;\n    const hero = (i === n - 1);\n    g.fillStyle = hero ? mix(RED, DARK, p3) : RED;\n    g.fillRect(bx, base - hgt, bw, hgt);\n    pts.push({ x: bx + bw / 2, y: base - (d.v / MAX) * gh });\n    g.globalAlpha = k;\n    g.fillStyle = soft(0.85);\n    g.font = '700 15px ' + FONT;\n    g.textAlign = 'center';\n    g.fillText(d.l, bx + bw / 2, base + 24);\n    const pv = pr(2, 700, i * 70);\n    if (pv > 0) {\n      g.globalAlpha = eo(pv) * k;\n      g.fillStyle = hero ? mix(RED, DARK, p3) : RED;\n      g.font = '800 22px ' + FONT;\n      g.fillText(String(Math.round(d.v * eo(pv))), bx + bw / 2, base - hgt - 14);\n    }\n    g.globalAlpha = 1;\n  }\n\n  const p2 = eio(pr(2, 1200, 140));\n  if (p2 > 0) {\n    g.strokeStyle = DARK; g.lineWidth = 2.5; g.globalAlpha = 0.92;\n    g.beginPath(); g.moveTo(pts[0].x, pts[0].y);\n    const walk = (pts.length - 1) * p2;\n    for (let i = 1; i < pts.length; i++) {\n      const f = Math.max(0, Math.min(1, walk - (i - 1)));\n      if (f <= 0) break;\n      g.lineTo(pts[i - 1].x + (pts[i].x - pts[i - 1].x) * f,\n        pts[i - 1].y + (pts[i].y - pts[i - 1].y) * f);\n      if (f < 1) break;\n    }\n    g.stroke(); g.globalAlpha = 1;\n  }\n\n  if (bp > 0.99) {\n    const sx = W * eio((now / 5400) % 1);\n    const grad = g.createLinearGradient(sx - 46, 0, sx + 46, 0);\n    grad.addColorStop(0, soft(0));\n    grad.addColorStop(0.5, soft(0.14));\n    grad.addColorStop(1, soft(0));\n    g.fillStyle = grad;\n    g.fillRect(sx - 46, padT, 92, gh);\n  }\n  if (p3 > 0.5) {\n    const last = pts[pts.length - 1];\n    const puls = 0.5 + 0.5 * Math.sin(now / 720);\n    g.beginPath(); g.arc(last.x, last.y, 5 + puls * 5, 0, Math.PI * 2);\n    g.fillStyle = 'rgba(30,21,18,' + (0.10 + 0.20 * (1 - puls)) + ')';\n    g.fill();\n    g.beginPath(); g.arc(last.x, last.y, 4.5, 0, Math.PI * 2);\n    g.fillStyle = DARK; g.fill();\n  }\n  requestAnimationFrame(draw);\n}\nrequestAnimationFrame(draw);\n",
        "css": "html,body{margin:0;height:100%;overflow:hidden;background:transparent}canvas{display:block}",
        "stepCount": 2
      }
    },
    {
      "id": "s6-proc",
      "name": "Proceso animado — 4 etapas",
      "node": {
        "id": "s6-proc",
        "name": "Proceso animado — 4 etapas",
        "frame": {
          "x": 96,
          "y": 560,
          "w": 1728,
          "h": 400
        },
        "type": "code-block",
        "code": "\n// Proceso: la línea avanza etapa por etapa (click), cada estación aterriza con\n// peso. Bucle idle: un punto recorre el tramo ya trazado y hace destellar la\n// estación por la que pasa — el movimiento ES la metáfora del método.\nconst cv = document.createElement('canvas');\ndocument.body.appendChild(cv);\nconst g = cv.getContext('2d');\nconst dpr = Math.min(window.devicePixelRatio || 1, 2);\nlet W = 0, H = 0;\nfunction size() {\n  W = window.innerWidth; H = window.innerHeight;\n  cv.width = W * dpr; cv.height = H * dpr;\n  cv.style.width = W + 'px'; cv.style.height = H + 'px';\n  g.setTransform(dpr, 0, 0, dpr, 0, 0);\n}\nsize();\nwindow.addEventListener('resize', size);\n\nconst TC = (slidecode.theme && slidecode.theme.colors) || {};\nconst RED = TC.ink || '#B7241E';\nconst DARK = TC['tone-2'] || '#1E1512';\nconst FONT = 'ui-sans-serif, system-ui, \"Helvetica Neue\", Arial, sans-serif';\nfunction rgb(h) { return [parseInt(h.slice(1, 3), 16), parseInt(h.slice(3, 5), 16), parseInt(h.slice(5, 7), 16)]; }\nconst RR = rgb(RED);\nconst soft = function (a) { return 'rgba(' + RR[0] + ',' + RR[1] + ',' + RR[2] + ',' + a + ')'; };\n\nconst ST = [\n  { n: '01', t: 'DIAGNÓSTICO', d: 'Datos, entrevistas\\ny territorio' },\n  { n: '02', t: 'ESTRATEGIA', d: 'Posición, promesa\\ny arquitectura' },\n  { n: '03', t: 'EJECUCIÓN', d: 'Piezas, canales\\ny ritmo' },\n  { n: '04', t: 'ESCALA', d: 'Medición y\\noptimización' }\n];\n\nconst clk = {};\nfunction mark(n, back) { if (clk[n] == null) clk[n] = performance.now() - (back || 0); }\nfunction pr(n, dur, delay) {\n  const s = clk[n];\n  if (s == null) return 0;\n  return Math.max(0, Math.min(1, (performance.now() - s - (delay || 0)) / dur));\n}\nfunction settle() { for (let i = 0; i < ST.length; i++) mark(i, 9000); }\nif (slidecode.mode === 'edit') settle();\nslidecode.onReveal(function () { mark(0); });\nslidecode.onStep(function (s) { for (let i = 1; i <= s && i < ST.length; i++) mark(i); });\nslidecode.onModeChange(function (m) { if (m === 'edit') settle(); });\n\nconst eo = function (v) { return v >= 1 ? 1 : 1 - Math.pow(2, -9 * v); };\n\nfunction draw() {\n  const now = performance.now();\n  g.clearRect(0, 0, W, H);\n  const padL = 26, padR = 40;\n  const y = 74;\n  const span = W - padL - padR;\n  const gap = span / (ST.length - 1);\n  const xs = ST.map(function (_, i) { return padL + gap * i; });\n\n  // progreso de la línea\n  let reach = xs[0], lit = 0;\n  for (let i = 1; i < ST.length; i++) {\n    const p = eo(pr(i, 950));\n    if (p <= 0) break;\n    reach = xs[i - 1] + (xs[i] - xs[i - 1]) * p;\n    if (p > 0.35) lit = i;\n  }\n  const born = pr(0, 500) > 0;\n  if (!born) { requestAnimationFrame(draw); return; }\n\n  // riel tenue completo + línea viva\n  g.strokeStyle = soft(0.16); g.lineWidth = 2;\n  g.beginPath(); g.moveTo(xs[0], y); g.lineTo(xs[ST.length - 1], y); g.stroke();\n  g.strokeStyle = RED; g.lineWidth = 3;\n  g.beginPath(); g.moveTo(xs[0], y); g.lineTo(reach, y); g.stroke();\n\n  // punto viajero (idle) sobre el tramo ya trazado\n  const trav = xs[0] + (reach - xs[0]) * ((now / 4200) % 1);\n\n  for (let i = 0; i < ST.length; i++) {\n    const k = eo(pr(i, 800));\n    if (k <= 0) continue;\n    const near = Math.max(0, 1 - Math.abs(trav - xs[i]) / 90);\n    const s = 11 + near * 6;\n    g.save();\n    g.globalAlpha = k;\n    g.translate(xs[i], y);\n    // halo de paso\n    if (near > 0.02) {\n      g.beginPath(); g.arc(0, 0, s + 14 * near, 0, Math.PI * 2);\n      g.fillStyle = soft(0.10 * near); g.fill();\n    }\n    g.fillStyle = (i === ST.length - 1) ? DARK : RED;\n    g.fillRect(-s / 2, -s / 2, s, s);\n    // número sobre la estación\n    g.fillStyle = soft(0.9);\n    g.font = '700 14px ' + FONT;\n    g.textAlign = 'left';\n    g.fillText(ST[i].n, 0, -26);\n    // título + bajada\n    g.globalAlpha = k;\n    g.fillStyle = (i === ST.length - 1) ? DARK : RED;\n    g.font = '800 27px ' + FONT;\n    g.fillText(ST[i].t, 0, 62 + (1 - k) * 14);\n    g.fillStyle = soft(0.72);\n    g.font = '400 18px ' + FONT;\n    const ls = ST[i].d.split('\\n');\n    for (let j = 0; j < ls.length; j++) g.fillText(ls[j], 0, 96 + j * 25 + (1 - k) * 14);\n    g.restore();\n  }\n\n  if (reach > xs[0] + 4) {\n    g.beginPath(); g.arc(trav, y, 4.5, 0, Math.PI * 2);\n    g.fillStyle = DARK; g.fill();\n  }\n  requestAnimationFrame(draw);\n}\nrequestAnimationFrame(draw);\n",
        "css": "html,body{margin:0;height:100%;overflow:hidden;background:transparent}canvas{display:block}",
        "stepCount": 3
      }
    },
    {
      "id": "s9-stats",
      "name": "Cifras que suben",
      "node": {
        "id": "s9-stats",
        "name": "Cifras que suben",
        "frame": {
          "x": 96,
          "y": 560,
          "w": 1180,
          "h": 420
        },
        "type": "code-block",
        "code": "\n// Resultados: las cifras suben al revelarse (una tras otra, con peso) y cada\n// filete queda vivo — un cursor rojo lo recorre en bucle mientras se habla.\nconst TC = (slidecode.theme && slidecode.theme.colors) || {};\nconst RED = TC.ink || '#B7241E';\nconst MUTED = TC.muted || '#93463D';\ndocument.documentElement.style.setProperty('--red', RED);\ndocument.documentElement.style.setProperty('--muted', MUTED);\ndocument.documentElement.style.setProperty('--hair', TC.hairline || 'rgba(183,36,30,0.28)');\n\nconst STATS = [\n  { to: 240, pre: '+', post: '%', dec: 0, lab: 'Crecimiento en\\nalcance calificado', sub: 'Promedio de 12 cuentas' },\n  { to: 3.4, pre: '×', post: '', dec: 1, lab: 'Retorno sobre\\ninversión de medios', sub: 'Medido a 6 meses' },\n  { to: 18, pre: '', post: ' d', dec: 0, lab: 'De brief a\\nprimera pieza', sub: 'Mediana del último año' }\n];\n\nconst row = document.createElement('div');\nrow.className = 'row';\ndocument.body.appendChild(row);\nconst cells = STATS.map(function (s) {\n  const c = document.createElement('div');\n  c.className = 'cell';\n  const big = document.createElement('div');\n  big.className = 'big';\n  big.textContent = s.pre + '0' + s.post;\n  const rl = document.createElement('div');\n  rl.className = 'rule';\n  const run = document.createElement('div');\n  run.className = 'run';\n  rl.appendChild(run);\n  const lab = document.createElement('div');\n  lab.className = 'lab';\n  lab.textContent = s.lab;\n  lab.style.whiteSpace = 'pre-line';\n  const sub = document.createElement('div');\n  sub.className = 'sub';\n  sub.textContent = s.sub;\n  c.appendChild(big); c.appendChild(rl); c.appendChild(lab); c.appendChild(sub);\n  row.appendChild(c);\n  return { big: big, run: run, rule: rl, wrap: c, s: s };\n});\n\nlet t0 = null;\nfunction begin() { if (t0 === null) t0 = performance.now(); }\nfunction settle() { t0 = performance.now() - 6000; }\nif (slidecode.mode === 'edit') settle();\nslidecode.onReveal(begin);\nslidecode.onModeChange(function (m) { if (m === 'edit') settle(); });\n\nconst eo = function (v) { return v >= 1 ? 1 : 1 - Math.pow(2, -10 * v); };\nfunction loop(now) {\n  const el = t0 === null ? 0 : (now - t0) / 1000;\n  for (let i = 0; i < cells.length; i++) {\n    const c = cells[i], s = c.s;\n    const k = eo(Math.max(0, Math.min(1, (el - i * 0.22) / 1.5)));\n    const v = s.to * k;\n    c.big.textContent = s.pre + (s.dec ? v.toFixed(s.dec) : String(Math.round(v))) + s.post;\n    c.wrap.style.opacity = String(Math.min(1, k * 1.6));\n    c.wrap.style.transform = 'translateY(' + ((1 - k) * 18).toFixed(2) + 'px)';\n    c.rule.style.transform = 'scaleX(' + k.toFixed(3) + ')';\n    c.rule.style.transformOrigin = 'left';\n    if (k > 0.98) {\n      const w = c.rule.clientWidth || 300;\n      const ph = ((now / 3400 + i * 0.22) % 1);\n      c.run.style.transform = 'translateX(' + (-64 + (w + 64) * ph) + 'px)';\n    }\n  }\n  requestAnimationFrame(loop);\n}\nrequestAnimationFrame(loop);\n",
        "css": "@font-face{font-family:'ArchivoEmb';src:url(data:font/woff2;base64,) format('woff2');font-weight:100 900;font-display:block}html,body{margin:0;height:100%;overflow:hidden;background:transparent}.row{display:flex;height:100%;align-items:flex-start}.cell{flex:1;position:relative;padding-right:48px}.big{font:800 132px/0.86 'ArchivoEmb',ui-sans-serif,sans-serif;letter-spacing:-5px;color:var(--red);white-space:nowrap}.rule{position:relative;height:2px;background:var(--hair);margin:22px 0 16px;overflow:hidden}.run{position:absolute;top:0;left:0;width:64px;height:2px;background:var(--red);transform:translateX(-64px)}.lab{font:700 15px/1.45 'ArchivoEmb',ui-sans-serif,sans-serif;letter-spacing:1px;text-transform:uppercase;color:var(--red)}.sub{font:400 18px/1.45 ui-sans-serif,system-ui,sans-serif;color:var(--muted);margin-top:8px}"
      }
    },
    {
      "id": "s11-3d",
      "name": "Hero 3D — cierre",
      "node": {
        "id": "s11-3d",
        "name": "Hero 3D — cierre",
        "frame": {
          "x": 1300,
          "y": 120,
          "w": 620,
          "h": 460
        },
        "type": "code-block",
        "code": "\n// HERO 3D — \"pila de líneas extruídas\": la forma sale del gesto de la marca,\n// el bloque tipográfico de líneas macizas apiladas y alineadas a la izquierda.\n// Radios 0 del sistema -> aristas duras (BoxGeometry, sin bisel).\n// Material mate/cerámico (no metal cromado): editorial, cálido, lee caro.\nconst T = THREE;\nconst TC = (slidecode.theme && slidecode.theme.colors) || {};\nconst P = slidecode.props || {};\nconst RED = TC.ink || '#B7241E';\nconst CREAM = TC.canvas || '#EDEBE2';\nconst DARK = TC['tone-2'] || '#1E1512';\nconst ASC = P.orden === 'asc';\nconst NEAR = P.acercar === true;\n\nconst scene = new T.Scene();\nconst cam = new T.PerspectiveCamera(34, 1, 0.1, 100);\ncam.position.set(0, 0, NEAR ? 8.4 : 9.6);\nconst rnd = new T.WebGLRenderer({ alpha: true, antialias: true });\nrnd.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));\ndocument.body.appendChild(rnd.domElement);\nfunction resize() {\n  const w = window.innerWidth, h = window.innerHeight;\n  rnd.setSize(w, h);\n  cam.aspect = w / h;\n  cam.updateProjectionMatrix();\n}\nresize();\nwindow.addEventListener('resize', resize);\n\nscene.add(new T.AmbientLight(new T.Color(CREAM), 0.74));\nconst key = new T.DirectionalLight(0xffffff, 1.18);\nkey.position.set(3.4, 4.6, 4.2); scene.add(key);\nconst fill = new T.DirectionalLight(new T.Color(RED), 0.55);\nfill.position.set(-4.2, -2.4, 2.0); scene.add(fill);\nconst rim = new T.DirectionalLight(0xffffff, 0.42);\nrim.position.set(-2.2, 1.4, -4.2); scene.add(rim);\n\nlet LINES = [4.6, 3.05, 5.25, 2.25, 4.0, 1.45];\nif (ASC) LINES = LINES.slice().reverse();\nconst HH = 0.6, D = 0.54, GAP = 0.2;\nconst total = LINES.length * (HH + GAP) - GAP;\nconst grp = new T.Group();\nscene.add(grp);\nconst slabs = LINES.map(function (w, i) {\n  const hero = ASC ? (i === LINES.length - 3) : (i === 2);\n  const mat = new T.MeshStandardMaterial({\n    color: new T.Color(hero ? DARK : RED),\n    metalness: hero ? 0.3 : 0.02,\n    roughness: hero ? 0.42 : 0.74,\n    transparent: true,\n    opacity: 0\n  });\n  const m = new T.Mesh(new T.BoxGeometry(w, HH, D), mat);\n  m.userData.x = -2.55 + w / 2;\n  m.userData.y = total / 2 - i * (HH + GAP) - HH / 2;\n  m.position.set(m.userData.x, m.userData.y, 0);\n  grp.add(m);\n  return m;\n});\n\nlet t0 = null;\nfunction begin() { if (t0 === null) t0 = performance.now(); }\nfunction settle() { t0 = performance.now() - 5000; }\nif (slidecode.mode === 'edit') settle();\nslidecode.onReveal(begin);\nslidecode.onModeChange(function (m) { if (m === 'edit') settle(); });\n\nlet pt = { x: 0.5, y: 0.5, on: false };\nif (slidecode.onPointer) {\n  slidecode.onPointer(function (p) {\n    if (p && p.inside) { pt = { x: p.x, y: p.y, on: true }; } else { pt.on = false; }\n  });\n}\n\nconst eo = function (v) { return v >= 1 ? 1 : 1 - Math.pow(2, -9 * v); };\nlet ry = 0, rx = 0;\nfunction frame(now) {\n  const s = now / 1000;\n  const el = t0 === null ? 0 : (now - t0) / 1000;\n  for (let i = 0; i < slabs.length; i++) {\n    const m = slabs[i];\n    const k = eo(Math.max(0, Math.min(1, (el - i * 0.09) / 1.1)));\n    m.material.opacity = k;\n    m.position.x = m.userData.x + (1 - k) * 7.6;\n    m.position.z = 0.18 * Math.sin(s / 2.3 + i * 0.72) * k;\n    m.rotation.z = (1 - k) * -0.14;\n  }\n  const ty = (ASC ? -0.34 : -0.5) + 0.3 * Math.sin(s / 3.6) + (pt.on ? (pt.x - 0.5) * 0.5 : 0);\n  const tx = 0.1 * Math.sin(s / 5.3) + (pt.on ? (pt.y - 0.5) * 0.28 : 0);\n  ry += (ty - ry) * 0.05;\n  rx += (tx - rx) * 0.05;\n  grp.rotation.y = ry;\n  grp.rotation.x = rx;\n  grp.rotation.z = -0.025;\n  grp.position.z = NEAR ? -1.2 + 1.2 * eo(Math.min(1, el / 2.6)) : 0;\n  rnd.render(scene, cam);\n  requestAnimationFrame(frame);\n}\nrequestAnimationFrame(frame);\n",
        "css": "html,body{margin:0;height:100%;overflow:hidden;background:transparent}canvas{display:block}",
        "props": {
          "orden": "asc",
          "acercar": true
        },
        "libs": [
          "three"
        ]
      }
    }
  ],
  "specimen": "cover"
}
