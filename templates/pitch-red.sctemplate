                  "h": 560
                },
                "type": "image",
                "src": "https://mcp.slidecode.app/catalogo/asset/1e61ac0d51ac11223be6e90a1aa001480877bdebd9f7b3cc16207288521a8e36.jpg",
                "fit": "cover"
              },
              {
                "id": "hero-word",
                "frame": {
                  "x": 90,
                  "y": 150,
                  "w": 1740,
