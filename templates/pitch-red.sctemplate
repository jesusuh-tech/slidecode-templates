                "styleRef": "$textStyles.display"
              },
              {
                "id": "s1-3d",
                "name": "Hero 3D — pila de líneas",
                "frame": {
                  "x": 1300,
                  "y": 60,
                  "w": 620,
                  "h": 450
                },
                "type": "code-block",
                "code": "\n// HERO 3D — \"pila de líneas extruídas\": la forma sale del gesto de la marca,\n// el bloque tipográfico de líneas macizas apiladas y alineadas a la izquierda.\n// Radios 0 del sistema -> aristas duras (BoxGeometry, sin bisel).\n// Material mate/cerámico (no metal cromado): editorial, cálido, lee caro.\nconst T = THREE;\nconst TC = (slidecode.theme && slidecode.theme.colors) || {};\nconst P = slidecode.props || {};\nconst RED = TC.ink || '#B7241E';\nconst CREAM = TC.canvas || '#EDEBE2';\nconst DARK = TC['tone-2'] || '#1E1512';\nconst ASC = P.orden === 'asc';\nconst NEAR = P.acercar === true;\n\nconst scene = new T.Scene();\nconst cam = new T.PerspectiveCamera(34, 1, 0.1, 100);\ncam.position.set(0, 0, NEAR ? 8.4 : 9.6);\nconst rnd = new T.WebGLRenderer({ alpha: true, antialias: true });\nrnd.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));\ndocument.body.appendChild(rnd.domElement);\nfunction resize() {\n  const w = window.innerWidth, h = window.innerHeight;\n  rnd.setSize(w, h);\n  cam.aspect = w / h;\n  cam.updateProjectionMatrix();\n}\nresize();\nwindow.addEventListener('resize', resize);\n\nscene.add(new T.AmbientLight(new T.Color(CREAM), 0.74));\nconst key = new T.DirectionalLight(0xffffff, 1.18);\nkey.position.set(3.4, 4.6, 4.2); scene.add(key);\nconst fill = new T.DirectionalLight(new T.Color(RED), 0.55);\nfill.position.set(-4.2, -2.4, 2.0); scene.add(fill);\nconst rim = new T.DirectionalLight(0xffffff, 0.42);\nrim.position.set(-2.2, 1.4, -4.2); scene.add(rim);\n\nlet LINES = [4.6, 3.05, 5.25, 2.25, 4.0, 1.45];\nif (ASC) LINES = LINES.slice().reverse();\nconst HH = 0.6, D = 0.54, GAP = 0.2;\nconst total = LINES.length * (HH + GAP) - GAP;\nconst grp = new T.Group();\nscene.add(grp);\nconst slabs = LINES.map(function (w, i) {\n  const hero = ASC ? (i === LINES.length - 3) : (i === 2);\n  const mat = new T.MeshStandardMaterial({\n    color: new T.Color(hero ? DARK : RED),\n    metalness: hero ? 0.3 : 0.02,\n    roughness: hero ? 0.42 : 0.74,\n    transparent: true,\n    opacity: 0\n  });\n  const m = new T.Mesh(new T.BoxGeometry(w, HH, D), mat);\n  m.userData.x = -2.55 + w / 2;\n  m.userData.y = total / 2 - i * (HH + GAP) - HH / 2;\n  m.position.set(m.userData.x, m.userData.y, 0);\n  grp.add(m);\n  return m;\n});\n\nlet t0 = null;\nfunction begin() { if (t0 === null) t0 = performance.now(); }\nfunction settle() { t0 = performance.now() - 5000; }\nif (slidecode.mode === 'edit') settle();\nslidecode.onReveal(begin);\nslidecode.onModeChange(function (m) { if (m === 'edit') settle(); });\n\nlet pt = { x: 0.5, y: 0.5, on: false };\nif (slidecode.onPointer) {\n  slidecode.onPointer(function (p) {\n    if (p && p.inside) { pt = { x: p.x, y: p.y, on: true }; } else { pt.on = false; }\n  });\n}\n\nconst eo = function (v) { return v >= 1 ? 1 : 1 - Math.pow(2, -9 * v); };\nlet ry = 0, rx = 0;\nfunction frame(now) {\n  const s = now / 1000;\n  const el = t0 === null ? 0 : (now - t0) / 1000;\n  for (let i = 0; i < slabs.length; i++) {\n    const m = slabs[i];\n    const k = eo(Math.max(0, Math.min(1, (el - i * 0.09) / 1.1)));\n    m.material.opacity = k;\n    m.position.x = m.userData.x + (1 - k) * 7.6;\n    m.position.z = 0.18 * Math.sin(s / 2.3 + i * 0.72) * k;\n    m.rotation.z = (1 - k) * -0.14;\n  }\n  const ty = (ASC ? -0.34 : -0.5) + 0.3 * Math.sin(s / 3.6) + (pt.on ? (pt.x - 0.5) * 0.5 : 0);\n  const tx = 0.1 * Math.sin(s / 5.3) + (pt.on ? (pt.y - 0.5) * 0.28 : 0);\n  ry += (ty - ry) * 0.05;\n  rx += (tx - rx) * 0.05;\n  grp.rotation.y = ry;\n  grp.rotation.x = rx;\n  grp.rotation.z = -0.025;\n  grp.position.z = NEAR ? -1.2 + 1.2 * eo(Math.min(1, el / 2.6)) : 0;\n  rnd.render(scene, cam);\n  requestAnimationFrame(frame);\n}\nrequestAnimationFrame(frame);\n",
                "css": "html,body{margin:0;height:100%;overflow:hidden;background:transparent}canvas{display:block}",
                "libs": [
                  "three"
                ]
              },
              {
                "id": "tagline",
                "frame": {
                  "x": 96,
                  "y": 850,
                  "w": 520,
                  "h": 100
                },
                "type": "text",
                "text": "Soluciones que\nmueven el negocio",
                "styleRef": "$textStyles.caption",
                "style": {
