  "modules": [
    {
      "id": "s6-bars",
      "name": "Barras vivas",
      "node": {
        "id": "s6-bars",
        "name": "Barras vivas",
        "frame": {
          "x": 1120,
          "y": 360,
          "w": 710,
          "h": 520
        },
        "type": "code-block",
        "code": "\nconst C = ((slidecode.theme||{}).colors)||{};\nconst ACC = C.accent || '#D9A15B';\nconst INK = C.ink || '#E9E5DC';\nconst MUT = C.muted || '#8E887C';\nconst HAIR = C.hairline || '#231F1B';\n\nconst DATA = [\n  { v: 95, hero: true  },\n  { v: 88, hero: false },\n  { v: 92, hero: false },\n  { v: 74, hero: false },\n  { v: 81, hero: false }\n];\n\nconst c = document.createElement('canvas');\ndocument.body.appendChild(c);\nconst ctx = c.getContext('2d');\nlet dpr = Math.min(devicePixelRatio||1, 2), W = 0, Hh = 0;\nfunction size(){\n  W = innerWidth; Hh = innerHeight;\n  c.width = W*dpr; c.height = Hh*dpr;\n  c.style.width = W+'px'; c.style.height = Hh+'px';\n  ctx.setTransform(dpr,0,0,dpr,0,0);\n}\nsize(); addEventListener('resize', size);\n\nconst expo = t => t>=1 ? 1 : 1 - Math.pow(2,-10*t);\nconst ROWS = DATA.length, GAP = 100, TRACK = 8, NUMW = 96;\nlet t0 = null, started = (slidecode.mode === 'edit');\n\nfunction draw(now){\n  const t = now/1000;\n  ctx.clearRect(0,0,W,Hh);\n  const barW = W - NUMW - 18;\n\n  for (let i=0;i<ROWS;i++){\n    const y = 20 + i*GAP;\n    const d = DATA[i];\n    let k = 1;\n    if (!started) k = 0;\n    else if (t0 !== null){\n      k = expo(Math.max(0, Math.min((now - t0 - i*110) / 1100, 1)));\n    }\n    const val = d.v * k;\n\n    // track\n    ctx.fillStyle = HAIR;\n    ctx.fillRect(0, y, barW, TRACK);\n\n    // bar\n    const bw = barW * (val/100);\n    ctx.fillStyle = d.hero ? ACC : MUT;\n    ctx.globalAlpha = d.hero ? 1 : 0.62;\n    ctx.fillRect(0, y, bw, TRACK);\n    ctx.globalAlpha = 1;\n\n    // idle sweep on the hero bar\n    if (d.hero && k > 0.99){\n      const cyc = (t % 5) / 5;\n      if (cyc < 0.55){\n        const p = cyc/0.55, hx = bw*p, g = ctx.createLinearGradient(hx-70, 0, hx+70, 0);\n        g.addColorStop(0,  ACC + '00');\n        g.addColorStop(0.5, INK);\n        g.addColorStop(1,  ACC + '00');\n        ctx.globalAlpha = 0.55*Math.sin(Math.PI*p);\n        ctx.fillStyle = g;\n        ctx.fillRect(Math.max(0,hx-70), y, Math.min(140, bw-(hx-70)), TRACK);\n        ctx.globalAlpha = 1;\n      }\n    }\n\n    // tick at the end of the bar\n    ctx.fillStyle = d.hero ? ACC : MUT;\n    ctx.fillRect(bw-1, y-9, 2, TRACK+18);\n\n    // value\n    ctx.fillStyle = d.hero ? ACC : INK;\n    ctx.font = '800 34px system-ui, -apple-system, sans-serif';\n    ctx.textAlign = 'right'; ctx.textBaseline = 'alphabetic';\n    ctx.globalAlpha = d.hero ? 1 : 0.8;\n    ctx.fillText(Math.round(val).toString(), W, y + TRACK + 8);\n    ctx.globalAlpha = 1;\n  }\n  requestAnimationFrame(draw);\n}\nrequestAnimationFrame(draw);\nslidecode.onReveal(()=>{ started = true; t0 = performance.now(); });\nslidecode.onModeChange(m=>{ if (m==='edit'){ started = true; t0 = null; } });\n"
      }
    },
    {
      "id": "s8-viz",
      "name": "Métricas vivas",
      "node": {
        "id": "s8-viz",
        "name": "Métricas vivas",
        "frame": {
          "x": 90,
          "y": 400,
          "w": 1740,
          "h": 540
        },
        "type": "code-block",
        "code": "\nconst C = ((slidecode.theme||{}).colors)||{};\nconst ACC  = C.accent   || '#D9A15B';\nconst INK   = C.ink     || '#E9E5DC';\nconst MUT   = C.muted   || '#8E887C';\nconst HAIR  = C.hairline|| '#231F1B';\n\nconst M = [\n  { n:148, suf:'',  cap:'proyectos entregados', frac:0.86, hero:false },\n  { n:32,  suf:'',  cap:'marcas acompañadas',   frac:0.64, hero:false },\n  { n:12,  suf:'',  cap:'países',               frac:0.42, hero:true  }\n];\nconst TOTAL = M.length;\n\nconst c = document.createElement('canvas');\ndocument.body.appendChild(c);\nconst ctx = c.getContext('2d');\nlet dpr = Math.min(devicePixelRatio||1,2), W=0, Hh=0;\nfunction size(){ W=innerWidth; Hh=innerHeight; c.width=W*dpr; c.height=Hh*dpr;\n  c.style.width=W+'px'; c.style.height=Hh+'px'; ctx.setTransform(dpr,0,0,dpr,0,0); }\nsize(); addEventListener('resize', size);\n\nconst expo = t => t>=1 ? 1 : 1 - Math.pow(2,-10*t);\nconst stamps = new Array(TOTAL).fill(null);\nlet revealed = false;\n\nfunction shown(){\n  return (slidecode.mode === 'edit') ? TOTAL : slidecode.step;\n}\nfunction sync(now){\n  const s = shown();\n  for (let i=0;i<TOTAL;i++){\n    if (i < s && stamps[i] === null) stamps[i] = (slidecode.mode==='edit' && !revealed) ? now-1600 : now;\n    if (i >= s) stamps[i] = null;\n  }\n}\n\nfunction draw(now){\n  sync(now);\n  const t = now/1000;\n  ctx.clearRect(0,0,W,Hh);\n  const colW = W/TOTAL;\n  const R = Math.min(colW*0.28, Hh*0.34);\n\n  for (let i=0;i<TOTAL;i++){\n    const m = M[i];\n    const cx = colW*(i+0.5), cy = Hh*0.44;\n    const k = stamps[i] === null ? 0 : expo(Math.min((now-stamps[i])/1500, 1));\n\n    // hairline column rule\n    if (i > 0){\n      ctx.strokeStyle = HAIR; ctx.lineWidth = 1;\n      ctx.beginPath(); ctx.moveTo(colW*i, Hh*0.06); ctx.lineTo(colW*i, Hh*0.94); ctx.stroke();\n    }\n\n    // empty ring\n    ctx.strokeStyle = HAIR; ctx.lineWidth = 10;\n    ctx.beginPath(); ctx.arc(cx, cy, R, 0, Math.PI*2); ctx.stroke();\n\n    // filled arc\n    const sweep = Math.PI*2*m.frac*k;\n    ctx.strokeStyle = m.hero ? ACC : MUT;\n    ctx.globalAlpha = m.hero ? 1 : 0.7;\n    ctx.lineWidth = m.hero ? 12 : 10;\n    ctx.lineCap = 'round';\n    ctx.beginPath(); ctx.arc(cx, cy, R, -Math.PI/2, -Math.PI/2 + sweep); ctx.stroke();\n    ctx.globalAlpha = 1; ctx.lineCap = 'butt';\n\n    // idle: orbiting spark on completed rings + hero pulse\n    if (k > 0.99){\n      const ang = -Math.PI/2 + sweep;\n      const orb = ang - (t*0.55 % (Math.PI*2*m.frac));\n      const ox = cx + Math.cos(orb)*R, oy = cy + Math.sin(orb)*R;\n      ctx.fillStyle = m.hero ? ACC : INK;\n      ctx.globalAlpha = m.hero ? 0.95 : 0.5;\n      ctx.beginPath(); ctx.arc(ox, oy, m.hero ? 5.5 : 4, 0, Math.PI*2); ctx.fill();\n      ctx.globalAlpha = 1;\n      if (m.hero){\n        const pulse = (Math.sin(t*1.5)+1)/2;\n        ctx.strokeStyle = ACC; ctx.globalAlpha = 0.10 + 0.14*pulse; ctx.lineWidth = 2;\n        ctx.beginPath(); ctx.arc(cx, cy, R + 14 + 8*pulse, 0, Math.PI*2); ctx.stroke();\n        ctx.globalAlpha = 1;\n      }\n    }\n\n    // number\n    const val = Math.round(m.n * k);\n    ctx.textAlign='center'; ctx.textBaseline='middle';\n    ctx.fillStyle = m.hero ? ACC : INK;\n    ctx.font = '800 ' + Math.round(R*0.78) + 'px system-ui, -apple-system, sans-serif';\n    ctx.globalAlpha = k > 0 ? 1 : 0.12;\n    ctx.fillText(k > 0 ? (val + m.suf) : '—', cx, cy + 2);\n    ctx.globalAlpha = 1;\n\n    // caption\n    ctx.fillStyle = MUT;\n    ctx.font = '500 17px system-ui, -apple-system, sans-serif';\n    ctx.globalAlpha = 0.35 + 0.65*Math.min(k*2,1);\n    ctx.fillText(m.cap.toUpperCase(), cx, cy + R + 46);\n    ctx.globalAlpha = 1;\n  }\n  requestAnimationFrame(draw);\n}\nrequestAnimationFrame(draw);\nslidecode.onReveal(()=>{ revealed = true; });\nslidecode.onStep(()=>{});\nslidecode.onModeChange(()=>{ for (let i=0;i<TOTAL;i++) stamps[i]=null; });\n",
        "stepCount": 3
      }
    }
  ],
  "specimen": "cover",
  "guide": {
    "margin": 62
  }
}
