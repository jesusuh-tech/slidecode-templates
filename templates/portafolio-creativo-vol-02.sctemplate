              {
                "id": "s5-ring",
                "frame": {
                  "x": 900,
                  "y": 80,
                  "w": 1010,
                  "h": 900
                },
                "type": "code-block",
                "code": "\nconst P=slidecode.props||{}; const T=(slidecode.theme&&slidecode.theme.colors)||{};\nconst FG=P.fg||'#F2F1EC', ACC=T.accent||'#F3ED66';\nconst DIM='rgba(242,241,236,0.20)';\nconst STEPS=(P.steps||'DESCUBRIR|INVESTIGAR|IDEAR|DISEÑAR|VALIDAR|ENTREGAR').split('|');\nconst TOTAL=STEPS.length;\n\nconst c=document.createElement('canvas'); c.style.cssText='position:absolute;inset:0';\ndocument.body.appendChild(c);\nconst ctx=c.getContext('2d'); const dpr=Math.min(devicePixelRatio||1,2);\nlet W,H;\nfunction size(){W=innerWidth;H=innerHeight;c.width=W*dpr;c.height=H*dpr;c.style.width=W+'px';c.style.height=H+'px';ctx.setTransform(dpr,0,0,dpr,0,0);}\nsize(); addEventListener('resize',size);\n\nfunction target(){ return slidecode.mode==='edit' ? TOTAL : Math.max(1,Math.min(slidecode.step,TOTAL)); }\nlet goal=target(), shown=goal;\nslidecode.onStep(()=>{goal=target();});\nslidecode.onModeChange(()=>{goal=target();});\n\nconst A0=-Math.PI/2;\nconst t0=performance.now();\nconst UIF=' Helvetica, Arial, sans-serif';\n\nrequestAnimationFrame(function frame(now){\n  const t=now-t0;\n  shown+=(goal-shown)*0.09;                     // el avance se desliza, no salta\n\n  const cx=W/2, cy=H*0.5, R=Math.min(W,H)*0.335;\n  ctx.clearRect(0,0,W,H);\n\n  ctx.strokeStyle=DIM; ctx.lineWidth=1.5;\n  ctx.beginPath(); ctx.arc(cx,cy,R,0,6.283); ctx.stroke();\n\n  ctx.strokeStyle=ACC; ctx.lineWidth=4; ctx.lineCap='round';   // arco de progreso\n  ctx.beginPath(); ctx.arc(cx,cy,R,A0,A0+(shown-1)/TOTAL*6.283); ctx.stroke();\n\n  const sa=A0+(t/7000)*6.283;                   // chispa en órbita: el bucle ocioso\n  const sx=cx+Math.cos(sa)*R, sy=cy+Math.sin(sa)*R;\n  const gr=ctx.createRadialGradient(sx,sy,0,sx,sy,26);\n  gr.addColorStop(0,ACC); gr.addColorStop(1,'rgba(243,237,102,0)');\n  ctx.fillStyle=gr; ctx.beginPath(); ctx.arc(sx,sy,26,0,6.283); ctx.fill();\n\n  ctx.textAlign='center'; ctx.textBaseline='middle';\n  const act=Math.round(shown);\n  for(let i=0;i<TOTAL;i++){\n    const a=A0+i/TOTAL*6.283, x=cx+Math.cos(a)*R, y=cy+Math.sin(a)*R;\n    const on=i<act, isAct=i===act-1;\n    const pulse=isAct?1+Math.sin(t/520)*0.18:1;\n    ctx.fillStyle=on?ACC:'#141413';\n    ctx.strokeStyle=on?ACC:DIM; ctx.lineWidth=2;\n    ctx.beginPath(); ctx.arc(x,y,(on?9:7)*pulse,0,6.283); ctx.fill(); ctx.stroke();\n\n    const lx=cx+Math.cos(a)*(R+54), ly=cy+Math.sin(a)*(R+54);\n    ctx.fillStyle=on?FG:'rgba(242,241,236,0.34)';\n    ctx.font='600 15px'+UIF;\n    ctx.fillText(STEPS[i],lx,ly);\n    ctx.fillStyle=on?ACC:'rgba(242,241,236,0.20)';\n    ctx.font=\"400 15px 'Anton'\";\n    ctx.fillText('0'+(i+1),lx,ly+22);\n  }\n\n  const idx=Math.max(0,act-1);\n  ctx.fillStyle=ACC; ctx.font=\"400 92px 'Anton'\";\n  ctx.fillText('0'+(idx+1),cx,cy-8);\n  ctx.fillStyle=FG; ctx.font='600 15px'+UIF;\n  ctx.fillText(STEPS[idx],cx,cy+54);\n\n  requestAnimationFrame(frame);\n});\n",
                "css": "@font-face{font-family:'Anton';font-style:normal;font-weight:400;src:url(data:font/woff2;base64,) format('woff2');}html,body{margin:0;height:100%;overflow:hidden}",
                "props": {
