                "type": "code-block",
                "code": "\nconst P=slidecode.props||{}; const T=(slidecode.theme&&slidecode.theme.colors)||{};\nconst LENS=P.lens||T.ink||'#111110';\nconst INNER=P.surface||T.canvas||'#F2F1EC';\nconst ACC=P.ring||T.accent||'#F3ED66';\nconst SKIP=slidecode.mode==='edit';\n\nconst c=document.createElement('canvas'); c.style.cssText='position:absolute;inset:0';\ndocument.body.appendChild(c);\nconst ctx=c.getContext('2d'); const dpr=Math.min(devicePixelRatio||1,2);\nlet W,H;\nfunction size(){W=innerWidth;H=innerHeight;c.width=W*dpr;c.height=H*dpr;c.style.width=W+'px';c.style.height=H+'px';ctx.setTransform(dpr,0,0,dpr,0,0);}\nsize(); addEventListener('resize',size);\n\n// El ojo SIGUE al cursor — y por tanto al dedo, si el modo gestos está activo.\nlet tx=0.5,ty=0.5,px=0.5,py=0.5,lastPtr=-1e9;\nslidecode.onPointer(p=>{ if(p&&p.inside){ tx=p.x; ty=p.y; lastPtr=performance.now(); } });\n\nfunction lens(cx,cy,rw,rh){\n  ctx.beginPath();\n  ctx.moveTo(cx-rw,cy);\n  ctx.bezierCurveTo(cx-rw*0.52,cy-rh, cx+rw*0.52,cy-rh, cx+rw,cy);\n  ctx.bezierCurveTo(cx+rw*0.52,cy+rh, cx-rw*0.52,cy+rh, cx-rw,cy);\n  ctx.closePath();\n}\nconst expo=t=>t>=1?1:1-Math.pow(2,-10*t);\nlet start=null;\nfunction frame(now){\n  if(start===null) start=now;\n  const t=now-start;\n  const open=SKIP?1:expo(Math.min(t/800,1));            // el ojo se abre al revelar\n\n  const live=(now-lastPtr)<1000;\n  const gx=live?tx:0.5+Math.sin(t/3400)*0.17;           // deriva ociosa si nadie apunta\n  const gy=live?ty:0.5+Math.cos(t/2700)*0.13;\n  px+=(gx-px)*0.075; py+=(gy-py)*0.075;\n\n  const cyc=t%5400;\n  const blink=cyc>5050?Math.sin((cyc-5050)/350*Math.PI):0;   // parpadeo cada 5,4 s\n\n  const cx=W/2, cy=H/2, rw=W*0.47;\n  const rh=Math.min(H*0.46,rw*0.52)*open*(1-blink*0.94);\n\n  ctx.clearRect(0,0,W,H);\n  lens(cx,cy,rw,rh); ctx.fillStyle=LENS; ctx.fill();\n  if(rh<6){ requestAnimationFrame(frame); return; }\n\n  ctx.save(); lens(cx,cy,rw,rh); ctx.clip();\n  const r=Math.min(rw*0.30,rh*0.80);\n  const ox=cx+(px-0.5)*rw*0.40, oy=cy+(py-0.5)*rh*0.62;\n  const lw=Math.max(3,rw*0.030);\n\n  ctx.strokeStyle=INNER; ctx.lineWidth=lw;                 // retícula larga sobre la lente\n  ctx.beginPath(); ctx.moveTo(ox,cy-rh); ctx.lineTo(ox,cy+rh);\n  ctx.moveTo(cx-rw,oy); ctx.lineTo(cx+rw,oy); ctx.stroke();\n\n  ctx.fillStyle=INNER; ctx.beginPath(); ctx.arc(ox,oy,r,0,6.283); ctx.fill();\n\n  ctx.strokeStyle=ACC; ctx.lineWidth=Math.max(2,r*0.075);  // anillo que gira: el latido\n  ctx.setLineDash([r*0.30,r*0.34]); ctx.lineDashOffset=-t/26;\n  ctx.beginPath(); ctx.arc(ox,oy,r*1.52,0,6.283); ctx.stroke();\n  ctx.setLineDash([]);\n\n  ctx.strokeStyle=LENS; ctx.lineWidth=lw*0.78;             // cruz interior\n  ctx.beginPath(); ctx.moveTo(ox,oy-r*0.82); ctx.lineTo(ox,oy+r*0.82);\n  ctx.moveTo(ox-r*0.82,oy); ctx.lineTo(ox+r*0.82,oy); ctx.stroke();\n\n  ctx.fillStyle=LENS; ctx.beginPath(); ctx.arc(ox,oy,r*0.36,0,6.283); ctx.fill();\n  ctx.restore();\n  requestAnimationFrame(frame);\n}\nslidecode.onReveal(()=>requestAnimationFrame(frame));\n",
                "css": "html,body{margin:0;height:100%;overflow:hidden;background:transparent}",
