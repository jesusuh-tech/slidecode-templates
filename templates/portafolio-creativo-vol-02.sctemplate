  "layouts": [
    {
      "id": "cover",
      "name": "Portada",
      "slide": {
        "id": "cover",
        "name": "Portada",
        "background": {
          "type": "solid",
          "color": "$colors.canvas"
        },
        "transition": {
          "type": "fade",
          "duration": 0.6
        },
        "layers": [
          {
            "id": "main",
            "nodes": [
              {
                "id": "cover-ribbon",
                "frame": {
                  "x": 600,
                  "y": 10,
                  "w": 1320,
                  "h": 960
                },
                "type": "code-block",
                "code": "\nconst T=(slidecode.theme&&slidecode.theme.colors)||{};\nconst INK=T.ink||'#111110', ACC=T.accent||'#F3ED66';\nconst SKIP=slidecode.mode==='edit';\n\nconst renderer=new THREE.WebGLRenderer({antialias:true,alpha:true});\nrenderer.setPixelRatio(Math.min(devicePixelRatio||1,2));\nrenderer.setSize(innerWidth,innerHeight);\nrenderer.domElement.style.cssText='position:absolute;inset:0';\ndocument.body.appendChild(renderer.domElement);\n\nconst scene=new THREE.Scene();\nconst camera=new THREE.PerspectiveCamera(33,innerWidth/innerHeight,0.1,100);\ncamera.position.set(0,0,9.4);\n\n// Cinta en S — eco tridimensional del trazo de la referencia\nconst pts=[];\nfor(let i=0;i<=60;i++){\n  const t=i/60;\n  pts.push(new THREE.Vector3(\n    (t-0.5)*8.6,\n    Math.sin(t*Math.PI*1.9+0.45)*1.85,\n    Math.cos(t*Math.PI*1.35)*1.05\n  ));\n}\nconst tube=new THREE.Mesh(\n  new THREE.TubeGeometry(new THREE.CatmullRomCurve3(pts),300,0.60,26,false),\n  new THREE.MeshStandardMaterial({color:new THREE.Color(INK),metalness:0.78,roughness:0.26})\n);\nconst group=new THREE.Group(); group.add(tube); scene.add(group);\n\nconst key=new THREE.PointLight(new THREE.Color(ACC),300); key.position.set(4.5,3.2,4.5); scene.add(key);\nconst rim=new THREE.PointLight(0xffffff,110);             rim.position.set(-5.5,-2.4,2.6); scene.add(rim);\nconst top=new THREE.PointLight(new THREE.Color(ACC),80);  top.position.set(-1,5.5,-3);     scene.add(top);\nscene.add(new THREE.AmbientLight(0xffffff,1.1));\n\n// Grano/spray por encima — la disolución granulada de la referencia\nconst g=document.createElement('canvas');\ng.style.cssText='position:absolute;inset:0';\ndocument.body.appendChild(g);\nconst gx=g.getContext('2d'); const dpr=Math.min(devicePixelRatio||1,2);\nlet GW,GH;\nfunction size(){\n  GW=innerWidth; GH=innerHeight;\n  g.width=GW*dpr; g.height=GH*dpr; g.style.width=GW+'px'; g.style.height=GH+'px';\n  gx.setTransform(dpr,0,0,dpr,0,0);\n  camera.aspect=GW/GH; camera.updateProjectionMatrix(); renderer.setSize(GW,GH);\n}\nsize(); addEventListener('resize',size);\n\nconst dots=Array.from({length:1400},(_,i)=>{\n  const a=Math.sin(i*12.9898)*43758.5453, b=Math.sin(i*78.233)*12345.6789;\n  const rx=a-Math.floor(a), ry=b-Math.floor(b);\n  return {bx:rx*rx, by:ry, ph:rx*6.283, sp:0.4+ry*0.9, r:0.6+((i%5)*0.42)};\n});\n\nconst expo=t=>t>=1?1:1-Math.pow(2,-10*t);\nlet start=null;\nfunction frame(now){\n  if(start===null) start=now;\n  const t=now-start;\n  const k=SKIP?1:expo(Math.min(t/1500,1));\n\n  group.scale.setScalar(0.72+0.28*k);\n  group.position.y=(1-k)*-1.6+Math.sin(t/2400)*0.10;   // flota\n  group.rotation.y=-0.25+Math.sin(t/6200)*0.30;        // vaivén lento, con peso\n  group.rotation.z=Math.sin(t/5100)*0.09;\n  group.rotation.x=Math.sin(t/7300)*0.06;\n  key.intensity=300+Math.sin(t/1100)*70;               // la luz respira\n  renderer.render(scene,camera);\n\n  gx.clearRect(0,0,GW,GH);\n  const wipe=SKIP?1:Math.min(t/1900,1);\n  for(const d of dots){\n    const x=d.bx*GW*0.72+Math.cos(t/2600*d.sp+d.ph)*6;\n    if(x/GW>wipe) continue;\n    const y=(d.by+Math.sin(t/3000*d.sp+d.ph)*0.03)*GH;\n    const fade=(1-d.bx)*(0.55+0.45*Math.sin(t/900*d.sp+d.ph));\n    if(fade<=0.02) continue;\n    gx.fillStyle='rgba(17,17,16,'+(fade*0.9).toFixed(3)+')';\n    gx.beginPath(); gx.arc(x,y,d.r,0,6.283); gx.fill();\n  }\n  requestAnimationFrame(frame);\n}\nslidecode.onReveal(()=>requestAnimationFrame(frame));\n",
                "css": "html,body{margin:0;height:100%;overflow:hidden;background:transparent}",
                "libs": [
                  "three"
                ]
              },
