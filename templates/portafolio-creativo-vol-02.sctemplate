    {
      "id": "s5-ring",
      "node": {
        "id": "s5-ring",
        "frame": {
          "x": 900,
          "y": 80,
          "w": 1010,
          "h": 900
        },
        "type": "code-block",
        "code": "\nconst P=slidecode.props||{}; const T=(slidecode.theme&&slidecode.theme.colors)||{};\nconst FG=P.fg||'#F2F1EC', ACC=T.accent||'#F3ED66';\nconst DIM='rgba(242,241,236,0.20)';\nconst STEPS=(P.steps||'DESCUBRIR|INVESTIGAR|IDEAR|DISEÑAR|VALIDAR|ENTREGAR').split('|');\nconst TOTAL=STEPS.length;\n\nconst c=document.createElement('canvas'); c.style.cssText='position:absolute;inset:0';\ndocument.body.appendChild(c);\nconst ctx=c.getContext('2d'); const dpr=Math.min(devicePixelRatio||1,2);\nlet W,H;\nfunction size(){W=innerWidth;H=innerHeight;c.width=W*dpr;c.height=H*dpr;c.style.width=W+'px';c.style.height=H+'px';ctx.setTransform(dpr,0,0,dpr,0,0);}\nsize(); addEventListener('resize',size);\n\nfunction target(){ return slidecode.mode==='edit' ? TOTAL : Math.max(1,Math.min(slidecode.step,TOTAL)); }\nlet goal=target(), shown=goal;\nslidecode.onStep(()=>{goal=target();});\nslidecode.onModeChange(()=>{goal=target();});\n\nconst A0=-Math.PI/2;\nconst t0=performance.now();\nconst UIF=' Helvetica, Arial, sans-serif';\n\nrequestAnimationFrame(function frame(now){\n  const t=now-t0;\n  shown+=(goal-shown)*0.09;                     // el avance se desliza, no salta\n\n  const cx=W/2, cy=H*0.5, R=Math.min(W,H)*0.335;\n  ctx.clearRect(0,0,W,H);\n\n  ctx.strokeStyle=DIM; ctx.lineWidth=1.5;\n  ctx.beginPath(); ctx.arc(cx,cy,R,0,6.283); ctx.stroke();\n\n  ctx.strokeStyle=ACC; ctx.lineWidth=4; ctx.lineCap='round';   // arco de progreso\n  ctx.beginPath(); ctx.arc(cx,cy,R,A0,A0+(shown-1)/TOTAL*6.283); ctx.stroke();\n\n  const sa=A0+(t/7000)*6.283;                   // chispa en órbita: el bucle ocioso\n  const sx=cx+Math.cos(sa)*R, sy=cy+Math.sin(sa)*R;\n  const gr=ctx.createRadialGradient(sx,sy,0,sx,sy,26);\n  gr.addColorStop(0,ACC); gr.addColorStop(1,'rgba(243,237,102,0)');\n  ctx.fillStyle=gr; ctx.beginPath(); ctx.arc(sx,sy,26,0,6.283); ctx.fill();\n\n  ctx.textAlign='center'; ctx.textBaseline='middle';\n  const act=Math.round(shown);\n  for(let i=0;i<TOTAL;i++){\n    const a=A0+i/TOTAL*6.283, x=cx+Math.cos(a)*R, y=cy+Math.sin(a)*R;\n    const on=i<act, isAct=i===act-1;\n    const pulse=isAct?1+Math.sin(t/520)*0.18:1;\n    ctx.fillStyle=on?ACC:'#141413';\n    ctx.strokeStyle=on?ACC:DIM; ctx.lineWidth=2;\n    ctx.beginPath(); ctx.arc(x,y,(on?9:7)*pulse,0,6.283); ctx.fill(); ctx.stroke();\n\n    const lx=cx+Math.cos(a)*(R+54), ly=cy+Math.sin(a)*(R+54);\n    ctx.fillStyle=on?FG:'rgba(242,241,236,0.34)';\n    ctx.font='600 15px'+UIF;\n    ctx.fillText(STEPS[i],lx,ly);\n    ctx.fillStyle=on?ACC:'rgba(242,241,236,0.20)';\n    ctx.font=\"400 15px 'Anton'\";\n    ctx.fillText('0'+(i+1),lx,ly+22);\n  }\n\n  const idx=Math.max(0,act-1);\n  ctx.fillStyle=ACC; ctx.font=\"400 92px 'Anton'\";\n  ctx.fillText('0'+(idx+1),cx,cy-8);\n  ctx.fillStyle=FG; ctx.font='600 15px'+UIF;\n  ctx.fillText(STEPS[idx],cx,cy+54);\n\n  requestAnimationFrame(frame);\n});\n",
        "css": "@font-face{font-family:'Anton';font-style:normal;font-weight:400;src:url(data:font/woff2;base64,) format('woff2');}html,body{margin:0;height:100%;overflow:hidden}",
        "props": {
          "fg": "#F2F1EC"
        },
        "stepCount": 6
      }
    },
    {
      "id": "s8-chart",
      "node": {
        "id": "s8-chart",
        "frame": {
          "x": 800,
          "y": 240,
          "w": 1060,
          "h": 660
        },
        "type": "code-block",
        "code": "\nconst P=slidecode.props||{}; const T=(slidecode.theme&&slidecode.theme.colors)||{};\nconst INK=P.ink||T.ink||'#111110';\nconst LABELS=['E','F','M','A','M','J','J','A','S','O','N','D'];\nconst VALS=[12,15,14,22,28,26,38,44,41,58,66,84];\nconst MAX=95;\nconst UIF=' Helvetica, Arial, sans-serif';\n\nconst c=document.createElement('canvas'); c.style.cssText='position:absolute;inset:0';\ndocument.body.appendChild(c);\nconst ctx=c.getContext('2d'); const dpr=Math.min(devicePixelRatio||1,2);\nlet W,H;\nfunction size(){W=innerWidth;H=innerHeight;c.width=W*dpr;c.height=H*dpr;c.style.width=W+'px';c.style.height=H+'px';ctx.setTransform(dpr,0,0,dpr,0,0);}\nsize(); addEventListener('resize',size);\n\nconst EDIT=slidecode.mode==='edit';\nfunction target(){ return EDIT?3:Math.max(0,Math.min(slidecode.step,3)); }\nlet phase=target();\nlet t0=performance.now();\nlet growFrom=EDIT?t0-6000:null;\nslidecode.onStep(()=>{ phase=target(); if(phase>=2&&growFrom===null) growFrom=performance.now(); });\nslidecode.onModeChange(()=>{ phase=target(); if(phase>=2&&growFrom===null) growFrom=performance.now()-6000; });\nslidecode.onReveal(()=>{ t0=performance.now(); if(EDIT) growFrom=t0-6000; });\n\nconst expo=t=>t>=1?1:1-Math.pow(2,-10*t);\nconst PADL=54, PADR=30, PADT=26, PADB=46;\n\nrequestAnimationFrame(function frame(now){\n  const t=now-t0;\n  ctx.clearRect(0,0,W,H);\n  const x0=PADL, x1=W-PADR, y0=PADT, y1=H-PADB;\n  const px=i=>x0+i*(x1-x0)/(VALS.length-1);\n  const py=v=>y1-(v/MAX)*(y1-y0);\n\n  // fase 1 — la rejilla se traza\n  const gk=phase>=1?expo(Math.min(t/700,1)):0;\n  if(gk>0){\n    ctx.strokeStyle=INK; ctx.globalAlpha=0.16*gk; ctx.lineWidth=1; ctx.setLineDash([4,7]);\n    for(let v=0;v<=MAX;v+=MAX/4){\n      ctx.beginPath(); ctx.moveTo(x0,py(v)); ctx.lineTo(x0+(x1-x0)*gk,py(v)); ctx.stroke();\n    }\n    ctx.setLineDash([]);\n    ctx.globalAlpha=0.55*gk; ctx.fillStyle=INK;\n    ctx.font='600 12px'+UIF; ctx.textAlign='center'; ctx.textBaseline='top';\n    LABELS.forEach((l,i)=>ctx.fillText(l,px(i),y1+16));\n    ctx.globalAlpha=1;\n  }\n\n  // fase 2 — la curva crece\n  const gk2=(phase>=2&&growFrom!==null)?expo(Math.min((now-growFrom)/1500,1)):0;\n  if(gk2>0){\n    const n=1+(VALS.length-1)*gk2, path=[];\n    for(let i=0;i<VALS.length;i++){\n      if(i<=n) path.push([px(i),py(VALS[i])]);\n      else if(i-1<n){\n        const f=n-(i-1);\n        path.push([px(i-1)+(px(i)-px(i-1))*f, py(VALS[i-1])+(py(VALS[i])-py(VALS[i-1]))*f]);\n        break;\n      }\n    }\n    ctx.beginPath(); ctx.moveTo(path[0][0],y1);\n    path.forEach(p=>ctx.lineTo(p[0],p[1]));\n    ctx.lineTo(path[path.length-1][0],y1); ctx.closePath();\n    ctx.fillStyle=INK; ctx.globalAlpha=0.13; ctx.fill(); ctx.globalAlpha=1;\n\n    ctx.beginPath(); path.forEach((p,i)=>i?ctx.lineTo(p[0],p[1]):ctx.moveTo(p[0],p[1]));\n    ctx.strokeStyle=INK; ctx.lineWidth=4; ctx.lineJoin='round'; ctx.lineCap='round'; ctx.stroke();\n\n    if(gk2>=1){                       // bucle ocioso: un punto recorre la curva sin parar\n      const q=((now/2600)%1)*(VALS.length-1), i=Math.floor(q), f=q-i;\n      const mx=px(i)+(px(i+1)-px(i))*f, my=py(VALS[i])+(py(VALS[i+1])-py(VALS[i]))*f;\n      ctx.fillStyle=INK; ctx.globalAlpha=0.30;\n      ctx.beginPath(); ctx.arc(mx,my,7,0,6.283); ctx.fill(); ctx.globalAlpha=1;\n    }\n    const lp=path[path.length-1];\n    ctx.fillStyle=INK; ctx.beginPath(); ctx.arc(lp[0],lp[1],6,0,6.283); ctx.fill();\n  }\n\n  // fase 3 — el remate\n  if(phase>=3&&gk2>=1){\n    const p=0.55+0.45*Math.sin(now/700);\n    const lx=px(VALS.length-1), ly=py(VALS[VALS.length-1]);\n    ctx.strokeStyle=INK; ctx.globalAlpha=0.35*p; ctx.lineWidth=2;\n    ctx.beginPath(); ctx.arc(lx,ly,18+p*5,0,6.283); ctx.stroke(); ctx.globalAlpha=1;\n    ctx.fillStyle=INK; ctx.textAlign='right'; ctx.textBaseline='bottom';\n    ctx.font=\"400 56px 'Anton'\"; ctx.fillText('+600%',lx-28,ly+18);\n    ctx.font='600 12px'+UIF; ctx.fillText('ALCANCE ORGÁNICO · 12 MESES',lx-28,ly+38);\n  }\n  requestAnimationFrame(frame);\n});\n",
        "css": "@font-face{font-family:'Anton';font-style:normal;font-weight:400;src:url(data:font/woff2;base64,) format('woff2');}html,body{margin:0;height:100%;overflow:hidden}",
        "props": {
          "ink": "#111110"
        },
        "stepCount": 3
      }
    },
    {
      "id": "s9-marquee",
      "node": {
        "id": "s9-marquee",
        "frame": {
          "x": 0,
          "y": 546,
          "w": 1920,
          "h": 300
        },
        "type": "code-block",
        "code": "\nconst P=slidecode.props||{}; const T=(slidecode.theme&&slidecode.theme.colors)||{};\nconst INK=P.ink||T.ink||'#111110';\nconst A=(P.rowA||'MERIDIAN/ATLAS/NOVA STUDIO/KIOSKO/HELIO/BRUT').split('/');\nconst B=(P.rowB||'CAMPO/ÓRBITA/TINTA/ANDANTE/PLENA/RÍO').split('/');\n\nconst st=document.createElement('style');\nst.textContent=\n \".row{position:absolute;left:0;white-space:nowrap;font-family:'Anton';font-size:96px;\"+\n \"line-height:1;letter-spacing:-1px;will-change:transform;opacity:0}\"+\n \".a{top:4%;color:\"+INK+\"}\"+\n \".b{top:50%;color:transparent;-webkit-text-stroke:2px \"+INK+\"}\";\ndocument.head.appendChild(st);\n\nfunction make(cls,list){\n  const d=document.createElement('div'); d.className='row '+cls;\n  d.textContent=(list.join('  /  ')+'  /  ').repeat(4);\n  document.body.appendChild(d); return d;\n}\nconst ra=make('a',A), rb=make('b',B);\nlet wa=ra.scrollWidth/4, wb=rb.scrollWidth/4;\n// Anton llega por base64: hay que remedir cuando termina de cargar.\nif(document.fonts&&document.fonts.ready){\n  document.fonts.ready.then(()=>{ wa=ra.scrollWidth/4; wb=rb.scrollWidth/4; });\n}\n\nconst expo=t=>t>=1?1:1-Math.pow(2,-10*t);\nconst SKIP=slidecode.mode==='edit';\nlet t0=null;\nfunction frame(now){\n  if(t0===null) t0=now;\n  const t=now-t0;\n  const k=SKIP?1:expo(Math.min(t/900,1));\n  ra.style.opacity=k; rb.style.opacity=k*0.9;\n  ra.style.transform='translateX('+((1-k)*90-((t/26)%wa))+'px)';\n  rb.style.transform='translateX('+((1-k)*-90+((t/34)%wb)-wb)+'px)';\n  requestAnimationFrame(frame);\n}\nslidecode.onReveal(()=>requestAnimationFrame(frame));\n",
        "css": "@font-face{font-family:'Anton';font-style:normal;font-weight:400;src:url(data:font/woff2;base64,) format('woff2');}html,body{margin:0;height:100%;overflow:hidden}",
        "props": {
          "ink": "#111110"
        }
      }
    },
    {
      "id": "s10-grain",
      "node": {
        "id": "s10-grain",
        "frame": {
          "x": 0,
          "y": 0,
          "w": 1920,
          "h": 1080
        },
        "type": "code-block",
        "code": "\nconst c=document.createElement('canvas'); c.style.cssText='position:absolute;inset:0';\ndocument.body.appendChild(c);\nconst ctx=c.getContext('2d'); const dpr=Math.min(devicePixelRatio||1,2);\nlet W,H;\nfunction size(){W=innerWidth;H=innerHeight;c.width=W*dpr;c.height=H*dpr;c.style.width=W+'px';c.style.height=H+'px';ctx.setTransform(dpr,0,0,dpr,0,0);}\nsize(); addEventListener('resize',size);\nconst pts=Array.from({length:520},(_,i)=>{\n  const a=Math.sin(i*12.9898)*43758.5453, b=Math.sin(i*78.233)*12345.6789;\n  const rx=a-Math.floor(a), ry=b-Math.floor(b);\n  return {x:rx, y:ry, ph:rx*6.283, sp:0.5+ry, r:0.7+(i%4)*0.4};\n});\nrequestAnimationFrame(function frame(now){\n  ctx.clearRect(0,0,W,H);\n  const scan=(now/9000)%1;                 // barrido lento que despierta el grano\n  for(const p of pts){\n    const x=p.x*W+Math.sin(now/4200*p.sp+p.ph)*9;\n    const y=p.y*H+Math.cos(now/5200*p.sp+p.ph)*7;\n    const d=Math.abs(p.x-scan), hot=d<0.10?(1-d/0.10):0;\n    const a=0.05+0.05*Math.sin(now/1400*p.sp+p.ph)+hot*0.40;\n    ctx.fillStyle=hot>0.15?'rgba(243,237,102,'+(hot*0.5).toFixed(3)+')'\n                          :'rgba(242,241,236,'+a.toFixed(3)+')';\n    ctx.beginPath(); ctx.arc(x,y,p.r,0,6.283); ctx.fill();\n  }\n  requestAnimationFrame(frame);\n});\n",
        "css": "html,body{margin:0;height:100%;overflow:hidden;background:transparent}"
      }
    },
    {
      "id": "s10-counters",
      "node": {
        "id": "s10-counters",
        "frame": {
          "x": 100,
          "y": 560,
          "w": 1720,
          "h": 380
        },
        "type": "code-block",
        "code": "\nconst P=slidecode.props||{}; const T=(slidecode.theme&&slidecode.theme.colors)||{};\nconst ACC=T.accent||'#F3ED66', FG=P.fg||'#F2F1EC';\nconst ITEMS=[\n  {pre:'+', val:60,  suf:'%', dec:0, label:'MÁS ENGAGEMENT TRAS EL REDISEÑO'},\n  {pre:'×', val:3.4, suf:'',  dec:1, label:'ALCANCE FRENTE AL AÑO ANTERIOR'},\n  {pre:'',  val:12,  suf:'',  dec:0, label:'LANZAMIENTOS ENTREGADOS A TIEMPO'}\n];\n\nconst st=document.createElement('style');\nst.textContent=\n \"#w{display:flex;height:100%;align-items:flex-end}\"+\n \".col{flex:1;padding-right:56px}\"+\n \".n{font-family:'Anton';font-size:126px;line-height:0.9;color:\"+FG+\";letter-spacing:-2px}\"+\n \".n em{font-style:normal;color:\"+ACC+\"}\"+\n \".bar{height:5px;background:rgba(242,241,236,0.16);margin:24px 0 16px;position:relative;overflow:hidden}\"+\n \".bar i{position:absolute;top:0;bottom:0;left:0;right:100%;background:\"+ACC+\"}\"+\n \".l{font:600 14px/1.45 Helvetica, Arial, sans-serif;letter-spacing:1.6px;text-transform:uppercase;\"+\n \"color:rgba(242,241,236,0.60);max-width:260px}\";\ndocument.head.appendChild(st);\n\nconst wrap=document.createElement('div'); wrap.id='w'; document.body.appendChild(wrap);\nconst nodes=ITEMS.map(it=>{\n  const col=document.createElement('div'); col.className='col';\n  const n=document.createElement('div'); n.className='n';\n  const bar=document.createElement('div'); bar.className='bar';\n  const fill=document.createElement('i'); bar.appendChild(fill);\n  const l=document.createElement('div'); l.className='l'; l.textContent=it.label;\n  col.append(n,bar,l); wrap.appendChild(col);\n  return {n,fill,it};\n});\n\nconst expo=t=>t>=1?1:1-Math.pow(2,-10*t);\nconst SKIP=slidecode.mode==='edit';\nlet t0=null;\nfunction frame(now){\n  if(t0===null) t0=now;\n  const t=now-t0;\n  nodes.forEach((o,i)=>{\n    const k=SKIP?1:expo(Math.max(0,Math.min((t-i*170)/1500,1)));\n    o.n.innerHTML=o.it.pre+'<em>'+(o.it.val*k).toFixed(o.it.dec)+'</em>'+o.it.suf;\n    // la barra llena al contar y luego respira — el sistema sigue vivo\n    const breathe=k>=1?0.94+0.06*Math.sin((t-i*400)/1300):1;\n    o.fill.style.right=(100-100*k*breathe)+'%';\n  });\n  requestAnimationFrame(frame);\n}\nslidecode.onReveal(()=>requestAnimationFrame(frame));\n",
        "css": "@font-face{font-family:'Anton';font-style:normal;font-weight:400;src:url(data:font/woff2;base64,) format('woff2');}html,body{margin:0;height:100%;overflow:hidden}",
        "props": {
          "fg": "#F2F1EC"
        }
      }
    },
    {
      "id": "close-mark",
      "node": {
        "id": "close-mark",
        "frame": {
          "x": 1400,
          "y": 470,
          "w": 420,
          "h": 220
        },
        "type": "code-block",
        "code": "\nconst P=slidecode.props||{}; const T=(slidecode.theme&&slidecode.theme.colors)||{};\nconst LENS=P.lens||T.ink||'#111110';\nconst INNER=P.surface||T.canvas||'#F2F1EC';\nconst ACC=P.ring||T.accent||'#F3ED66';\nconst SKIP=slidecode.mode==='edit';\n\nconst c=document.createElement('canvas'); c.style.cssText='position:absolute;inset:0';\ndocument.body.appendChild(c);\nconst ctx=c.getContext('2d'); const dpr=Math.min(devicePixelRatio||1,2);\nlet W,H;\nfunction size(){W=innerWidth;H=innerHeight;c.width=W*dpr;c.height=H*dpr;c.style.width=W+'px';c.style.height=H+'px';ctx.setTransform(dpr,0,0,dpr,0,0);}\nsize(); addEventListener('resize',size);\n\n// El ojo SIGUE al cursor — y por tanto al dedo, si el modo gestos está activo.\nlet tx=0.5,ty=0.5,px=0.5,py=0.5,lastPtr=-1e9;\nslidecode.onPointer(p=>{ if(p&&p.inside){ tx=p.x; ty=p.y; lastPtr=performance.now(); } });\n\nfunction lens(cx,cy,rw,rh){\n  ctx.beginPath();\n  ctx.moveTo(cx-rw,cy);\n  ctx.bezierCurveTo(cx-rw*0.52,cy-rh, cx+rw*0.52,cy-rh, cx+rw,cy);\n  ctx.bezierCurveTo(cx+rw*0.52,cy+rh, cx-rw*0.52,cy+rh, cx-rw,cy);\n  ctx.closePath();\n}\nconst expo=t=>t>=1?1:1-Math.pow(2,-10*t);\nlet start=null;\nfunction frame(now){\n  if(start===null) start=now;\n  const t=now-start;\n  const open=SKIP?1:expo(Math.min(t/800,1));            // el ojo se abre al revelar\n\n  const live=(now-lastPtr)<1000;\n  const gx=live?tx:0.5+Math.sin(t/3400)*0.17;           // deriva ociosa si nadie apunta\n  const gy=live?ty:0.5+Math.cos(t/2700)*0.13;\n  px+=(gx-px)*0.075; py+=(gy-py)*0.075;\n\n  const cyc=t%5400;\n  const blink=cyc>5050?Math.sin((cyc-5050)/350*Math.PI):0;   // parpadeo cada 5,4 s\n\n  const cx=W/2, cy=H/2, rw=W*0.47;\n  const rh=Math.min(H*0.46,rw*0.52)*open*(1-blink*0.94);\n\n  ctx.clearRect(0,0,W,H);\n  lens(cx,cy,rw,rh); ctx.fillStyle=LENS; ctx.fill();\n  if(rh<6){ requestAnimationFrame(frame); return; }\n\n  ctx.save(); lens(cx,cy,rw,rh); ctx.clip();\n  const r=Math.min(rw*0.30,rh*0.80);\n  const ox=cx+(px-0.5)*rw*0.40, oy=cy+(py-0.5)*rh*0.62;\n  const lw=Math.max(3,rw*0.030);\n\n  ctx.strokeStyle=INNER; ctx.lineWidth=lw;                 // retícula larga sobre la lente\n  ctx.beginPath(); ctx.moveTo(ox,cy-rh); ctx.lineTo(ox,cy+rh);\n  ctx.moveTo(cx-rw,oy); ctx.lineTo(cx+rw,oy); ctx.stroke();\n\n  ctx.fillStyle=INNER; ctx.beginPath(); ctx.arc(ox,oy,r,0,6.283); ctx.fill();\n\n  ctx.strokeStyle=ACC; ctx.lineWidth=Math.max(2,r*0.075);  // anillo que gira: el latido\n  ctx.setLineDash([r*0.30,r*0.34]); ctx.lineDashOffset=-t/26;\n  ctx.beginPath(); ctx.arc(ox,oy,r*1.52,0,6.283); ctx.stroke();\n  ctx.setLineDash([]);\n\n  ctx.strokeStyle=LENS; ctx.lineWidth=lw*0.78;             // cruz interior\n  ctx.beginPath(); ctx.moveTo(ox,oy-r*0.82); ctx.lineTo(ox,oy+r*0.82);\n  ctx.moveTo(ox-r*0.82,oy); ctx.lineTo(ox+r*0.82,oy); ctx.stroke();\n\n  ctx.fillStyle=LENS; ctx.beginPath(); ctx.arc(ox,oy,r*0.36,0,6.283); ctx.fill();\n  ctx.restore();\n  requestAnimationFrame(frame);\n}\nslidecode.onReveal(()=>requestAnimationFrame(frame));\n",
        "css": "html,body{margin:0;height:100%;overflow:hidden;background:transparent}",
        "props": {
          "lens": "#F2F1EC",
          "surface": "#2A2A28",
          "ring": "#F3ED66"
        }
      }
    },
    {
      "id": "close-mark-1",
      "node": {
        "id": "close-mark",
        "frame": {
          "x": 1000,
          "y": 120,
          "w": 880,
          "h": 480
        },
        "type": "code-block",
        "code": "\nconst P=slidecode.props||{}; const T=(slidecode.theme&&slidecode.theme.colors)||{};\nconst LENS=P.lens||T.ink||'#111110';\nconst INNER=P.surface||T.canvas||'#F2F1EC';\nconst ACC=P.ring||T.accent||'#F3ED66';\nconst SKIP=slidecode.mode==='edit';\n\nconst c=document.createElement('canvas'); c.style.cssText='position:absolute;inset:0';\ndocument.body.appendChild(c);\nconst ctx=c.getContext('2d'); const dpr=Math.min(devicePixelRatio||1,2);\nlet W,H;\nfunction size(){W=innerWidth;H=innerHeight;c.width=W*dpr;c.height=H*dpr;c.style.width=W+'px';c.style.height=H+'px';ctx.setTransform(dpr,0,0,dpr,0,0);}\nsize(); addEventListener('resize',size);\n\n// El ojo SIGUE al cursor — y por tanto al dedo, si el modo gestos está activo.\nlet tx=0.5,ty=0.5,px=0.5,py=0.5,lastPtr=-1e9;\nslidecode.onPointer(p=>{ if(p&&p.inside){ tx=p.x; ty=p.y; lastPtr=performance.now(); } });\n\nfunction lens(cx,cy,rw,rh){\n  ctx.beginPath();\n  ctx.moveTo(cx-rw,cy);\n  ctx.bezierCurveTo(cx-rw*0.52,cy-rh, cx+rw*0.52,cy-rh, cx+rw,cy);\n  ctx.bezierCurveTo(cx+rw*0.52,cy+rh, cx-rw*0.52,cy+rh, cx-rw,cy);\n  ctx.closePath();\n}\nconst expo=t=>t>=1?1:1-Math.pow(2,-10*t);\nlet start=null;\nfunction frame(now){\n  if(start===null) start=now;\n  const t=now-start;\n  const open=SKIP?1:expo(Math.min(t/800,1));            // el ojo se abre al revelar\n\n  const live=(now-lastPtr)<1000;\n  const gx=live?tx:0.5+Math.sin(t/3400)*0.17;           // deriva ociosa si nadie apunta\n  const gy=live?ty:0.5+Math.cos(t/2700)*0.13;\n  px+=(gx-px)*0.075; py+=(gy-py)*0.075;\n\n  const cyc=t%5400;\n  const blink=cyc>5050?Math.sin((cyc-5050)/350*Math.PI):0;   // parpadeo cada 5,4 s\n\n  const cx=W/2, cy=H/2, rw=W*0.47;\n  const rh=Math.min(H*0.46,rw*0.52)*open*(1-blink*0.94);\n\n  ctx.clearRect(0,0,W,H);\n  lens(cx,cy,rw,rh); ctx.fillStyle=LENS; ctx.fill();\n  if(rh<6){ requestAnimationFrame(frame); return; }\n\n  ctx.save(); lens(cx,cy,rw,rh); ctx.clip();\n  const r=Math.min(rw*0.30,rh*0.80);\n  const ox=cx+(px-0.5)*rw*0.40, oy=cy+(py-0.5)*rh*0.62;\n  const lw=Math.max(3,rw*0.030);\n\n  ctx.strokeStyle=INNER; ctx.lineWidth=lw;                 // retícula larga sobre la lente\n  ctx.beginPath(); ctx.moveTo(ox,cy-rh); ctx.lineTo(ox,cy+rh);\n  ctx.moveTo(cx-rw,oy); ctx.lineTo(cx+rw,oy); ctx.stroke();\n\n  ctx.fillStyle=INNER; ctx.beginPath(); ctx.arc(ox,oy,r,0,6.283); ctx.fill();\n\n  ctx.strokeStyle=ACC; ctx.lineWidth=Math.max(2,r*0.075);  // anillo que gira: el latido\n  ctx.setLineDash([r*0.30,r*0.34]); ctx.lineDashOffset=-t/26;\n  ctx.beginPath(); ctx.arc(ox,oy,r*1.52,0,6.283); ctx.stroke();\n  ctx.setLineDash([]);\n\n  ctx.strokeStyle=LENS; ctx.lineWidth=lw*0.78;             // cruz interior\n  ctx.beginPath(); ctx.moveTo(ox,oy-r*0.82); ctx.lineTo(ox,oy+r*0.82);\n  ctx.moveTo(ox-r*0.82,oy); ctx.lineTo(ox+r*0.82,oy); ctx.stroke();\n\n  ctx.fillStyle=LENS; ctx.beginPath(); ctx.arc(ox,oy,r*0.36,0,6.283); ctx.fill();\n  ctx.restore();\n  requestAnimationFrame(frame);\n}\nslidecode.onReveal(()=>requestAnimationFrame(frame));\n",
        "css": "html,body{margin:0;height:100%;overflow:hidden;background:transparent}",
        "props": {
          "lens": "#111110",
          "surface": "#F3ED66",
          "ring": "#F2F1EC"
        }
      }
    }
  ],
  "specimen": "cover",
  "guide": {
    "margin": 56
  }
}
