              {
                "id": "s8-chart",
                "frame": {
                  "x": 800,
                  "y": 240,
                  "w": 1060,
                  "h": 660
                },
                "type": "code-block",
                "code": "\nconst P=slidecode.props||{}; const T=(slidecode.theme&&slidecode.theme.colors)||{};\nconst INK=P.ink||T.ink||'#111110';\nconst LABELS=['E','F','M','A','M','J','J','A','S','O','N','D'];\nconst VALS=[12,15,14,22,28,26,38,44,41,58,66,84];\nconst MAX=95;\nconst UIF=' Helvetica, Arial, sans-serif';\n\nconst c=document.createElement('canvas'); c.style.cssText='position:absolute;inset:0';\ndocument.body.appendChild(c);\nconst ctx=c.getContext('2d'); const dpr=Math.min(devicePixelRatio||1,2);\nlet W,H;\nfunction size(){W=innerWidth;H=innerHeight;c.width=W*dpr;c.height=H*dpr;c.style.width=W+'px';c.style.height=H+'px';ctx.setTransform(dpr,0,0,dpr,0,0);}\nsize(); addEventListener('resize',size);\n\nconst EDIT=slidecode.mode==='edit';\nfunction target(){ return EDIT?3:Math.max(0,Math.min(slidecode.step,3)); }\nlet phase=target();\nlet t0=performance.now();\nlet growFrom=EDIT?t0-6000:null;\nslidecode.onStep(()=>{ phase=target(); if(phase>=2&&growFrom===null) growFrom=performance.now(); });\nslidecode.onModeChange(()=>{ phase=target(); if(phase>=2&&growFrom===null) growFrom=performance.now()-6000; });\nslidecode.onReveal(()=>{ t0=performance.now(); if(EDIT) growFrom=t0-6000; });\n\nconst expo=t=>t>=1?1:1-Math.pow(2,-10*t);\nconst PADL=54, PADR=30, PADT=26, PADB=46;\n\nrequestAnimationFrame(function frame(now){\n  const t=now-t0;\n  ctx.clearRect(0,0,W,H);\n  const x0=PADL, x1=W-PADR, y0=PADT, y1=H-PADB;\n  const px=i=>x0+i*(x1-x0)/(VALS.length-1);\n  const py=v=>y1-(v/MAX)*(y1-y0);\n\n  // fase 1 — la rejilla se traza\n  const gk=phase>=1?expo(Math.min(t/700,1)):0;\n  if(gk>0){\n    ctx.strokeStyle=INK; ctx.globalAlpha=0.16*gk; ctx.lineWidth=1; ctx.setLineDash([4,7]);\n    for(let v=0;v<=MAX;v+=MAX/4){\n      ctx.beginPath(); ctx.moveTo(x0,py(v)); ctx.lineTo(x0+(x1-x0)*gk,py(v)); ctx.stroke();\n    }\n    ctx.setLineDash([]);\n    ctx.globalAlpha=0.55*gk; ctx.fillStyle=INK;\n    ctx.font='600 12px'+UIF; ctx.textAlign='center'; ctx.textBaseline='top';\n    LABELS.forEach((l,i)=>ctx.fillText(l,px(i),y1+16));\n    ctx.globalAlpha=1;\n  }\n\n  // fase 2 — la curva crece\n  const gk2=(phase>=2&&growFrom!==null)?expo(Math.min((now-growFrom)/1500,1)):0;\n  if(gk2>0){\n    const n=1+(VALS.length-1)*gk2, path=[];\n    for(let i=0;i<VALS.length;i++){\n      if(i<=n) path.push([px(i),py(VALS[i])]);\n      else if(i-1<n){\n        const f=n-(i-1);\n        path.push([px(i-1)+(px(i)-px(i-1))*f, py(VALS[i-1])+(py(VALS[i])-py(VALS[i-1]))*f]);\n        break;\n      }\n    }\n    ctx.beginPath(); ctx.moveTo(path[0][0],y1);\n    path.forEach(p=>ctx.lineTo(p[0],p[1]));\n    ctx.lineTo(path[path.length-1][0],y1); ctx.closePath();\n    ctx.fillStyle=INK; ctx.globalAlpha=0.13; ctx.fill(); ctx.globalAlpha=1;\n\n    ctx.beginPath(); path.forEach((p,i)=>i?ctx.lineTo(p[0],p[1]):ctx.moveTo(p[0],p[1]));\n    ctx.strokeStyle=INK; ctx.lineWidth=4; ctx.lineJoin='round'; ctx.lineCap='round'; ctx.stroke();\n\n    if(gk2>=1){                       // bucle ocioso: un punto recorre la curva sin parar\n      const q=((now/2600)%1)*(VALS.length-1), i=Math.floor(q), f=q-i;\n      const mx=px(i)+(px(i+1)-px(i))*f, my=py(VALS[i])+(py(VALS[i+1])-py(VALS[i]))*f;\n      ctx.fillStyle=INK; ctx.globalAlpha=0.30;\n      ctx.beginPath(); ctx.arc(mx,my,7,0,6.283); ctx.fill(); ctx.globalAlpha=1;\n    }\n    const lp=path[path.length-1];\n    ctx.fillStyle=INK; ctx.beginPath(); ctx.arc(lp[0],lp[1],6,0,6.283); ctx.fill();\n  }\n\n  // fase 3 — el remate\n  if(phase>=3&&gk2>=1){\n    const p=0.55+0.45*Math.sin(now/700);\n    const lx=px(VALS.length-1), ly=py(VALS[VALS.length-1]);\n    ctx.strokeStyle=INK; ctx.globalAlpha=0.35*p; ctx.lineWidth=2;\n    ctx.beginPath(); ctx.arc(lx,ly,18+p*5,0,6.283); ctx.stroke(); ctx.globalAlpha=1;\n    ctx.fillStyle=INK; ctx.textAlign='right'; ctx.textBaseline='bottom';\n    ctx.font=\"400 56px 'Anton'\"; ctx.fillText('+600%',lx-28,ly+18);\n    ctx.font='600 12px'+UIF; ctx.fillText('ALCANCE ORGÁNICO · 12 MESES',lx-28,ly+38);\n  }\n  requestAnimationFrame(frame);\n});\n",
                "css": "@font-face{font-family:'Anton';font-style:normal;font-weight:400;src:url(data:font/woff2;base64,) format('woff2');}html,body{margin:0;height:100%;overflow:hidden}",
