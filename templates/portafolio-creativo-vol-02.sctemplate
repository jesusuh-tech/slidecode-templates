                "type": "code-block",
                "code": "\nconst P=slidecode.props||{}; const T=(slidecode.theme&&slidecode.theme.colors)||{};\nconst INK=P.ink||T.ink||'#111110';\nconst A=(P.rowA||'MERIDIAN/ATLAS/NOVA STUDIO/KIOSKO/HELIO/BRUT').split('/');\nconst B=(P.rowB||'CAMPO/ÓRBITA/TINTA/ANDANTE/PLENA/RÍO').split('/');\n\nconst st=document.createElement('style');\nst.textContent=\n \".row{position:absolute;left:0;white-space:nowrap;font-family:'Anton';font-size:96px;\"+\n \"line-height:1;letter-spacing:-1px;will-change:transform;opacity:0}\"+\n \".a{top:4%;color:\"+INK+\"}\"+\n \".b{top:50%;color:transparent;-webkit-text-stroke:2px \"+INK+\"}\";\ndocument.head.appendChild(st);\n\nfunction make(cls,list){\n  const d=document.createElement('div'); d.className='row '+cls;\n  d.textContent=(list.join('  /  ')+'  /  ').repeat(4);\n  document.body.appendChild(d); return d;\n}\nconst ra=make('a',A), rb=make('b',B);\nlet wa=ra.scrollWidth/4, wb=rb.scrollWidth/4;\n// Anton llega por base64: hay que remedir cuando termina de cargar.\nif(document.fonts&&document.fonts.ready){\n  document.fonts.ready.then(()=>{ wa=ra.scrollWidth/4; wb=rb.scrollWidth/4; });\n}\n\nconst expo=t=>t>=1?1:1-Math.pow(2,-10*t);\nconst SKIP=slidecode.mode==='edit';\nlet t0=null;\nfunction frame(now){\n  if(t0===null) t0=now;\n  const t=now-t0;\n  const k=SKIP?1:expo(Math.min(t/900,1));\n  ra.style.opacity=k; rb.style.opacity=k*0.9;\n  ra.style.transform='translateX('+((1-k)*90-((t/26)%wa))+'px)';\n  rb.style.transform='translateX('+((1-k)*-90+((t/34)%wb)-wb)+'px)';\n  requestAnimationFrame(frame);\n}\nslidecode.onReveal(()=>requestAnimationFrame(frame));\n",
                "css": "@font-face{font-family:'Anton';font-style:normal;font-weight:400;src:url(data:font/woff2;base64,) format('woff2');}html,body{margin:0;height:100%;overflow:hidden}",
