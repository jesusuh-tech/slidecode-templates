              {
                "id": "sup-body",
                "name": "Cuerpo",
                "frame": {
                  "x": 1300,
                  "y": 212,
                  "w": 500,
                  "h": 250
                },
                "type": "text",
                "text": "La misma sesión y el mismo contexto: terminal, app de escritorio (Mac y Windows), claude.ai/code y extensiones para VS Code y JetBrains.",
                "styleRef": "$textStyles.body",
                "style": {
                  "fontSize": 26
                }
              },
              {
                "id": "sup-block",
                "name": "Superficies vivas",
                "frame": {
                  "x": 120,
                  "y": 470,
                  "w": 1680,
                  "h": 420
                },
                "type": "code-block",
                "code": "const T=(slidecode.theme&&slidecode.theme.colors)||{};\nconst ACC=T.accent||'#D97757';\nconst INK=T.ink||'#F4F1EA';\nconst SURF=T['tone-1']||'#171311';\nconst HAIR=T.hairline||'#2A2521';\nconst LABELS=['TERMINAL','ESCRITORIO','WEB','IDE'];\nconst SKIP=slidecode.mode==='edit';\ndocument.body.style.cssText='margin:0;overflow:hidden;background:transparent';\nconst c=document.createElement('canvas');document.body.appendChild(c);\nconst ctx=c.getContext('2d');\nconst dpr=Math.min(devicePixelRatio||1,2);\nlet W,H;\nfunction size(){W=innerWidth;H=innerHeight;c.width=W*dpr;c.height=H*dpr;c.style.width=W+'px';c.style.height=H+'px';ctx.setTransform(dpr,0,0,dpr,0,0);}\nsize();addEventListener('resize',size);\nfunction rr(x,y,w,h,r){ctx.beginPath();ctx.moveTo(x+r,y);ctx.arcTo(x+w,y,x+w,y+h,r);ctx.arcTo(x+w,y+h,x,y+h,r);ctx.arcTo(x,y+h,x,y,r);ctx.arcTo(x,y,x+w,y,r);ctx.closePath();}\nconst expo=function(t){return t>=1?1:1-Math.pow(2,-10*t);};\nconst rnd=function(n){const x=Math.sin(n*127.1)*43758.5453;return x-Math.floor(x);};\nfunction toRGB(h){const s=String(h).slice(1,7);const n=parseInt(s,16)||0;return [(n>>16)&255,(n>>8)&255,n&255];}\nconst A=toRGB(ACC),I=toRGB(INK);\nfunction ca(k,a){return 'rgba('+k[0]+','+k[1]+','+k[2]+','+a.toFixed(3)+')';}\nconst DWELL=2300,INTRO=900;\nlet start=null;\nfunction draw(now){\n  if(start===null)start=now;\n  const t=now-start;\n  const run=Math.max(0,t-(SKIP?0:INTRO));\n  const active=Math.floor(run/DWELL)%4;\n  const phase=(run%DWELL)/DWELL;\n  ctx.clearRect(0,0,W,H);\n  const gap=30,pw=(W-gap*3)/4,ph=H-64;\n  for(let i=0;i<4;i++){\n    const k=SKIP?1:expo(Math.min(Math.max((t-i*140)/720,0),1));\n    const x=i*(pw+gap),y=(1-k)*44,on=i===active;\n    ctx.globalAlpha=k;\n    ctx.fillStyle=SURF;rr(x,y,pw,ph,10);ctx.fill();\n    if(on){ctx.globalAlpha=k*0.09;ctx.fillStyle=ACC;rr(x-7,y-7,pw+14,ph+14,15);ctx.fill();ctx.globalAlpha=k;}\n    ctx.strokeStyle=on?ca(A,0.85):HAIR;ctx.lineWidth=on?2:1;rr(x,y,pw,ph,10);ctx.stroke();\n    ctx.fillStyle=ca(I,0.08);ctx.fillRect(x+1,y+1,pw-2,28);\n    for(let d=0;d<3;d++){ctx.beginPath();ctx.arc(x+20+d*15,y+15,3.2,0,6.2832);ctx.fillStyle=ca(I,0.26);ctx.fill();}\n    const rows=7,lh=24;\n    for(let r=0;r<rows;r++){\n      const ry=y+52+r*lh;\n      if(ry>y+ph-34)break;\n      const wf=0.28+rnd(i*9+r*3)*0.54;\n      const lit=on&&r<=Math.floor(phase*rows*1.55);\n      ctx.fillStyle=lit?ca(A,0.72):ca(I,0.13);\n      ctx.fillRect(x+20,ry,(pw-40)*wf,6);\n    }\n    if(on){\n      const rrw=Math.min(rows-1,Math.floor(phase*rows*1.55));\n      const ry=y+52+rrw*lh;\n      const wf=0.28+rnd(i*9+rrw*3)*0.54;\n      if(Math.floor(run/400)%2===0){ctx.fillStyle=INK;ctx.fillRect(x+20+(pw-40)*wf+6,ry-4,9,13);}\n    }\n    ctx.fillStyle=on?INK:ca(I,0.34);\n    ctx.font='600 13px ui-monospace, Menlo, monospace';ctx.textAlign='left';\n    ctx.fillText(LABELS[i],x+2,H-14);\n    ctx.globalAlpha=1;\n  }\n  requestAnimationFrame(draw);\n}\nslidecode.onReveal(function(){requestAnimationFrame(draw);});\n"
              },
