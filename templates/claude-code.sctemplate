                "type": "code-block",
                "code": "const T=(slidecode.theme&&slidecode.theme.colors)||{};\nconst ACC=T.accent||'#D97757';\nconst SKIP=slidecode.mode==='edit';\ndocument.body.style.cssText='margin:0;overflow:hidden;background:transparent';\nconst renderer=new THREE.WebGLRenderer({antialias:true,alpha:true});\nrenderer.setPixelRatio(Math.min(devicePixelRatio||1,2));\nrenderer.setSize(innerWidth,innerHeight);\ndocument.body.appendChild(renderer.domElement);\nconst scene=new THREE.Scene();\nconst camera=new THREE.PerspectiveCamera(38,innerWidth/innerHeight,0.1,100);\ncamera.position.set(0,0.4,7);\nconst knot=new THREE.Mesh(new THREE.TorusKnotGeometry(1.5,0.40,240,36),new THREE.MeshStandardMaterial({color:0x201915,metalness:0.93,roughness:0.22}));\nscene.add(knot);\nconst key=new THREE.PointLight(new THREE.Color(ACC),270);key.position.set(4,3,4);scene.add(key);\nconst rim=new THREE.PointLight(0x4A6CFF,130);rim.position.set(-5,-2,2);scene.add(rim);\nconst top=new THREE.PointLight(0xF4F1EA,64);top.position.set(0,6,-3);scene.add(top);\nscene.add(new THREE.AmbientLight(0x1a1512,2));\naddEventListener('resize',function(){camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight);});\nlet px=0,py=0,tx=0,ty=0;\nslidecode.onPointer(function(p){if(p&&p.inside){tx=p.x-0.5;ty=p.y-0.5;}else{tx=0;ty=0;}});\nconst expo=function(t){return t>=1?1:1-Math.pow(2,-10*t);};\nlet start=null;\nfunction frame(now){\n  if(start===null)start=now;\n  const t=now-start;\n  const k=SKIP?1:expo(Math.min(t/1300,1));\n  px+=(tx-px)*0.04;py+=(ty-py)*0.04;\n  knot.scale.setScalar(0.6+0.4*k);\n  knot.position.y=(1-k)*-1.2+Math.sin(t/1700)*0.13;\n  knot.rotation.x=t/4600+py*0.35;\n  knot.rotation.y=t/3400+px*0.5;\n  key.intensity=270+Math.sin(t/940)*60;\n  renderer.render(scene,camera);\n  requestAnimationFrame(frame);\n}\nslidecode.onReveal(function(){requestAnimationFrame(frame);});\n",
