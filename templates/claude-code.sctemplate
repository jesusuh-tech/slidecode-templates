              },
              {
                "id": "mcp-block",
                "name": "Hub MCP",
                "frame": {
                  "x": 830,
                  "y": 150,
                  "w": 1010,
                  "h": 800
                },
                "type": "code-block",
                "code": "const T=(slidecode.theme&&slidecode.theme.colors)||{};\nconst ACC=T.accent||'#D97757';\nconst INK=T.ink||'#F4F1EA';\nconst EPS=['github','postgres','figma','slack','archivos','http'];\nconst SKIP=slidecode.mode==='edit';\ndocument.body.style.cssText='margin:0;overflow:hidden;background:transparent';\nconst c=document.createElement('canvas');document.body.appendChild(c);\nconst ctx=c.getContext('2d');\nconst dpr=Math.min(devicePixelRatio||1,2);\nlet W,H;\nfunction size(){W=innerWidth;H=innerHeight;c.width=W*dpr;c.height=H*dpr;c.style.width=W+'px';c.style.height=H+'px';ctx.setTransform(dpr,0,0,dpr,0,0);}\nsize();addEventListener('resize',size);\nconst expo=function(t){return t>=1?1:1-Math.pow(2,-10*t);};\nconst rnd=function(n){const x=Math.sin(n*127.1)*43758.5453;return x-Math.floor(x);};\nfunction toRGB(h){const s=String(h).slice(1,7);const n=parseInt(s,16)||0;return [(n>>16)&255,(n>>8)&255,n&255];}\nconst I=toRGB(INK);\nfunction ca(k,a){return 'rgba('+k[0]+','+k[1]+','+k[2]+','+a.toFixed(3)+')';}\nconst HUB=54,PK=640,INTRO=1000;\nlet mx=0,my=0,tx=0,ty=0;\nslidecode.onPointer(function(p){if(p&&p.inside){tx=p.x-0.5;ty=p.y-0.5;}else{tx=0;ty=0;}});\nlet start=null;\nfunction draw(now){\n  if(start===null)start=now;\n  const t=now-start;\n  const run=Math.max(0,t-(SKIP?0:INTRO));\n  mx+=(tx-mx)*0.05;my+=(ty-my)*0.05;\n  ctx.clearRect(0,0,W,H);\n  const cx=W*0.5+mx*22,cy=H*0.5+my*18,R=Math.min(W,H)*0.36;\n  for(let i=0;i<6;i++){\n    const a=-Math.PI/2+i*(Math.PI/3);\n    const ex=cx+Math.cos(a)*R,ey=cy+Math.sin(a)*R;\n    const k=SKIP?1:expo(Math.min(Math.max((t-i*120)/900,0),1));\n    const sx=cx+Math.cos(a)*HUB,sy=cy+Math.sin(a)*HUB;\n    ctx.strokeStyle=ca(I,0.17);ctx.lineWidth=1.2;\n    ctx.beginPath();ctx.moveTo(sx,sy);ctx.lineTo(sx+(ex-sx)*k,sy+(ey-sy)*k);ctx.stroke();\n    if(k<0.9)continue;\n    ctx.fillStyle=ACC;ctx.globalAlpha=0.55;\n    ctx.beginPath();ctx.arc(ex,ey,6,0,6.2832);ctx.fill();\n    ctx.globalAlpha=0.12;\n    ctx.beginPath();ctx.arc(ex,ey,16,0,6.2832);ctx.fill();\n    ctx.globalAlpha=1;\n    ctx.font='600 13px ui-monospace, Menlo, monospace';\n    ctx.textAlign=Math.cos(a)>0.2?'left':(Math.cos(a)<-0.2?'right':'center');\n    const off=Math.cos(a)>0.2?20:(Math.cos(a)<-0.2?-20:0);\n    ctx.fillStyle=ca(I,0.46);\n    ctx.fillText(EPS[i],ex+off,ey+(Math.abs(Math.cos(a))<0.2?(Math.sin(a)>0?30:-20):5));\n  }\n  const n=Math.floor(run/PK);\n  for(let j=Math.max(0,n-4);j<=n;j++){\n    const at=j*PK;\n    const age=(run-at)/1000;\n    if(age<0||age>1)continue;\n    const idx=Math.floor(rnd(j*7+5)*6);\n    const a=-Math.PI/2+idx*(Math.PI/3);\n    const sx=cx+Math.cos(a)*HUB,sy=cy+Math.sin(a)*HUB;\n    const ex=cx+Math.cos(a)*R,ey=cy+Math.sin(a)*R;\n    const inbound=rnd(j*3+1)>0.5;\n    const e=1-Math.pow(1-age,2.2);\n    const f=inbound?1-e:e;\n    const x=sx+(ex-sx)*f,y=sy+(ey-sy)*f;\n    ctx.fillStyle=ACC;ctx.globalAlpha=0.95;\n    ctx.beginPath();ctx.arc(x,y,3.6,0,6.2832);ctx.fill();\n    ctx.globalAlpha=0.20;\n    ctx.beginPath();ctx.arc(x,y,10,0,6.2832);ctx.fill();\n    ctx.globalAlpha=1;\n  }\n  const hp=Math.max(0,1-((run%PK)/400));\n  const ik=SKIP?1:expo(Math.min(t/900,1));\n  ctx.globalAlpha=ik;\n  ctx.strokeStyle=ca(I,0.20);ctx.lineWidth=1.4;\n  ctx.beginPath();ctx.arc(cx,cy,HUB,0,6.2832);ctx.stroke();\n  ctx.strokeStyle='rgba(217,119,87,'+(0.55*hp).toFixed(3)+')';ctx.lineWidth=2;\n  ctx.beginPath();ctx.arc(cx,cy,HUB+8+hp*16,0,6.2832);ctx.stroke();\n  ctx.fillStyle='rgba(217,119,87,'+(0.10+0.10*hp).toFixed(3)+')';\n  ctx.beginPath();ctx.arc(cx,cy,HUB-4,0,6.2832);ctx.fill();\n  ctx.textAlign='center';\n  ctx.fillStyle=INK;ctx.font='600 15px ui-monospace, Menlo, monospace';\n  ctx.fillText('MCP',cx,cy+6);\n  ctx.globalAlpha=1;\n  requestAnimationFrame(draw);\n}\nslidecode.onReveal(function(){requestAnimationFrame(draw);});\n"
