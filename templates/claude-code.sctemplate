              {
                "id": "sub-block",
                "name": "Fan-out de subagentes",
                "frame": {
                  "x": 880,
                  "y": 170,
                  "w": 960,
                  "h": 740
                },
                "type": "code-block",
                "code": "const T=(slidecode.theme&&slidecode.theme.colors)||{};\nconst ACC=T.accent||'#D97757';\nconst INK=T.ink||'#F4F1EA';\nconst SKIP=slidecode.mode==='edit';\ndocument.body.style.cssText='margin:0;overflow:hidden;background:transparent';\nconst c=document.createElement('canvas');document.body.appendChild(c);\nconst ctx=c.getContext('2d');\nconst dpr=Math.min(devicePixelRatio||1,2);\nlet W,H;\nfunction size(){W=innerWidth;H=innerHeight;c.width=W*dpr;c.height=H*dpr;c.style.width=W+'px';c.style.height=H+'px';ctx.setTransform(dpr,0,0,dpr,0,0);}\nsize();addEventListener('resize',size);\nconst expo=function(t){return t>=1?1:1-Math.pow(2,-10*t);};\nfunction toRGB(h){const s=String(h).slice(1,7);const n=parseInt(s,16)||0;return [(n>>16)&255,(n>>8)&255,n&255];}\nconst I=toRGB(INK);\nfunction ca(k,a){return 'rgba('+k[0]+','+k[1]+','+k[2]+','+a.toFixed(3)+')';}\nconst N=5,OUT=1000,WORK=2200,BACK=1300,ABS=1100,CY=OUT+WORK+BACK+ABS;\nlet px=0,tx=0;\nslidecode.onPointer(function(p){tx=(p&&p.inside)?(p.y-0.5):0;});\nlet start=null;\nfunction draw(now){\n  if(start===null)start=now;\n  const t=now-start;\n  const run=Math.max(0,t-(SKIP?0:500));\n  const cyc=Math.floor(run/CY),p=run%CY;\n  px+=(tx-px)*0.05;\n  ctx.clearRect(0,0,W,H);\n  const cx=W*0.15,cy=H*0.5+px*26,R=W*0.66;\n  for(let i=0;i<N;i++){\n    const a=-0.55+(i/(N-1))*1.10;\n    const sx=cx+Math.cos(a)*R,sy=cy+Math.sin(a)*R*0.56;\n    const g=Math.min(Math.max((p-i*130)/OUT,0),1);\n    const k=expo(g);\n    ctx.strokeStyle=ca(I,0.15);ctx.lineWidth=1.2;\n    ctx.beginPath();ctx.moveTo(cx,cy);ctx.lineTo(cx+(sx-cx)*k,cy+(sy-cy)*k);ctx.stroke();\n    if(k<=0.03)continue;\n    const working=p>OUT&&p<OUT+WORK;\n    const pulse=(Math.sin((run+i*420)/280)+1)/2;\n    ctx.fillStyle=ACC;ctx.globalAlpha=k*(working?0.72+0.28*pulse:0.5);\n    ctx.beginPath();ctx.arc(sx,sy,5.5,0,6.2832);ctx.fill();\n    if(working){ctx.globalAlpha=k*0.16*pulse;ctx.beginPath();ctx.arc(sx,sy,17+9*pulse,0,6.2832);ctx.fill();}\n    ctx.globalAlpha=1;\n    if(p>OUT){\n      const wp=Math.min(Math.max((p-OUT)/WORK,0),1);\n      for(let b=0;b<3;b++){\n        const bk=Math.min(Math.max(wp*1.5-b*0.26,0),1);\n        if(bk<=0)continue;\n        ctx.fillStyle=ca(I,0.12+0.11*bk);\n        ctx.fillRect(sx+16,sy-10+b*8,50*bk,4);\n      }\n    }\n    if(p>OUT+WORK){\n      const rp=Math.min((p-OUT-WORK)/BACK,1);\n      const e=1-Math.pow(1-rp,3);\n      const ax=sx+(cx-sx)*e,ay=sy+(cy-sy)*e;\n      ctx.fillStyle=ACC;\n      ctx.beginPath();ctx.arc(ax,ay,3.8,0,6.2832);ctx.fill();\n      ctx.globalAlpha=0.22;ctx.beginPath();ctx.arc(ax,ay,10,0,6.2832);ctx.fill();ctx.globalAlpha=1;\n    }\n    ctx.font='600 11px ui-monospace, Menlo, monospace';ctx.textAlign='left';\n    ctx.fillStyle=ca(I,0.32*k);\n    ctx.fillText('agente '+(i+1),sx+16,sy+28);\n  }\n  const absorbing=p>OUT+WORK+BACK;\n  const cp=absorbing?(p-OUT-WORK-BACK)/ABS:0;\n  ctx.strokeStyle=absorbing?'rgba(217,119,87,'+(0.62*(1-cp)).toFixed(3)+')':'rgba(217,119,87,0.26)';\n  ctx.lineWidth=2;\n  ctx.beginPath();ctx.arc(cx,cy,26+(absorbing?cp*38:0),0,6.2832);ctx.stroke();\n  ctx.fillStyle=ACC;ctx.beginPath();ctx.arc(cx,cy,11,0,6.2832);ctx.fill();\n  const back=p>OUT+WORK?Math.min(N,Math.floor((p-OUT-WORK)/(BACK/N))+1):0;\n  const found=cyc*N+back;\n  ctx.textAlign='center';\n  ctx.fillStyle=INK;ctx.font='italic 400 46px Georgia, serif';\n  ctx.fillText(String(found),cx,cy+96);\n  ctx.fillStyle=ca(I,0.36);ctx.font='600 10px ui-monospace, Menlo, monospace';\n  ctx.fillText('HALLAZGOS',cx,cy+120);\n  requestAnimationFrame(draw);\n}\nslidecode.onReveal(function(){requestAnimationFrame(draw);});\n"
