                },
                "type": "code-block",
                "code": "const T=(slidecode.theme&&slidecode.theme.colors)||{};\nconst ACC=T.accent||'#D97757';\nconst INK=T.ink||'#F4F1EA';\nconst SURF=T['tone-1']||'#171311';\nconst HAIR=T.hairline||'#2A2521';\nconst L=[['NOMBRE + DESCRIPCIÓN','siempre en contexto',1],['SKILL.md','se lee cuando aplica',4],['reference/ · scripts/','se abre si hace falta',7]];\nconst SKIP=slidecode.mode==='edit';\ndocument.body.style.cssText='margin:0;overflow:hidden;background:transparent';\nconst c=document.createElement('canvas');document.body.appendChild(c);\nconst ctx=c.getContext('2d');\nconst dpr=Math.min(devicePixelRatio||1,2);\nlet W,H;\nfunction size(){W=innerWidth;H=innerHeight;c.width=W*dpr;c.height=H*dpr;c.style.width=W+'px';c.style.height=H+'px';ctx.setTransform(dpr,0,0,dpr,0,0);}\nsize();addEventListener('resize',size);\nfunction rr(x,y,w,h,r){ctx.beginPath();ctx.moveTo(x+r,y);ctx.arcTo(x+w,y,x+w,y+h,r);ctx.arcTo(x+w,y+h,x,y+h,r);ctx.arcTo(x,y+h,x,y,r);ctx.arcTo(x,y,x+w,y,r);ctx.closePath();}\nconst expo=function(t){return t>=1?1:1-Math.pow(2,-10*t);};\nconst rnd=function(n){const x=Math.sin(n*127.1)*43758.5453;return x-Math.floor(x);};\nfunction toRGB(h){const s=String(h).slice(1,7);const n=parseInt(s,16)||0;return [(n>>16)&255,(n>>8)&255,n&255];}\nconst A=toRGB(ACC),I=toRGB(INK);\nfunction ca(k,a){return 'rgba('+k[0]+','+k[1]+','+k[2]+','+a.toFixed(3)+')';}\nconst STEP=1600,HOLD=2700,CLOSE=1000,TOTAL=STEP*3+HOLD+CLOSE;\nconst HEAD=66,LH=18,LG=10;\nlet start=null;\nfunction draw(now){\n  if(start===null)start=now;\n  const t=now-start;\n  const run=Math.max(0,t-(SKIP?0:600));\n  const p=run%TOTAL;\n  ctx.clearRect(0,0,W,H);\n  let y=0;\n  for(let i=0;i<3;i++){\n    let o;\n    if(p<STEP*3){o=Math.min(Math.max((p-i*STEP)/(STEP*0.8),0),1);}\n    else if(p<STEP*3+HOLD){o=1;}\n    else {const cp=(p-STEP*3-HOLD)/CLOSE;o=1-Math.min(Math.max(cp*1.4-(2-i)*0.14,0),1);}\n    o=expo(o);\n    const inner=L[i][2]*(LH+LG)+16;\n    const h=HEAD+o*inner;\n    ctx.fillStyle=SURF;rr(0,y,W,h,8);ctx.fill();\n    if(o>0.04){ctx.globalAlpha=o*0.06;ctx.fillStyle=ACC;rr(-5,y-5,W+10,h+10,12);ctx.fill();ctx.globalAlpha=1;}\n    ctx.strokeStyle=o>0.04?ca(A,0.18+0.52*o):HAIR;ctx.lineWidth=1.4;\n    rr(0,y,W,h,8);ctx.stroke();\n    ctx.fillStyle=ca(A,0.30+0.70*o);\n    ctx.fillRect(0,y+20,4,HEAD-40);\n    ctx.textAlign='left';\n    ctx.font='600 15px ui-monospace, Menlo, monospace';\n    ctx.fillStyle=o>0.5?INK:ca(I,0.52);\n    ctx.fillText(L[i][0],24,y+31);\n    ctx.font='400 13px ui-monospace, Menlo, monospace';\n    ctx.fillStyle=ca(I,0.36);\n    ctx.fillText(L[i][1],24,y+52);\n    for(let r=0;r<L[i][2];r++){\n      const lk=Math.min(Math.max(o*1.6-r*0.12,0),1);\n      if(lk<=0)continue;\n      const wf=0.30+rnd(i*7+r*3)*0.58;\n      ctx.fillStyle=ca(I,0.09+0.15*lk);\n      ctx.fillRect(24,y+HEAD+r*(LH+LG),(W-48)*wf*lk,6);\n    }\n    y+=h+14;\n  }\n  requestAnimationFrame(draw);\n}\nslidecode.onReveal(function(){requestAnimationFrame(draw);});\n"
