              },
              {
                "id": "her-block",
                "name": "Actividad de herramientas",
                "frame": {
                  "x": 120,
                  "y": 470,
                  "w": 1680,
                  "h": 420
                },
                "type": "code-block",
                "code": "const T=(slidecode.theme&&slidecode.theme.colors)||{};\nconst ACC=T.accent||'#D97757';\nconst INK=T.ink||'#F4F1EA';\nconst TOOLS=['read','edit','bash','grep','glob','web'];\nconst SKIP=slidecode.mode==='edit';\ndocument.body.style.cssText='margin:0;overflow:hidden;background:transparent';\nconst c=document.createElement('canvas');document.body.appendChild(c);\nconst ctx=c.getContext('2d');\nconst dpr=Math.min(devicePixelRatio||1,2);\nlet W,H;\nfunction size(){W=innerWidth;H=innerHeight;c.width=W*dpr;c.height=H*dpr;c.style.width=W+'px';c.style.height=H+'px';ctx.setTransform(dpr,0,0,dpr,0,0);}\nsize();addEventListener('resize',size);\nconst expo=function(t){return t>=1?1:1-Math.pow(2,-10*t);};\nconst rnd=function(n){const x=Math.sin(n*127.1)*43758.5453;return x-Math.floor(x);};\nfunction toRGB(h){const s=String(h).slice(1,7);const n=parseInt(s,16)||0;return [(n>>16)&255,(n>>8)&255,n&255];}\nconst A=toRGB(ACC),I=toRGB(INK);\nfunction ca(k,a){return 'rgba('+k[0]+','+k[1]+','+k[2]+','+a.toFixed(3)+')';}\nconst COLS=30,TICK=250,INTRO=800;\nlet start=null;\nfunction draw(now){\n  if(start===null)start=now;\n  const t=now-start;\n  const run=Math.max(0,t-(SKIP?0:INTRO));\n  const n=Math.floor(run/TICK);\n  ctx.clearRect(0,0,W,H);\n  const padL=130,padT=54,gap=5;\n  const cw=(W-padL-gap*(COLS-1))/COLS;\n  const ch=(H-padT-26-gap*(TOOLS.length-1))/TOOLS.length;\n  for(let r=0;r<TOOLS.length;r++){\n    const k=SKIP?1:expo(Math.min(Math.max((t-r*95)/640,0),1));\n    const y=padT+r*(ch+gap);\n    ctx.globalAlpha=k;\n    for(let col=0;col<COLS;col++){ctx.fillStyle=ca(I,0.055);ctx.fillRect(padL+col*(cw+gap),y,cw,ch);}\n    ctx.fillStyle=ca(I,0.40);\n    ctx.font='600 14px ui-monospace, Menlo, monospace';ctx.textAlign='right';\n    ctx.fillText(TOOLS[r],padL-20,y+ch/2+5);\n    ctx.globalAlpha=1;\n  }\n  for(let i=Math.max(0,n-COLS+1);i<=n;i++){\n    const r=Math.floor(rnd(i*13+1)*TOOLS.length);\n    const col=i%COLS;\n    const age=(n-i)/COLS;\n    const a=Math.max(0,1-age);\n    const y=padT+r*(ch+gap),x=padL+col*(cw+gap);\n    ctx.fillStyle=ca(A,0.14+0.76*a*a);\n    ctx.fillRect(x,y,cw,ch);\n    if(a>0.95){ctx.globalAlpha=0.26;ctx.fillStyle=ACC;ctx.fillRect(x-5,y-5,cw+10,ch+10);ctx.globalAlpha=1;}\n  }\n  const ik=SKIP?1:expo(Math.min(t/640,1));\n  ctx.globalAlpha=ik;ctx.textAlign='left';\n  ctx.font='600 14px ui-monospace, Menlo, monospace';\n  ctx.fillStyle=ca(I,0.40);ctx.fillText('LLAMADAS',padL,28);\n  ctx.fillStyle=INK;ctx.fillText(String(n).length>3?String(n):('000'+n).slice(-4),padL+108,28);\n  ctx.fillStyle=ACC;ctx.fillText('> '+TOOLS[Math.floor(rnd(n*13+1)*TOOLS.length)],padL+220,28);\n  ctx.globalAlpha=1;\n  requestAnimationFrame(draw);\n}\nslidecode.onReveal(function(){requestAnimationFrame(draw);});\n"
              },
