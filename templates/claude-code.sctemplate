        },
        "type": "code-block",
        "code": "const T=(slidecode.theme&&slidecode.theme.colors)||{};\nconst ACC=T.accent||'#D97757';\nconst INK=T.ink||'#F4F1EA';\nconst STOPS=[['low','respuestas rápidas'],['medium','trabajo cotidiano'],['high','el valor por defecto'],['xhigh','código y agentes'],['max','cuando la exactitud manda']];\nconst TOTAL=STOPS.length;\ndocument.body.style.cssText='margin:0;overflow:hidden;background:transparent';\nconst c=document.createElement('canvas');document.body.appendChild(c);\nconst ctx=c.getContext('2d');\nconst dpr=Math.min(devicePixelRatio||1,2);\nlet W,H;\nfunction size(){W=innerWidth;H=innerHeight;c.width=W*dpr;c.height=H*dpr;c.style.width=W+'px';c.style.height=H+'px';ctx.setTransform(dpr,0,0,dpr,0,0);}\nsize();addEventListener('resize',size);\nconst expo=function(t){return t>=1?1:1-Math.pow(2,-10*t);};\nfunction toRGB(h){const s=String(h).slice(1,7);const n=parseInt(s,16)||0;return [(n>>16)&255,(n>>8)&255,n&255];}\nconst I=toRGB(INK);\nfunction ca(k,a){return 'rgba('+k[0]+','+k[1]+','+k[2]+','+a.toFixed(3)+')';}\nfunction target(){return slidecode.mode==='edit'?TOTAL:Math.max(0,Math.min(TOTAL,slidecode.step));}\nlet prog=target();\nslidecode.onModeChange(function(){});\nslidecode.onStep(function(){});\nlet last=null;\nfunction draw(now){\n  if(last===null)last=now;\n  const dt=Math.min(64,now-last);last=now;\n  prog+=(target()-prog)*Math.min(1,dt/240);\n  ctx.clearRect(0,0,W,H);\n  const padX=50,ty=H*0.70,maxH=ty-46;\n  const slot=(W-padX*2)/TOTAL;\n  const xs=[];for(let i=0;i<TOTAL;i++)xs.push(padX+(i+0.5)*slot);\n  const bw=slot*0.42;\n  const cur=Math.max(0,Math.min(TOTAL-1,Math.round(prog)-1));\n  for(let i=0;i<TOTAL;i++){\n    const f=expo(Math.min(Math.max(prog-i,0),1));\n    if(f<=0.005)continue;\n    const bh=(0.20+0.17*i)*maxH*f;\n    const on=i===cur&&prog>0.4;\n    ctx.fillStyle=on?ca(toRGB(ACC),0.85):'rgba(217,119,87,0.22)';\n    ctx.fillRect(xs[i]-bw/2,ty-bh,bw,bh);\n    if(on){ctx.globalAlpha=0.10;ctx.fillStyle=ACC;ctx.fillRect(xs[i]-bw/2-8,ty-bh-8,bw+16,bh+8);ctx.globalAlpha=1;}\n  }\n  ctx.strokeStyle=ca(I,0.14);ctx.lineWidth=1.5;\n  ctx.beginPath();ctx.moveTo(padX,ty);ctx.lineTo(W-padX,ty);ctx.stroke();\n  let mxp=xs[0];\n  if(prog>0.02){\n    const idx=Math.max(0,Math.min(TOTAL-1,prog-1));\n    const i0=Math.floor(idx),fr=idx-i0;\n    mxp=xs[i0]+(xs[Math.min(i0+1,TOTAL-1)]-xs[i0])*fr;\n    ctx.strokeStyle='rgba(217,119,87,0.6)';ctx.lineWidth=2;\n    ctx.beginPath();ctx.moveTo(padX,ty);ctx.lineTo(mxp,ty);ctx.stroke();\n  }\n  for(let i=0;i<TOTAL;i++){\n    const f=Math.min(Math.max(prog-i,0),1);\n    ctx.fillStyle=i===cur&&prog>0.4?ACC:ca(I,0.22+0.22*f);\n    ctx.beginPath();ctx.arc(xs[i],ty,i===cur&&prog>0.4?5:3.4,0,6.2832);ctx.fill();\n    ctx.font='600 13px ui-monospace, Menlo, monospace';ctx.textAlign='center';\n    ctx.fillStyle=i===cur&&prog>0.4?INK:ca(I,0.26+0.24*f);\n    ctx.fillText('0'+(i+1)+'  '+STOPS[i][0].toUpperCase(),xs[i],ty+34);\n  }\n  if(prog>0.02){\n    const wob=Math.sin(now/320)*0.14+1;\n    ctx.fillStyle=ACC;\n    ctx.beginPath();ctx.arc(mxp,ty,7.5*wob,0,6.2832);ctx.fill();\n    ctx.globalAlpha=0.22;\n    ctx.beginPath();ctx.arc(mxp,ty,15*wob,0,6.2832);ctx.fill();\n    ctx.globalAlpha=1;\n  }\n  ctx.textAlign='left';\n  ctx.font='600 13px ui-monospace, Menlo, monospace';\n  ctx.fillStyle=ca(I,0.36);\n  ctx.fillText('NIVEL DE ESFUERZO',padX,26);\n  if(prog>0.3){\n    ctx.fillStyle=ACC;\n    ctx.fillText(STOPS[cur][0].toUpperCase()+'  ·  '+STOPS[cur][1],padX+220,26);\n  } else {\n    ctx.fillStyle=ca(I,0.24);\n    ctx.fillText('avanza para recorrer los niveles',padX+220,26);\n  }\n  requestAnimationFrame(draw);\n}\nrequestAnimationFrame(draw);\n",
        "stepCount": 5
      }
    },
