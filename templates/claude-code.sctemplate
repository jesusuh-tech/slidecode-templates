        "type": "code-block",
        "code": "const T=(slidecode.theme&&slidecode.theme.colors)||{};\nconst ACC=T.accent||'#D97757';\nconst INK=T.ink||'#F4F1EA';\nconst MUT='rgba(244,241,234,0.34)';\nconst LABELS=['EXPLORAR','PLANEAR','EDITAR','VERIFICAR'];\nconst SKIP=slidecode.mode==='edit';\ndocument.body.style.cssText='margin:0;overflow:hidden;background:transparent';\nconst c=document.createElement('canvas');document.body.appendChild(c);\nconst ctx=c.getContext('2d');\nconst dpr=Math.min(devicePixelRatio||1,2);\nlet W,H;\nfunction size(){W=innerWidth;H=innerHeight;c.width=W*dpr;c.height=H*dpr;c.style.width=W+'px';c.style.height=H+'px';ctx.setTransform(dpr,0,0,dpr,0,0);}\nsize();addEventListener('resize',size);\nconst expo=function(t){return t>=1?1:1-Math.pow(2,-10*t);};\nconst PERIOD=3600,INTRO=1000;\nlet start=null;\nfunction draw(now){\n  if(start===null)start=now;\n  const t=now-start;\n  const intro=SKIP?1:Math.min(t/INTRO,1);\n  const k=expo(intro);\n  const cx=W/2,cy=H/2+6,R=Math.min(W,H)*0.32;\n  ctx.clearRect(0,0,W,H);\n  ctx.strokeStyle='rgba(244,241,234,0.14)';ctx.lineWidth=1.5;\n  ctx.beginPath();ctx.arc(cx,cy,R,-Math.PI/2,-Math.PI/2+Math.PI*2*k);ctx.stroke();\n  const run=Math.max(0,t-(SKIP?0:INTRO));\n  const ang=-Math.PI/2+(run%PERIOD)/PERIOD*Math.PI*2;\n  const passes=Math.floor(run/PERIOD)*LABELS.length+Math.floor((run%PERIOD)/PERIOD*LABELS.length);\n  for(let i=0;i<LABELS.length;i++){\n    const a=-Math.PI/2+i*(Math.PI*2/LABELS.length);\n    const sx=cx+Math.cos(a)*R,sy=cy+Math.sin(a)*R;\n    const pop=SKIP?1:expo(Math.min(Math.max((t-460-i*130)/460,0),1));\n    const d=Math.abs(((ang-a)%(Math.PI*2)+Math.PI*3)%(Math.PI*2)-Math.PI);\n    const heat=intro>=1?Math.max(0,1-d/0.9):0;\n    ctx.globalAlpha=pop*(0.28+0.72*heat);ctx.fillStyle=ACC;\n    ctx.beginPath();ctx.arc(sx,sy,4.5+3.5*heat,0,Math.PI*2);ctx.fill();\n    if(heat>0.3){ctx.globalAlpha=pop*heat*0.30;ctx.beginPath();ctx.arc(sx,sy,12+9*heat,0,Math.PI*2);ctx.fill();}\n    ctx.globalAlpha=pop;ctx.fillStyle=heat>0.5?INK:MUT;\n    ctx.font='600 13px ui-monospace, Menlo, monospace';ctx.textAlign='center';\n    const off=26+9*heat;\n    ctx.fillText(LABELS[i],sx+Math.cos(a)*off*1.5,sy+Math.sin(a)*off+5);\n    ctx.globalAlpha=1;\n  }\n  if(intro>=1){\n    for(let q=0;q<11;q++){\n      const qa=ang-q*0.042;\n      ctx.fillStyle=ACC;ctx.globalAlpha=(1-q/11)*0.9;\n      ctx.beginPath();ctx.arc(cx+Math.cos(qa)*R,cy+Math.sin(qa)*R,4.2-q*0.28,0,Math.PI*2);ctx.fill();\n    }\n    ctx.globalAlpha=1;\n  }\n  ctx.textAlign='center';ctx.globalAlpha=k;\n  ctx.fillStyle=INK;ctx.font='italic 400 58px Georgia, serif';\n  ctx.fillText(String(passes),cx,cy+14);\n  ctx.fillStyle=MUT;ctx.font='600 11px ui-monospace, Menlo, monospace';\n  ctx.fillText('ITERACIONES',cx,cy+40);\n  ctx.globalAlpha=1;\n  requestAnimationFrame(draw);\n}\nslidecode.onReveal(function(){requestAnimationFrame(draw);});\n"
      }
